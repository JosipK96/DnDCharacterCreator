@* Asks whether to go on with the player's unfinished new character or start a fresh one (#138) *@

<div class="fixed inset-0 bg-black/75 flex items-center justify-center z-50 px-4">
    <div class="room max-w-md w-full p-6">
        <h3 class="room-title mb-4">Resume Character Creation?</h3>
        <p class="mb-2">You have an in-progress character:</p>
        <div class="border-l-[5px] border-plum bg-plum-tint p-3 mb-6">
            @* Only a draft with step 1 saved is asked about, so it has a name and level *@
            <p class="font-medium">@Draft.Name</p>
            <p class="text-pencil text-sm">Level @Draft.Level</p>
        </div>
        <p class="text-pencil text-sm mb-6">
            Would you like to continue where you left off, or start a new character?
        </p>
        <div class="flex flex-col space-y-3">
            <button @onclick="OnResume"
                    class="btn-main w-full">
                Resume Character
            </button>
            <button @onclick="OnStartFresh"
                    class="btn-secondary w-full">
                Start Fresh
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CharacterDraftDetailsApiResponse Draft { get; set; } = default!;

    [Parameter]
    public EventCallback OnResume { get; set; }

    [Parameter]
    public EventCallback OnStartFresh { get; set; }
}
