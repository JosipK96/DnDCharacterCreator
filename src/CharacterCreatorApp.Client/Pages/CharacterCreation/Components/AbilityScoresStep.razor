@using CharacterCreatorApp.Contracts.Requests.CharacterDrafts
@inject CharacterDraftService DraftService
@inject IJSRuntime JS
@inherits WizardStepBase

<div>
    <h2 class="step-title mb-4">@StepHeading("Ability Scores")</h2>

    <div class="space-y-6">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <Message Kind="MessageKind.Error">
                <p class="text-sm">@ErrorMessage</p>
            </Message>
        }

        <Room Title="Choose Your Method">
            <div class="option-grid">
                <OptionRoom Name="Standard Array" Picked="@(selectedMethod == AbilityScoreMethod.StandardArray)"
                            OnClick="() => SelectMethod(AbilityScoreMethod.StandardArray)">
                    <span>15, 14, 13, 12, 10, 8</span>
                    <span>Quick &amp; balanced</span>
                </OptionRoom>
                <OptionRoom Name="Point Buy" Picked="@(selectedMethod == AbilityScoreMethod.PointBuy)"
                            OnClick="() => SelectMethod(AbilityScoreMethod.PointBuy)">
                    <span>27 points to spend</span>
                    <span>Customize your stats</span>
                </OptionRoom>
                <OptionRoom Name="Roll Dice" Picked="@(selectedMethod == AbilityScoreMethod.RollDice)"
                            OnClick="() => SelectMethod(AbilityScoreMethod.RollDice)">
                    <span>4d6 drop lowest</span>
                    <span>Live dangerously!</span>
                </OptionRoom>
            </div>
        </Room>

        @if (selectedMethod == AbilityScoreMethod.RollDice && !hasRolledScores)
        {
            <RollDiceComponent3D Scores="@availableScores"
                                 ScoresChanged="@OnScoresRolled"
                                 OnRollComplete="@OnRollComplete"
                                 OnRollResultsChanged="@OnRollResultsReceived" />
        }

        @if (selectedMethod == AbilityScoreMethod.StandardArray && !hasGeneratedScores)
        {
            <div class="text-center">
                <button type="button" class="btn-main" @onclick="GenerateStandardArray">Generate Standard Array</button>
            </div>
        }

        @if (selectedMethod == AbilityScoreMethod.PointBuy && !hasGeneratedScores)
        {
            <PointBuyComponent Scores="@availableScores"
                               ScoresChanged="@OnScoresGenerated" />

            @if (availableScores.Count == 6)
            {
                <div class="text-center">
                    <button type="button" class="btn-main" @onclick="() => hasGeneratedScores = true">Use Point Buy Scores</button>
                </div>
            }
        }

        @* The scores on one side, the abilities they go to on the other; one above the other on a phone *@
        @if ((hasRolledScores || hasGeneratedScores) && availableScores.Any())
        {
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                <Room Title="@(selectedMethod == AbilityScoreMethod.RollDice ? "Your Rolled Scores" : "Your Scores")">
                    <p class="mb-4 text-sm text-pencil">Click a score to assign it to an ability</p>

                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                        @for (int scoreIndex = 0; scoreIndex < availableScores.Count; scoreIndex++)
                        {
                            var currentIndex = scoreIndex; // Capture for closure
                            var score = availableScores[currentIndex];
                            var isAssigned = IsScoreIndexAssigned(currentIndex);
                            var isSelected = selectedScoreIndex == currentIndex;

                            <button type="button" class="option-room text-center disabled:cursor-not-allowed disabled:opacity-50"
                                    aria-pressed="@(isSelected ? "true" : "false")" disabled="@isAssigned"
                                    @onclick="() => SelectScore(currentIndex)">
                                @if (selectedMethod == AbilityScoreMethod.RollDice && GetRollForScoreIndex(currentIndex) is { } roll)
                                {
                                    <span class="mb-2 flex justify-center gap-1">
                                        @for (int i = 0; i < roll.AllDice.Count; i++)
                                        {
                                            var die = roll.AllDice[i];
                                            @* The die 4d6 drops is struck through *@
                                            <div class="flex h-6 w-6 items-center justify-center border border-ink text-xs font-semibold @(i == roll.DroppedDieIndex ? "line-through opacity-40" : string.Empty)">@die</div>
                                        }
                                    </span>
                                }
                                <div class="text-4xl font-display font-semibold">@score</div>
                                @if (isAssigned)
                                {
                                    <span class="mt-1 block text-xs">Assigned</span>
                                }
                                else if (isSelected)
                                {
                                    <span class="mt-1 block text-xs text-plum">Selected</span>
                                }
                            </button>
                        }
                    </div>

                    @if (!AllScoresAssigned())
                    {
                        @* The standard array is always the same six numbers, so there all this does is clear the assignments *@
                        <button type="button" class="btn-secondary mt-4 w-full" @onclick="RerollScores">
                            @(selectedMethod == AbilityScoreMethod.RollDice ? "Reroll All" : "Start Over")
                        </button>
                    }
                </Room>

                <Room Title="Assign to Abilities">
                    <p class="mb-4 text-sm text-pencil">
                        @if (selectedScoreIndex.HasValue && selectedScoreIndex >= 0 && selectedScoreIndex < availableScores.Count)
                        {
                            <span>Click an ability to assign <strong>@availableScores[selectedScoreIndex.Value]</strong></span>
                        }
                        else
                        {
                            <span>Select a score first</span>
                        }
                    </p>

                    <div class="space-y-3">
                        @foreach (var ability in new[] { "Strength", "Dexterity", "Constitution", "Intelligence", "Wisdom", "Charisma" })
                        {
                            var assignedScore = GetAssignedScore(ability);
                            var hasScore = assignedScore > 0;

                            <div class="flex flex-wrap items-center justify-between gap-3 border-2 p-3 @(hasScore ? "border-plum bg-plum-tint" : selectedScoreIndex.HasValue ? "border-ink bg-room-highlight" : "border-dashed border-pencil")">
                                <span class="font-medium">@ability</span>

                                @if (hasScore)
                                {
                                    <span class="flex items-center gap-3">
                                        <span class="font-display text-3xl font-semibold">@assignedScore</span>
                                        <button type="button" class="link-back text-sm" @onclick="() => RemoveScore(ability)">Remove</button>
                                    </span>
                                }
                                else if (selectedScoreIndex.HasValue && selectedScoreIndex >= 0 && selectedScoreIndex < availableScores.Count)
                                {
                                    <button type="button" class="btn-main" @onclick="() => AssignScoreToAbility(ability)">
                                        Assign @availableScores[selectedScoreIndex.Value]
                                    </button>
                                }
                                else
                                {
                                    <span class="text-pencil">--</span>
                                }
                            </div>
                        }
                    </div>
                </Room>
            </div>
        }
    </div>

    <StepNavigation OnBack="HandleBack" OnNext="HandleNext" NextDisabled="@(!CanProceed() || IsSaving)"
                    NextText="@(IsSaving ? "Saving..." : NextLabel)" />
</div>
@* The dice roll over the whole window *@
<div id="dice-canvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 9999;"></div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private enum AbilityScoreMethod
    {
        None,
        StandardArray,
        PointBuy,
        RollDice
    }

    private AbilityScoreMethod selectedMethod = AbilityScoreMethod.None;
    private List<int> availableScores = new();
    private List<RollDiceComponent3D.DiceRoll> rollResults = new();
    private Dictionary<string, int> assignedScores = new(); // ability -> score INDEX
    private int? selectedScoreIndex = null;
    private bool hasRolledScores = false;
    private bool hasGeneratedScores = false;

    protected override void OnInitialized()
    {
        foreach (var ability in new[] { "Strength", "Dexterity", "Constitution", "Intelligence", "Wisdom", "Charisma" })
        {
            assignedScores[ability] = -1; // -1 means unassigned
        }
    }

    // Coming back to this step, or editing a saved character, shows the scores the draft holds
    // assigned as they were; a draft from before the method was kept picks them again
    protected override async Task OnInitializedAsync()
    {
        CharacterDraftDetailsApiResponse? draft = null;

        if (!await LoadAsync(async () => draft = await DraftService.GetDraftDetailsAsync(DraftId), "Failed to load the draft")
            || draft?.BaseAbilityScoreMethod is not { } methodId
            || !AbilityIds.All(draft.BaseAbilityScores.ContainsKey))
        {
            return;
        }

        selectedMethod = methodId switch
        {
            "standard-array" => AbilityScoreMethod.StandardArray,
            "point-buy" => AbilityScoreMethod.PointBuy,
            "rolled" => AbilityScoreMethod.RollDice,
            _ => AbilityScoreMethod.None,
        };

        if (selectedMethod == AbilityScoreMethod.None)
        {
            return;
        }

        availableScores = AbilityIds.Select(id => draft.BaseAbilityScores[id]).ToList();
        hasRolledScores = selectedMethod == AbilityScoreMethod.RollDice;
        hasGeneratedScores = !hasRolledScores;

        for (var i = 0; i < AbilityIds.Length; i++)
        {
            assignedScores[AbilityNames.Of(AbilityIds[i])] = i;
        }
    }

    // The abilities by the API's ids, in the order the scores are assigned
    private static readonly string[] AbilityIds = ["STR", "DEX", "CON", "INT", "WIS", "CHA"];

    private void SelectMethod(AbilityScoreMethod method)
    {
        selectedMethod = method;
        availableScores.Clear();
        rollResults.Clear();
        hasRolledScores = false;
        hasGeneratedScores = false;
        selectedScoreIndex = null;
        ErrorMessage = null;

        foreach (var key in assignedScores.Keys.ToList())
        {
            assignedScores[key] = -1;
        }

        StateHasChanged();
    }

    private void OnScoresRolled(List<int> scores)
    {
        availableScores = scores.ToList();
        StateHasChanged();
    }

    private void OnRollResultsReceived(List<RollDiceComponent3D.DiceRoll> rolls)
    {
        rollResults = rolls;
        StateHasChanged();
    }

    private void OnRollComplete()
    {
        hasRolledScores = true;
        StateHasChanged();
    }

    private void GenerateStandardArray()
    {
        availableScores = new List<int> { 15, 14, 13, 12, 10, 8 };
        hasGeneratedScores = true;
        StateHasChanged();
    }

    private void OnScoresGenerated(List<int> scores)
    {
        availableScores = scores.ToList();
        StateHasChanged();
    }

    private void SelectScore(int scoreIndex)
    {
        if (IsScoreIndexAssigned(scoreIndex))
            return;

        selectedScoreIndex = scoreIndex;
        StateHasChanged();
    }

    private void AssignScoreToAbility(string ability)
    {
        if (!selectedScoreIndex.HasValue)
            return;

        assignedScores[ability] = selectedScoreIndex.Value;
        selectedScoreIndex = null;
        ErrorMessage = null;
        StateHasChanged();
    }

    private void RemoveScore(string ability)
    {
        assignedScores[ability] = -1;
        selectedScoreIndex = null;
        StateHasChanged();
    }

    private bool IsScoreIndexAssigned(int scoreIndex)
    {
        return assignedScores.Values.Contains(scoreIndex);
    }

    private int GetAssignedScore(string ability)
    {
        var scoreIndex = assignedScores.GetValueOrDefault(ability, -1);
        if (scoreIndex < 0 || scoreIndex >= availableScores.Count)
            return 0;

        return availableScores[scoreIndex];
    }

    private bool AllScoresAssigned()
    {
        return assignedScores.Values.All(v => v >= 0);
    }

    private RollDiceComponent3D.DiceRoll? GetRollForScoreIndex(int scoreIndex)
    {
        if (scoreIndex < 0 || scoreIndex >= rollResults.Count)
            return null;

        return rollResults[scoreIndex];
    }

    private async Task RerollScores()
    {
        availableScores.Clear();
        rollResults.Clear();
        hasRolledScores = false;
        hasGeneratedScores = false;
        selectedScoreIndex = null;

        foreach (var key in assignedScores.Keys.ToList())
        {
            assignedScores[key] = -1;
        }

        StateHasChanged();

        if (selectedMethod == AbilityScoreMethod.RollDice)
        {
            // Just reset flags - user will click roll button again
            await Task.Delay(100);
        }
        else if (selectedMethod == AbilityScoreMethod.StandardArray)
        {
            GenerateStandardArray();
        }
    }

    private bool CanProceed()
    {
        if (selectedMethod == AbilityScoreMethod.None)
            return false;

        if (!AllScoresAssigned())
            return false;

        return true;
    }

    private async Task HandleNext()
    {
        if (!CanProceed())
        {
            ErrorMessage = "Please assign all ability scores before continuing.";
            return;
        }

        var scores = new Dictionary<string, int>
        {
            ["STR"] = GetAssignedScore("Strength"),
            ["DEX"] = GetAssignedScore("Dexterity"),
            ["CON"] = GetAssignedScore("Constitution"),
            ["INT"] = GetAssignedScore("Intelligence"),
            ["WIS"] = GetAssignedScore("Wisdom"),
            ["CHA"] = GetAssignedScore("Charisma")
        };

        if (await SaveAsync(() => DraftService.SetAbilityScoresAsync(DraftId, scores, MethodId(selectedMethod)), "Failed to save ability scores"))
        {
            await OnNext.InvokeAsync();
        }
    }

    // The server checks the scores against the method, so it is sent by the id the API knows
    private static string MethodId(AbilityScoreMethod method) => method switch
    {
        AbilityScoreMethod.StandardArray => "standard-array",
        AbilityScoreMethod.PointBuy => "point-buy",
        AbilityScoreMethod.RollDice => "rolled",
        _ => throw new ArgumentOutOfRangeException(nameof(method), method, "No method was chosen.")
    };

    private async Task HandleBack()
    {
        await OnBack.InvokeAsync();
    }
}
