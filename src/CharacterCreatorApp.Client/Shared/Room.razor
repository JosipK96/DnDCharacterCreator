@* A room on the map: a section of a page, framed by its Ink wall with a door in the top wall
   (the room utility in Styles/app.css). Rooms are the only framed elements. *@

<section class="room p-5 @Class" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Title))
    {
        <h2 class="room-title mb-3">@Title</h2>
    }
    @ChildContent
</section>

@code {
    /// <summary>The room's title, in Barlow Condensed; none when the room has no heading.</summary>
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Spacing and other layout classes from the page.</summary>
    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
