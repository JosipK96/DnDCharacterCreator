@page "/"

<PageTitle>D&D Character Creator</PageTitle>

<div class="min-h-[80vh] flex items-center justify-center">
    <div class="text-center">
        <h1 class="text-6xl font-bold text-white mb-4">
            🎲 D&D Character Creator
        </h1>
        <p class="text-xl text-gray-400 mb-8">
            Create and manage your D&D 5th Edition characters
        </p>

        <AuthorizeView>
            <Authorized>
                <div class="space-x-4">
                    <a href="/characters"
                       class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-md text-lg font-semibold">
                        My Characters
                    </a>
                    <a href="/character/create"
                       class="inline-block bg-green-600 hover:bg-green-700 text-white px-8 py-3 rounded-md text-lg font-semibold">
                        Create New Character
                    </a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="space-x-4">
                    <a href="/login"
                       class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-md text-lg font-semibold">
                        Login
                    </a>
                    <a href="/register"
                       class="inline-block bg-green-600 hover:bg-green-700 text-white px-8 py-3 rounded-md text-lg font-semibold">
                        Register
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
