@using CharacterCreatorApp.Contracts.Requests.CharacterDrafts
@using CharacterCreatorApp.Contracts.Responses
@inject CharacterDraftService DraftService
@inject LookupService LookupService
@inherits WizardStepBase

<div>
    <h2 class="step-title mb-2">@StepHeading("Choose Your Background")</h2>

    @if (IsLoading)
    {
        <Spinner />
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <Message Kind="MessageKind.Error" Class="mb-6">
            <p class="text-sm">@ErrorMessage</p>
        </Message>
    }
    else
    {
        <p class="mb-5 text-pencil">
            Your background represents what your character did before becoming an adventurer.
            It provides proficiencies, languages, and equipment.
        </p>

        <div class="step-columns">
            <div class="min-w-0 space-y-8">
                <div class="option-grid">
                    @foreach (var background in backgrounds)
                    {
                        <OptionRoom Name="@background.Name" Picked="@(selectedBackground?.Id == background.Id)"
                                    OnClick="() => SelectBackground(background)">
                            @if (SkillsOf(background).Any())
                            {
                                <span>@string.Join(", ", SkillsOf(background).Select(s => s.Name))</span>
                            }
                        </OptionRoom>
                    }
                </div>

                @* A 2024 background raises three abilities: +2 and +1, or +1 to each *@
                @if (selectedBackground?.AbilityScoreOptions.Count > 0)
                {
                    var options = selectedBackground.AbilityScoreOptions;
                    <Room Title="Ability Score Increases">
                        <p class="mb-4 text-sm text-pencil">
                            @selectedBackground.Name raises @string.Join(", ", options.Select(AbilityName)).
                        </p>

                        <div class="mb-4 flex flex-wrap gap-2">
                            <button type="button" class="chip" aria-pressed="@(oneToEach ? "false" : "true")" @onclick="() => oneToEach = false">+2 and +1</button>
                            <button type="button" class="chip" aria-pressed="@(oneToEach ? "true" : "false")" @onclick="() => oneToEach = true">+1 to each</button>
                        </div>

                        @if (!oneToEach)
                        {
                            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                                <label class="text-sm font-medium">
                                    +2 to
                                    <select class="field mt-1" value="@plusTwo" @onchange="e => plusTwo = e.Value?.ToString()">
                                        <option value="">Choose...</option>
                                        @foreach (var ability in options)
                                        {
                                            <option value="@ability">@AbilityName(ability)</option>
                                        }
                                    </select>
                                </label>
                                <label class="text-sm font-medium">
                                    +1 to
                                    <select class="field mt-1" value="@plusOne" @onchange="e => plusOne = e.Value?.ToString()">
                                        <option value="">Choose...</option>
                                        @foreach (var ability in options.Where(a => a != plusTwo))
                                        {
                                            <option value="@ability">@AbilityName(ability)</option>
                                        }
                                    </select>
                                </label>
                            </div>
                        }
                    </Room>
                }

                @* A Mist Wanderer or Spirit Medium picks its feat: any Dark Gift *@
                @if (selectedBackground?.FeatChoiceCategory is { } featCategory)
                {
                    <Room Title="@($"{featCategory} Feat")">
                        <p class="mb-4 text-sm text-pencil">@selectedBackground.Name gives a @featCategory feat of your choice.</p>
                        <select class="field" value="@featId" @onchange="e => featId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">Choose...</option>
                            @foreach (var feat in categoryFeats.Where(f => f.Category == featCategory))
                            {
                                <option value="@feat.Id">@feat.Name</option>
                            }
                        </select>
                    </Room>
                }

                @* A Haunted One or Investigator may take a Dark Gift instead of its own feat *@
                @if (selectedBackground?.FeatAlternativeCategory is { } alternativeCategory)
                {
                    <Room Title="@($"{alternativeCategory} Instead")">
                        <p class="mb-4 text-sm text-pencil">
                            @selectedBackground.Name may take a @alternativeCategory feat in place of @(selectedBackground.Feat?.Name ?? "its feat").
                        </p>
                        <select class="field" value="@featId" @onchange="e => featId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">Keep @(selectedBackground.Feat?.Name ?? "its feat")</option>
                            @foreach (var feat in categoryFeats.Where(f => f.Category == alternativeCategory))
                            {
                                <option value="@feat.Id">@feat.Name</option>
                            }
                        </select>
                    </Room>
                }
            </div>

            @if (selectedBackground is not null)
            {
                <KeyPanel Name="@selectedBackground.Name">
                    <ChildContent>
                        <KeyFact Label="Skills">@ListOrNone(SkillsOf(selectedBackground).Select(p => p.Name))</KeyFact>
                        <KeyFact Label="Tools">@ListOrNone(selectedBackground.Proficiencies.Except(SkillsOf(selectedBackground)).Select(p => p.Name))</KeyFact>
                        @* The API sends the named languages, and counts the free choices in LanguageChoiceCount *@
                        <KeyFact Label="Languages">
                            @ListOrNone(selectedBackground.Languages)
                            @if (selectedBackground.LanguageChoiceCount > 0)
                            {
                                var count = selectedBackground.LanguageChoiceCount;
                                <span class="block">+ Choose @count more language@(count > 1 ? "s" : "") in the next step</span>
                            }
                        </KeyFact>
                        @if (selectedBackground.AbilityScoreOptions.Count > 0)
                        {
                            <KeyFact Label="Ability scores">@string.Join(", ", selectedBackground.AbilityScoreOptions.Select(AbilityName))</KeyFact>
                        }
                        @* Every 2024 background's origin feat, and a few 2014 ones' *@
                        @if (selectedBackground.Feat != null)
                        {
                            <KeyFact Label="Feat">@selectedBackground.Feat.Name</KeyFact>
                        }
                        @if (selectedBackground.Feature != null)
                        {
                            <KeyFact Label="Feature">@selectedBackground.Feature.Name</KeyFact>
                        }
                    </ChildContent>
                    <Note>
                        @if (selectedBackground.Feature != null)
                        {
                            @selectedBackground.Feature.Description
                        }
                        else
                        {
                            @($"From {selectedBackground.Source}.")
                        }
                    </Note>
                </KeyPanel>
            }
        </div>
    }

    <StepNavigation OnBack="HandleBack" OnNext="HandleNext" NextDisabled="@(!CanProceed() || IsSaving)"
                    NextText="@(IsSaving ? "Saving..." : NextLabel)" />
</div>

@code {
    /// <summary>The draft's rules edition; only its backgrounds are offered.</summary>
    [Parameter]
    public string? Edition { get; set; }

    /// <summary>The books the draft allows, by code; only what comes from them is offered.</summary>
    [Parameter]
    public IReadOnlyList<string> Sources { get; set; } = [];

    [Parameter]
    public EventCallback OnNext { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    private List<BackgroundApiResponse> backgrounds = new();
    private BackgroundApiResponse? selectedBackground;

    // A 2024 background's increases: +2 and +1 to two of its abilities, or +1 to all three
    private bool oneToEach;
    private string? plusTwo;
    private string? plusOne;

    // The feat picked for a background that lets the player choose it, from the edition's feats
    private string? featId;
    private List<FeatApiResponse> categoryFeats = [];

    protected override async Task OnInitializedAsync()
    {
        CharacterDraftDetailsApiResponse? draft = null;

        var loaded = await LoadAsync(async () =>
        {
            backgrounds = await LookupService.GetBackgroundsAsync(Edition, Sources);
            draft = await DraftService.GetDraftDetailsAsync(DraftId);
        }, "Failed to load backgrounds");

        // Coming back to this step, or editing a saved character, shows what the draft holds
        if (!loaded || backgrounds.Find(b => b.Id == draft?.BackgroundId) is not { } saved)
        {
            return;
        }

        await SelectBackground(saved);

        var increases = draft!.BackgroundAbilityIncreases;
        oneToEach = increases.Count > 2 && increases.Values.All(points => points == 1);
        plusTwo = increases.FirstOrDefault(i => i.Value == 2).Key;
        plusOne = oneToEach ? null : increases.FirstOrDefault(i => i.Value == 1).Key;
        featId = draft.BackgroundFeatId;
    }

    private async Task SelectBackground(BackgroundApiResponse background)
    {
        // Picking the background already picked keeps its increases and feat
        if (selectedBackground?.Id == background.Id)
        {
            return;
        }

        selectedBackground = background;
        oneToEach = false;
        plusTwo = null;
        plusOne = null;
        featId = null;

        if (BackgroundFeats.PickableCategory(background) != null && categoryFeats.Count == 0)
        {
            await LoadAsync(async () => categoryFeats = await LookupService.GetFeatsAsync(Edition, Sources), "Failed to load feats");
        }
    }

    private static string AbilityName(string abilityId) => AbilityNames.Of(abilityId);

    private static IEnumerable<BackgroundProficiencyApiResponse> SkillsOf(BackgroundApiResponse background) =>
        background.Proficiencies.Where(p => p.Type == "skill");

    private static string ListOrNone(IEnumerable<string> names)
    {
        var list = string.Join(", ", names);
        return list.Length == 0 ? "None" : list;
    }

    // The increases picked so far, or null while a 2024 background's are unfinished
    private Dictionary<string, int>? AbilityIncreases()
    {
        var options = selectedBackground?.AbilityScoreOptions ?? [];

        if (options.Count == 0)
        {
            return [];
        }

        if (oneToEach)
        {
            return options.ToDictionary(ability => ability, _ => 1);
        }

        return string.IsNullOrEmpty(plusTwo) || string.IsNullOrEmpty(plusOne) || plusTwo == plusOne
            ? null
            : new Dictionary<string, int> { [plusTwo] = 2, [plusOne] = 1 };
    }

    private bool CanProceed() =>
        selectedBackground != null && AbilityIncreases() != null && (selectedBackground.FeatChoiceCategory == null || featId != null);

    private async Task HandleNext()
    {
        if (selectedBackground == null || AbilityIncreases() is not { } increases)
        {
            return;
        }

        var pickedFeatId = BackgroundFeats.PickableCategory(selectedBackground) == null ? null : featId;

        if (await SaveAsync(() => DraftService.SetBackgroundAsync(DraftId, selectedBackground.Id, increases, pickedFeatId)))
        {
            await OnNext.InvokeAsync();
        }
    }

    private async Task HandleBack()
    {
        await OnBack.InvokeAsync();
    }
}
