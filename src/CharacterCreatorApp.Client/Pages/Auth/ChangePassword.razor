@page "/account/password"
@attribute [Authorize]
@inject PasswordService PasswordService

<PageTitle>Change password - D&D Character Creator</PageTitle>

<div class="flex items-center justify-center py-12">
    <Room Class="w-full max-w-md space-y-6 p-8">
        <h1 class="step-title text-center">Change password</h1>

        @if (done)
        {
            <Message Kind="MessageKind.Success">Your password is changed.</Message>
        }

        @if (errorMessage is not null)
        {
            <Message Kind="MessageKind.Error">@errorMessage</Message>
        }

        <form @onsubmit="Submit" class="space-y-4">
            <div>
                <label for="current-password" class="block font-medium mb-1">Current password</label>
                <input id="current-password" type="password" @bind="currentPassword" autocomplete="current-password"
                       class="field" />
            </div>
            <div>
                <label for="new-password" class="block font-medium mb-1">New password</label>
                <input id="new-password" type="password" @bind="newPassword" autocomplete="new-password"
                       class="field" />
            </div>
            <div>
                <label for="confirm-password" class="block font-medium mb-1">Repeat the new password</label>
                <input id="confirm-password" type="password" @bind="confirmPassword" autocomplete="new-password"
                       class="field" />
            </div>
            <button type="submit" disabled="@isLoading" class="btn-main w-full">
                Change password
            </button>
        </form>
    </Room>
</div>

@code {
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string? errorMessage;
    private bool isLoading;
    private bool done;

    private async Task Submit()
    {
        errorMessage = null;
        done = false;

        if (newPassword != confirmPassword)
        {
            errorMessage = "The two new passwords are not the same.";
            return;
        }

        isLoading = true;

        try
        {
            await PasswordService.ChangePasswordAsync(currentPassword, newPassword);
            done = true;
            currentPassword = newPassword = confirmPassword = "";
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not reach the server. Check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
