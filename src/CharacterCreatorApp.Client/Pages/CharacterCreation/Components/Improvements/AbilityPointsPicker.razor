@* One improvement spent on ability points: a − and + per ability, two points in all *@

<p class="mb-3 text-sm text-pencil">@Slot.PointsLeft point(s) remaining</p>

<div class="grid grid-cols-2 gap-3 md:grid-cols-3">
    @foreach (var abilityId in AbilityNames.Ids)
    {
        var points = Slot.PointsIn(abilityId);
        var name = AbilityNames.Of(abilityId);
        <div class="border-2 border-ink p-3 @(points > 0 ? "bg-plum-tint" : "bg-room-highlight")">
            <p class="mb-2 text-sm font-medium">@name</p>
            <div class="flex items-center gap-2">
                <button type="button" class="btn-step" aria-label="@($"Lower {name}")"
                        @onclick="() => OnLower.InvokeAsync(abilityId)" disabled="@(points <= 0)">−</button>
                <span class="w-6 text-center font-display text-xl font-semibold">@points</span>
                <button type="button" class="btn-step" aria-label="@($"Raise {name}")"
                        @onclick="() => OnRaise.InvokeAsync(abilityId)" disabled="@(!Slot.CanRaise(abilityId))">+</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public AsiSlot Slot { get; set; } = default!;

    /// <summary>Called with the ability id ("STR") whose + was pressed.</summary>
    [Parameter]
    public EventCallback<string> OnRaise { get; set; }

    /// <summary>Called with the ability id ("STR") whose − was pressed.</summary>
    [Parameter]
    public EventCallback<string> OnLower { get; set; }
}
