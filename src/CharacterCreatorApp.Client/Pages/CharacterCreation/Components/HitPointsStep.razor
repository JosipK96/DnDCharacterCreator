@using System.Globalization
@inject CharacterDraftService DraftService
@inherits WizardStepBase

<div>
    <h2 class="step-title mb-4">@StepHeading("Hit Points")</h2>

    @if (IsLoading)
    {
        <Spinner />
    }
    else
    {
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <Message Kind="MessageKind.Error" Class="mb-6">
                <p class="text-sm">@ErrorMessage</p>
            </Message>
        }

        @if (dieSize > 0)
        {
            <div class="mb-5 flex items-start gap-3">
                <HitDie Die="@hitDie" Size="40" ShowLabel="false" />
                <div class="text-pencil">
                    @if (isLevelUp)
                    {
                        <p>
                            Level @picks[0].Level adds a @hitDie and your Constitution modifier to your hit points.
                            Take the hit die's fixed value, roll it here, or enter what you rolled with your own dice.
                        </p>
                    }
                    else
                    {
                        <p>Level 1 takes the @hitDie's maximum, @dieSize, plus your Constitution modifier.</p>
                        <p class="mt-1">
                            Each later level adds a @hitDie and your Constitution modifier. For each, take the hit die's
                            fixed value, roll it here, or enter what you rolled with your own dice. A level you leave
                            alone takes the fixed value, @fixedValue.
                        </p>
                    }
                </div>
            </div>

            @foreach (var pick in picks)
            {
                var inputId = $"hit-die-roll-{pick.Level}";

                <Room Class="mb-5" data-testid="@($"hit-die-level-{pick.Level}")">
                    <h3 class="room-title mb-3">Level @pick.Level</h3>

                    <div class="option-grid">
                        <OptionRoom Name="@($"Take {fixedValue}")" Picked="@(pick.ChosenBy == ChosenBy.Fixed)" OnClick="() => TakeFixedValue(pick)">
                            <span>The fixed value of a @hitDie</span>
                        </OptionRoom>

                        <OptionRoom Name="@(pick.HasRolled ? $"Rolled {pick.Rolled}" : $"Roll a {hitDie}")" Picked="@(pick.ChosenBy == ChosenBy.Rolled)"
                                    Disabled="@pick.HasRolled" OnClick="() => Roll(pick)">
                            <span>Rolled once, here in the browser</span>
                        </OptionRoom>

                        <div class="option-room" data-picked="@(pick.ChosenBy == ChosenBy.Entered ? "true" : "false")">
                            @if (pick.ChosenBy == ChosenBy.Entered)
                            {
                                <span class="you-are-here" aria-hidden="true"></span>
                            }
                            <label for="@inputId" class="block font-display text-[23px] font-semibold leading-tight">I rolled</label>
                            <input id="@inputId" type="number" min="1" max="@dieSize" value="@pick.Entered"
                                   @onchange="args => Enter(pick, args)" class="field mt-2 w-24" />
                            <span class="mt-1 block text-sm text-pencil">From 1 to @dieSize</span>
                        </div>
                    </div>

                    @if (pick.Chosen is { } result)
                    {
                        <p class="mt-5 font-medium text-plum">Level @pick.Level: @result on the @hitDie, plus your Constitution modifier.</p>
                    }
                    else if (!isLevelUp)
                    {
                        <p class="mt-5 text-pencil">Left alone, level @pick.Level takes the fixed value, @fixedValue.</p>
                    }
                </Room>
            }
        }
    }

    <StepNavigation OnBack="() => OnBack.InvokeAsync()" OnNext="HandleNext" NextDisabled="@(!CanMoveOn || IsSaving)"
                    NextText="@(IsSaving ? "Saving..." : NextLabel)" />
</div>
@code {
    [Parameter]
    public EventCallback OnNext { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    private enum ChosenBy { None, Fixed, Rolled, Entered }

    // What the player picked for one level's hit die
    private sealed class LevelPick(int level)
    {
        public int Level { get; } = level;

        public ChosenBy ChosenBy { get; set; }

        public int? Chosen { get; set; }

        public bool HasRolled { get; set; }

        public int Rolled { get; set; }

        public int? Entered { get; set; }

        // A roll typed in that the die cannot make, which Next waits on rather than dropping
        public bool HasInvalidEntry { get; set; }
    }

    private string hitDie = string.Empty;
    private int dieSize;
    private int fixedValue;
    private bool isLevelUp;

    // The levels the API says the step asks about (HitDieLevels): a level-up's new one, or each from 2
    private List<LevelPick> picks = [];

    // A level-up keeps a result for its new level; a new character's levels left alone take the fixed value
    private bool CanMoveOn => dieSize > 0
        && !picks.Exists(pick => pick.HasInvalidEntry)
        && (!isLevelUp || picks.TrueForAll(pick => pick.Chosen != null));

    protected override async Task OnInitializedAsync()
    {
        CharacterDraftDetailsApiResponse? draft = null;
        DraftChoicesOwedApiResponse? owed = null;

        var loaded = await LoadAsync(async () =>
        {
            draft = await DraftService.GetDraftDetailsAsync(DraftId);

            if (draft != null)
            {
                owed = await DraftService.GetChoicesOwedAsync(DraftId);
            }
        }, "Failed to load the hit die");

        // The API sends no die without a class it can load
        if (!loaded || draft == null || owed is not { HitDieSize: > 0 })
        {
            ErrorMessage ??= "The character's class could not be loaded.";
            return;
        }

        isLevelUp = draft.LevelUpChoices.Count != 0;
        dieSize = owed.HitDieSize;
        hitDie = $"d{dieSize}";

        // What the sheet takes for a level without a result, as the API works it out
        fixedValue = owed.HitDieFixedValue;

        // Coming back to this step shows what was saved
        picks = draft.HitDieLevels.ConvertAll(level =>
        {
            var pick = new LevelPick(level);

            if (draft.HitDieResults.TryGetValue(level, out var saved))
            {
                pick.Chosen = saved;
                pick.ChosenBy = saved == fixedValue ? ChosenBy.Fixed : ChosenBy.Entered;
                pick.Entered = pick.ChosenBy == ChosenBy.Entered ? saved : null;
            }

            return pick;
        });
    }

    private void TakeFixedValue(LevelPick pick)
    {
        pick.Chosen = fixedValue;
        pick.ChosenBy = ChosenBy.Fixed;
    }

    private void Roll(LevelPick pick)
    {
        pick.Rolled = Random.Shared.Next(1, dieSize + 1);
        pick.HasRolled = true;
        pick.Chosen = pick.Rolled;
        pick.ChosenBy = ChosenBy.Rolled;
    }

    private void Enter(LevelPick pick, ChangeEventArgs args)
    {
        var text = args.Value?.ToString();

        if (int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out var value) && value >= 1 && value <= dieSize)
        {
            pick.Entered = value;
            pick.Chosen = value;
            pick.ChosenBy = ChosenBy.Entered;
            pick.HasInvalidEntry = false;
            ErrorMessage = picks.Exists(other => other.HasInvalidEntry) ? ErrorMessage : null;
            return;
        }

        pick.Entered = null;

        // A box emptied again is no roll at all, not a wrong one
        pick.HasInvalidEntry = !string.IsNullOrWhiteSpace(text);
        ErrorMessage = pick.HasInvalidEntry ? $"A {hitDie} rolls from 1 to {dieSize}." : ErrorMessage;

        if (pick.ChosenBy == ChosenBy.Entered)
        {
            pick.Chosen = null;
            pick.ChosenBy = ChosenBy.None;
        }
    }

    private async Task HandleNext()
    {
        if (!CanMoveOn)
        {
            return;
        }

        var results = picks
            .Where(pick => pick.Chosen != null)
            .ToDictionary(pick => pick.Level, pick => pick.Chosen!.Value);

        if (await SaveAsync(() => DraftService.SetHitPointsAsync(DraftId, results), "Failed to save the hit points"))
        {
            await OnNext.InvokeAsync();
        }
    }
}
