# Copy this file to .env (git ignores .env) and fill it in. docker compose reads .env from this
# folder for the ${...} values in docker-compose.yml.

# Required: the key the API signs login tokens with, at least 32 characters. Generate one with
#   openssl rand -base64 48
# or in PowerShell 7:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_KEY=

# The database container. These defaults are what appsettings.Development.json expects, so the
# API started from Visual Studio can use this database as well. The host port is 5433 so it does
# not collide with a PostgreSQL installed locally on 5432.
POSTGRES_DB=charactercreator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# The app is served at http://localhost:<APP_PORT>
APP_PORT=8080

# docker-compose.override.yml makes a local run Development; set this to override it.
# ASPNETCORE_ENVIRONMENT=Production
