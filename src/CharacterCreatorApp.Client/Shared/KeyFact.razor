@* One label and value in a KeyPanel, set off from the next by a dashed line. *@

<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 border-t border-dashed border-pencil/50 py-1.5 first:border-t-0">
    <dt class="text-pencil">@Label</dt>
    <dd class="font-medium sm:text-right">@ChildContent</dd>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
