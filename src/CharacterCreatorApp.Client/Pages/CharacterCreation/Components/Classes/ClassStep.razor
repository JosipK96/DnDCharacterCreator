@* The step: the class, and its subclass from the level the class takes one (SubclassPicker) *@
@inject CharacterDraftService DraftService
@inject LookupService LookupService
@inherits WizardStepBase

<div>
    <h2 class="step-title mb-2">@StepHeading("Choose Your Class")</h2>

    @if (IsLoading)
    {
        <Spinner />
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <Message Kind="MessageKind.Error" Class="mb-6">
            <p class="text-sm">@ErrorMessage</p>
        </Message>
    }
    else
    {
        <p class="mb-5 text-pencil">
            Your class determines your abilities, proficiencies, and role in combat.
        </p>

        <div class="step-columns">
            <div class="min-w-0 space-y-8">
                <div class="option-grid">
                    @* A level-up keeps the class: a level of another one would be multiclassing *@
                    @foreach (var classOption in ClassLocked ? classes.Where(c => c.Id == selectedClass?.Id) : classes)
                    {
                        <OptionRoom Name="@classOption.Name" Picked="@(selectedClass?.Id == classOption.Id)"
                                    OnClick="() => SelectClass(classOption)">
                            <HitDie Die="@classOption.HitDie" Size="28" />
                            @if (classOption.ProficiencyChoice is { } skillChoice)
                            {
                                <span>Pick @skillChoice.Count of @skillChoice.Options.Count skills</span>
                            }
                        </OptionRoom>
                    }
                </div>

                @if (!ClassLocked)
                {
                    <HiddenOptionsNote List="classes" Edition="@Edition" Sources="@Sources" OnChangeBooks="@OnChangeBooks" />
                }

                @if (selectedClass is not null && characterLevel >= selectedClass.SubclassLevel)
                {
                    <SubclassPicker ClassOption="@selectedClass" Subclasses="@subclasses" IsLoading="@loadingSubclasses"
                                    Picked="@selectedSubclass" OnPick="subclass => selectedSubclass = subclass"
                                    Edition="@Edition" Sources="@Sources" OnChangeBooks="@OnChangeBooks" />
                }
                else if (selectedClass is not null)
                {
                    <Message Kind="MessageKind.Info">
                        <p class="text-sm">
                            <strong>Note:</strong> You'll choose a subclass when you reach level @selectedClass.SubclassLevel.
                        </p>
                    </Message>
                }
            </div>

            @if (selectedClass is not null)
            {
                <ClassKeyPanel ClassOption="@selectedClass" />
            }
        </div>
    }

    <StepNavigation OnBack="HandleBack" OnNext="HandleNext" NextDisabled="@(!CanProceed() || IsSaving)"
                    NextText="@(IsSaving ? "Saving..." : NextLabel)" />
</div>

@code {
    [Parameter]
    public int CharacterLevel { get; set; } = 1;

    /// <summary>The draft's rules edition; only its classes are offered.</summary>
    [Parameter, EditorRequired]
    public string Edition { get; set; } = string.Empty;

    /// <summary>The books the draft allows, by code; only what comes from them is offered.</summary>
    [Parameter]
    public IReadOnlyList<string> Sources { get; set; } = [];

    /// <summary>Set in a level-up: the class stays what it is, and only the subclass is picked.</summary>
    [Parameter]
    public bool ClassLocked { get; set; }

    [Parameter]
    public EventCallback OnNext { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    private List<ClassApiResponse> classes = new();
    private List<SubclassApiResponse> subclasses = new();
    private ClassApiResponse? selectedClass;
    private SubclassApiResponse? selectedSubclass;
    private int characterLevel = 1;
    private bool loadingSubclasses = false;

    protected override async Task OnInitializedAsync()
    {
        characterLevel = CharacterLevel;
        CharacterDraftDetailsApiResponse? draft = null;

        var loaded = await LoadAsync(async () =>
        {
            classes = await LookupService.GetClassesAsync(Edition, Sources);
            draft = await DraftService.GetDraftDetailsAsync(DraftId);
        }, "Failed to load classes");

        // Coming back to this step, or editing a saved character, shows what the draft holds
        if (loaded && classes.Find(c => c.Id == draft?.ClassId) is { } saved)
        {
            await SelectClass(saved);
            selectedSubclass = subclasses.Find(s => s.Id == draft!.SubclassId);
        }
    }

    private async Task SelectClass(ClassApiResponse classOption)
    {
        // Picking the class already picked keeps its subclass
        if (selectedClass?.Id == classOption.Id && (subclasses.Count > 0 || characterLevel < classOption.SubclassLevel))
        {
            return;
        }

        selectedClass = classOption;
        selectedSubclass = null;
        StateHasChanged();

        if (characterLevel >= classOption.SubclassLevel)
        {
            await LoadSubclasses(classOption.Id);
        }
    }

    private Task LoadSubclasses(string classId) =>
        RunAsync(
            async () =>
            {
                // Cleared first, so a failed load cannot leave the last class's subclasses showing
                subclasses = [];
                subclasses = await LookupService.GetSubclassesByClassAsync(classId, Sources);
            },
            busy => loadingSubclasses = busy,
            "Failed to load subclasses");

    private bool CanProceed()
    {
        if (selectedClass == null)
        {
            return false;
        }

        if (characterLevel >= selectedClass.SubclassLevel && !loadingSubclasses && !subclasses.Any())
        {
            return false;
        }

        if (characterLevel >= selectedClass.SubclassLevel && subclasses.Any())
        {
            return selectedSubclass != null;
        }

        return true;
    }

    private async Task HandleNext()
    {
        if (!CanProceed())
        {
            return;
        }

        if (await SaveAsync(() => DraftService.SetClassAsync(DraftId, selectedClass!.Id, selectedSubclass?.Id)))
        {
            await OnNext.InvokeAsync();
        }
    }

    private async Task HandleBack()
    {
        await OnBack.InvokeAsync();
    }
}
