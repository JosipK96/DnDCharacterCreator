@page "/reset-password"
@inject PasswordService PasswordService

<PageTitle>Reset password - D&D Character Creator</PageTitle>

<div class="flex items-center justify-center py-12">
    <Room Class="w-full max-w-md space-y-6 p-8">
        <h1 class="step-title text-center">Choose a new password</h1>

        @if (done)
        {
            <Message Kind="MessageKind.Success">
                Your password is changed. <a href="/login" class="underline">Sign in</a> with it.
            </Message>
        }
        else
        {
            @if (errorMessage is not null)
            {
                <Message Kind="MessageKind.Error">@errorMessage</Message>
            }

            <form @onsubmit="Submit" class="space-y-4">
                <div>
                    <label for="new-password" class="block font-medium mb-1">New password</label>
                    <input id="new-password" type="password" @bind="newPassword" autocomplete="new-password"
                           class="field" />
                </div>
                <div>
                    <label for="confirm-password" class="block font-medium mb-1">Repeat the new password</label>
                    <input id="confirm-password" type="password" @bind="confirmPassword" autocomplete="new-password"
                           class="field" />
                </div>
                <button type="submit" disabled="@isLoading" class="btn-main w-full">
                    Set password
                </button>
            </form>
        }
    </Room>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string newPassword = "";
    private string confirmPassword = "";
    private string? errorMessage;
    private bool isLoading;
    private bool done;

    private async Task Submit()
    {
        errorMessage = null;

        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            errorMessage = "This reset link is incomplete. Ask for a new one.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMessage = "The two passwords are not the same.";
            return;
        }

        isLoading = true;

        try
        {
            await PasswordService.ResetPasswordAsync(Email, Token, newPassword);
            done = true;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not reach the server. Check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
