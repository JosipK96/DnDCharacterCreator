@inject CharacterDraftService DraftService
@inject LookupService LookupService
@inherits WizardStepBase

<div>
    @if (subStep == 1)
    {
        <h2 class="step-title mb-2">@StepHeading("Choose Your Race")</h2>

        @if (IsLoading)
        {
            <Spinner />
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <Message Kind="MessageKind.Error" Class="mb-6">
                <p class="text-sm">@ErrorMessage</p>
            </Message>
        }
        else
        {
            <p class="mb-5 text-pencil">Each race provides unique traits and bonuses.</p>

            <div class="step-columns">
                <div class="min-w-0 space-y-8">
                    <div class="option-grid">
                        @foreach (var race in races)
                        {
                            <OptionRoom Name="@race.Name" Picked="@(selectedRace?.Id == race.Id)" OnClick="() => SelectRace(race)">
                                @* A race reprinted in a later book (VGM's aasimar and MPMM's) says which book it is *@
                                @if (races.Count(r => r.Name == race.Name) > 1)
                                {
                                    <span data-testid="race-book">@race.Source</span>
                                }
                                <span>@race.Size · @race.Speed ft.</span>
                                @if (race.Subraces?.Any() == true)
                                {
                                    <span>@race.Subraces.Count @(race.Subraces.Count == 1 ? "option" : "options")</span>
                                }
                            </OptionRoom>
                        }
                    </div>

                    <HiddenOptionsNote List="races" Edition="@(Edition ?? string.Empty)"Sources="@Sources" OnChangeBooks="@OnChangeBooks" />

                    @if (selectedRace?.Subraces?.Any() == true)
                    {
                        <Room Title="@SubraceHeading(selectedRace)">
                            <div class="option-grid">
                                @foreach (var subrace in selectedRace.Subraces)
                                {
                                    <OptionRoom Name="@subrace.Name" Picked="@(selectedSubrace?.Id == subrace.Id)" OnClick="() => SelectSubrace(subrace)">
                                        @if (subrace.Speed is { } subraceSpeed)
                                        {
                                            <span>Speed @subraceSpeed ft.</span>
                                        }
                                        @if (subrace.AbilityScoreBonuses?.Any() == true)
                                        {
                                            <span>@BonusesText(subrace.AbilityScoreBonuses)</span>
                                        }
                                        @if (SubraceChoicesText(subrace) is { } choices)
                                        {
                                            <span>@choices</span>
                                        }
                                    </OptionRoom>
                                }
                            </div>
                        </Room>
                    }

                    @* A half-elf's +1 to two abilities besides Charisma, a variant human's to two of six,
                       a Monsters of the Multiverse race's +2 and +1 or +1 to three *@
                    @if (selectedRace is not null && AbilityChoice().Points > 0 && (selectedRace.Subraces?.Any() != true || selectedSubrace != null))
                    {
                        var choice = AbilityChoice();
                        <ChoiceSection Title="Ability Score Increases" Chosen="@PointsSpent()" Total="@choice.Points">
                            <Description>@AbilityChoiceText(choice, sentence: true)</Description>
                            <ChildContent>
                                @foreach (var ability in choice.Options)
                                {
                                    var amount = abilityPicks.GetValueOrDefault(ability);
                                    <ChoiceRow Name="@($"+{(amount > 0 ? amount : choice.Min)} {AbilityNames.Of(ability)}")" Picked="@(amount > 0)"
                                               Disabled="@(amount == 0 && choice.Points - PointsSpent() < choice.Min)"
                                               OnClick="() => RaiseAbility(ability)" />
                                }
                            </ChildContent>
                        </ChoiceSection>
                    }

                    @* A 2024 human, aasimar or tiefling is Small or Medium, as the player likes *@
                    @if (SizeOptions().Count > 1)
                    {
                        <Room Title="Size">
                            <div class="option-grid">
                                @foreach (var size in SizeOptions())
                                {
                                    <OptionRoom Name="@size" Picked="@(selectedSize == size)" OnClick="() => selectedSize = size" />
                                }
                            </div>
                        </Room>
                    }
                </div>

                @if (selectedRace is not null)
                {
                    <KeyPanel Name="@(selectedSubrace?.Name ?? selectedRace.Name)">
                        <ChildContent>
                            <KeyFact Label="Size">@selectedRace.Size</KeyFact>
                            <KeyFact Label="Speed">@(selectedSubrace?.Speed ?? selectedRace.Speed) ft.</KeyFact>
                            <KeyFact Label="Ability bonuses">@BonusesText([.. selectedRace.AbilityScoreBonuses, .. selectedSubrace?.AbilityScoreBonuses ?? []])</KeyFact>
                            <KeyFact Label="Languages">@(selectedRace.Languages.Count == 0 ? "None" : string.Join(", ", selectedRace.Languages))</KeyFact>
                            @if (selectedRace.Traits.Count + (selectedSubrace?.Traits.Count ?? 0) > 0)
                            {
                                <KeyFact Label="Traits">@string.Join(", ", selectedRace.Traits.Concat(selectedSubrace?.Traits ?? []).Select(t => t.Name))</KeyFact>
                            }
                            @if (selectedRace.FeatChoiceCount > 0)
                            {
                                <KeyFact Label="Feat">@FeatChoiceText(selectedRace.FeatChoiceCount, selectedRace.FeatChoiceCategory)</KeyFact>
                            }
                        </ChildContent>
                        <Note>From @(selectedSubrace?.Source ?? selectedRace.Source).</Note>
                    </KeyPanel>
                }
            </div>
        }

        <StepNavigation OnBack="HandleBack" OnNext="HandleRaceNext" NextDisabled="@(!CanProceedRace() || IsSaving)"
                        NextText="@(IsSaving ? "Saving..." : SkillChoiceCount() > 0 ? "Next: Choose Skills" : NextLabel)" />
    }
    else if (subStep == 2)
    {
        <h2 class="step-title mb-4">@StepHeading($"{selectedSubrace?.Name ?? selectedRace!.Name} Skill Proficiencies")</h2>

        @if (isLoadingSkills)
        {
            <Spinner />
        }
        else
        {
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <Message Kind="MessageKind.Error" Class="mb-6">
                    <p class="text-sm">@ErrorMessage</p>
                </Message>
            }

            <ChoiceSection Title="@($"{selectedSubrace?.Name ?? selectedRace!.Name} skills")" Chosen="@selectedRaceSkills.Count" Total="@SkillChoiceCount()">
                <Description>As a <strong>@(selectedSubrace?.Name ?? selectedRace!.Name)</strong>, choose @SkillChoiceCount() skill proficiency(ies).</Description>
                <ChildContent>
                    @foreach (var skill in availableSkills)
                    {
                        var isSelected = selectedRaceSkills.Contains(skill.Id);
                        <ChoiceRow Name="@skill.Name" Picked="@isSelected"
                                   Disabled="@(!isSelected && selectedRaceSkills.Count >= SkillChoiceCount())"
                                   OnClick="() => ToggleSkill(skill.Id)" />
                    }
                </ChildContent>
            </ChoiceSection>
        }

        <StepNavigation OnBack="() => subStep = 1" OnNext="HandleSkillsNext"
                        NextDisabled="@(selectedRaceSkills.Count != SkillChoiceCount() || IsSaving)"
                        NextText="@(IsSaving ? "Saving..." : NextLabel)" />
    }
</div>

@code {
    /// <summary>The draft's rules edition; only its races are offered.</summary>
    [Parameter] public string? Edition { get; set; }

    /// <summary>The books the draft allows, by code; only what comes from them is offered.</summary>
    [Parameter]
    public IReadOnlyList<string> Sources { get; set; } = [];
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private List<RaceApiResponse> races = [];
    private RaceApiResponse? selectedRace;
    private SubraceApiResponse? selectedSubrace;
    private List<ProficiencyApiResponse> availableSkills = [];
    private HashSet<string> selectedRaceSkills = [];

    // The points picked for the race's or subrace's ability choice, by ability: +1 each for a
    // half-elf, +2 and +1 or +1 to three for a Monsters of the Multiverse race
    private Dictionary<string, int> abilityPicks = [];

    // Picked only for a species that may be Small or Medium
    private string? selectedSize;
    private int subStep = 1;
    private bool isLoadingSkills = false;

    // Coming back to this step, or editing a saved character, shows what the draft holds
    protected override Task OnInitializedAsync() => LoadAsync(async () =>
    {
        races = await LookupService.GetRacesAsync(Edition, Sources);
        var draft = await DraftService.GetDraftDetailsAsync(DraftId);

        if (draft?.RaceId is not { } raceId || races.Find(r => r.Id == raceId) is not { } race)
        {
            return;
        }

        selectedRace = race;
        selectedSubrace = race.Subraces?.Find(s => s.Id == draft.SubraceId);
        abilityPicks = new Dictionary<string, int>(draft.RaceAbilityIncreases);
        selectedSize = draft.Size;
        selectedRaceSkills = [.. draft.SelectedRaceSkillIds];
    }, "Failed to load races");

    // The 2024 book calls them lineages ("Drow Lineage"), ancestries or legacies: the word the
    // options end in, and an ancestry for the dragonborn's dragons, which are just colours
    private static string SubraceHeading(RaceApiResponse race)
    {
        if (race.Edition != "2024")
        {
            return "Choose a Subrace";
        }

        var lastWords = race.Subraces.Select(s => s.Name.Split(' ')[^1]).Distinct().ToList();
        var word = lastWords.Count == 1 && race.Subraces.Count > 1 ? lastWords[0] : "Ancestry";

        return $"Choose {("AEIOU".Contains(word[0]) ? "an" : "a")} {word}";
    }

    private void SelectRace(RaceApiResponse race)
    {
        selectedRace = race;
        selectedSubrace = null;
        selectedRaceSkills = [];
        abilityPicks = [];
        selectedSize = null;
    }

    private void ClearRace()
    {
        selectedRace = null;
        selectedSubrace = null;
        abilityPicks = [];
    }

    // Another subrace may bring its own ability choice (a variant human's), so the picks go
    private void SelectSubrace(SubraceApiResponse subrace)
    {
        if (selectedSubrace?.Id != subrace.Id)
        {
            abilityPicks = [];
            selectedRaceSkills = [];
        }

        selectedSubrace = subrace;
    }

    private bool CanProceedRace()
    {
        if (selectedRace == null) return false;
        if (selectedRace.Subraces?.Any() == true && selectedSubrace == null) return false;
        if (SizeOptions().Count > 1 && selectedSize == null) return false;
        return PointsSpent() == AbilityChoice().Points;
    }

    // "Small or Medium" is either, as the player picks
    private List<string> SizeOptions() =>
        selectedRace?.Size.Split(" or ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList() ?? [];

    // The increases the player picks: a subrace's take the place of the race's, as the variant
    // human's replace the standard human's +1 to everything. The API says how many points, and
    // the fewest and most one ability takes; it refuses any other spread
    private RaceAbilityChoice AbilityChoice() =>
        selectedSubrace is { AbilityChoiceCount: > 0 }
            ? new(selectedSubrace.AbilityChoiceOptions, selectedSubrace.AbilityChoiceCount, selectedSubrace.AbilityChoiceMinPerAbility, selectedSubrace.AbilityChoiceMaxPerAbility)
            : selectedRace is { AbilityChoiceCount: > 0 }
                ? new(selectedRace.AbilityChoiceOptions, selectedRace.AbilityChoiceCount, selectedRace.AbilityChoiceMinPerAbility, selectedRace.AbilityChoiceMaxPerAbility)
                : new([], 0, 1, 1);

    private int PointsSpent() => abilityPicks.Values.Sum();

    // "Raise 2 different abilities by 1.", or for a subrace's option "+1 to 2 abilities"
    private static string AbilityChoiceText(RaceAbilityChoice choice, bool sentence)
    {
        if (choice.Max <= 1)
        {
            return sentence ? $"Raise {choice.Points} different abilities by 1." : $"+1 to {choice.Points} abilities";
        }

        if (choice.Min >= choice.Max)
        {
            var abilities = choice.Points / choice.Max;
            return sentence
                ? $"Raise {abilities} {(abilities == 1 ? "ability" : "different abilities")} by {choice.Max}."
                : $"+{choice.Max} to {abilities} {(abilities == 1 ? "ability" : "abilities")}";
        }

        return sentence
            ? $"Spread {choice.Points} points, at most +{choice.Max} to one ability: pick an ability again to raise it further."
            : $"{choice.Points} points, at most +{choice.Max} to one";
    }

    // The skills picked for the race and subrace together: a variant human's comes with the subrace
    private int SkillChoiceCount() => (selectedRace?.SkillChoiceCount ?? 0) + (selectedSubrace?.SkillChoiceCount ?? 0);

    // Any skill when either pick has no list (a half-elf's, a variant human's), else the listed ones
    private List<string> SkillChoiceOptions()
    {
        var anyFromRace = selectedRace is { SkillChoiceCount: > 0, SkillChoiceOptions.Count: 0 };
        var anyFromSubrace = selectedSubrace is { SkillChoiceCount: > 0, SkillChoiceOptions.Count: 0 };

        return anyFromRace || anyFromSubrace ? [] : [.. selectedRace?.SkillChoiceOptions ?? [], .. selectedSubrace?.SkillChoiceOptions ?? []];
    }

    // Each pick raises the ability by one more point, from the fewest it may take to the most;
    // past that, or with no points left for another, it is unpicked
    private void RaiseAbility(string ability)
    {
        var choice = AbilityChoice();
        var amount = abilityPicks.GetValueOrDefault(ability);
        var next = amount == 0 ? choice.Min : amount + 1;

        if (next <= choice.Max && next - amount <= choice.Points - PointsSpent())
        {
            abilityPicks[ability] = next;
            return;
        }

        abilityPicks.Remove(ability);
    }

    // A 2024 human's Origin feat; the feat is picked with the improvements, where its prerequisites are checked
    private static string FeatChoiceText(int count, string? category) =>
        $"{count} {(category == null ? string.Empty : category + " ")}feat(s) of your choice, picked with the ability score improvements.";

    // What the subrace has the player pick: a variant human's two +1s, a skill and a feat
    private static string? SubraceChoicesText(SubraceApiResponse subrace)
    {
        var choices = new List<string>();

        if (subrace.AbilityChoiceCount > 0)
        {
            choices.Add(AbilityChoiceText(new(subrace.AbilityChoiceOptions, subrace.AbilityChoiceCount, subrace.AbilityChoiceMinPerAbility, subrace.AbilityChoiceMaxPerAbility), sentence: false));
        }

        if (subrace.SkillChoiceCount > 0)
        {
            choices.Add($"{subrace.SkillChoiceCount} skill(s)");
        }

        if (subrace.FeatChoiceCount > 0)
        {
            choices.Add($"{subrace.FeatChoiceCount} feat(s)");
        }

        return choices.Count == 0 ? null : $"Choose {string.Join(", ", choices)}";
    }

    // "+2 CON, +1 STR", or "None"
    private static string BonusesText(IEnumerable<AbilityScoreBonusApiResponse> bonuses)
    {
        var text = string.Join(", ", bonuses.Select(b => $"+{b.Bonus} {b.AbilityScore.ToUpperInvariant()}"));
        return text.Length == 0 ? "None" : text;
    }

    private void ToggleSkill(string id)
    {
        if (selectedRaceSkills.Contains(id))
            selectedRaceSkills.Remove(id);
        else if (selectedRaceSkills.Count < SkillChoiceCount())
            selectedRaceSkills.Add(id);
    }

    private async Task HandleRaceNext()
    {
        if (!CanProceedRace()) return;

        var abilityIncreases = abilityPicks.Where(p => p.Value > 0).ToDictionary(p => p.Key, p => p.Value);

        if (!await SaveAsync(() => DraftService.SetRaceAsync(DraftId, selectedRace!.Id, selectedSubrace?.Id, abilityIncreases, SizeOptions().Count > 1 ? selectedSize : null)))
        {
            return;
        }

        if (SkillChoiceCount() == 0)
        {
            await OnNext.InvokeAsync();
            return;
        }

        subStep = 2;
        await RunAsync(
            async () =>
            {
                // A 2024 elf's Keen Senses is one of three; a half-elf may pick any skill
                var skills = await LookupService.GetSkillProficienciesAsync();
                var options = SkillChoiceOptions();
                availableSkills = options.Count == 0 ? skills : skills.Where(s => options.Contains(s.Id)).ToList();
            },
            busy => isLoadingSkills = busy,
            "Failed to load skills");
    }

    private async Task HandleSkillsNext()
    {
        if (selectedRaceSkills.Count != SkillChoiceCount()) return;

        if (await SaveAsync(() => DraftService.ChooseRaceSkillsAsync(DraftId, selectedRaceSkills.ToList()), "Failed to save race skills"))
        {
            await OnNext.InvokeAsync();
        }
    }

    private async Task HandleBack()
    {
        await OnBack.InvokeAsync();
    }

    // The race's or subrace's ability choice as the API sends it: Points over Options, Min to Max on each ability raised
    private sealed record RaceAbilityChoice(List<string> Options, int Points, int Min, int Max);
}
