@inject CharacterDraftService DraftService
@inject LookupService LookupService
@inherits WizardStepBase

<div>
    <h2 class="text-2xl font-bold text-white mb-6">@StepHeading("Name & Level")</h2>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="bg-red-900 border border-red-700 text-red-200 px-4 py-3 rounded-lg mb-6">
            <p class="text-sm">@ErrorMessage</p>
        </div>
    }

    @if (IsLoading)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600"></div>
        </div>
    }
    else
    {
        <div class="space-y-6">
            <!-- Character Name -->
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">
                    Character Name <span class="text-red-400">*</span>
                </label>
                <input type="text"
                       @bind="characterName"
                       @bind:event="oninput"
                       placeholder="Enter your character's name"
                       maxlength="100"
                       class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-4 py-3 focus:ring-2 focus:ring-indigo-600 focus:border-transparent" />
                @if (!string.IsNullOrWhiteSpace(characterName) && characterName.Length < 2)
                {
                    <p class="text-red-400 text-sm mt-1">Name must be at least 2 characters</p>
                }
            </div>

            <!-- Level -->
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">
                    Starting Level <span class="text-red-400">*</span>
                </label>
                <select @bind="level"
                        class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-4 py-3 focus:ring-2 focus:ring-indigo-600 focus:border-transparent">
                    @for (int i = 1; i <= 20; i++)
                    {
                        <option value="@i">Level @i</option>
                    }
                </select>
                <p class="text-gray-400 text-sm mt-1">
                    Most campaigns start at level 1-3
                </p>
            </div>

            <!-- Rules edition -->
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">
                    Rules <span class="text-red-400">*</span>
                </label>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var option in EditionOptions)
                    {
                        <button type="button"
                                @onclick="() => ChooseEditionAsync(option.Edition)"
                                class="@EditionButtonClass(option.Edition)">
                            <span class="block font-bold text-white">@option.Title</span>
                            <span class="block text-sm text-gray-400 mt-1">@option.Description</span>
                        </button>
                    }
                </div>
                @if (ClearsChoices)
                {
                    <p class="text-yellow-400 text-sm mt-2">
                        Switching rules clears the race, class, background, feats and spells chosen so far.
                    </p>
                }
            </div>

            <!-- Books -->
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Books</label>
                <p class="text-gray-400 text-sm mb-3">
                    The Player's Handbook is always used. Tick the other books your table allows; only what they contain is offered.
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    @foreach (var book in books)
                    {
                        <label class="flex items-center gap-2 text-sm text-white">
                            <input type="checkbox"
                                   checked="@(book.IsPlayersHandbook || selectedBooks.Contains(book.Code))"
                                   disabled="@book.IsPlayersHandbook"
                                   @onchange="e => ToggleBook(book.Code, e.Value is true)" />
                            <span>@book.Name</span>
                        </label>
                    }
                </div>
                @if (ClearsBookChoices)
                {
                    <p class="text-yellow-400 text-sm mt-2">
                        Choices made from a book you untick are cleared.
                    </p>
                }
            </div>
        </div>
    }

    <!-- Navigation Buttons -->
    <div class="flex justify-between mt-8">
        <button @onclick="OnCancel"
                type="button"
                class="bg-gray-700 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
            Cancel
        </button>

        <button @onclick="HandleNext"
                disabled="@(!IsValid() || IsSaving || IsLoading)"
                class="bg-indigo-600 hover:bg-indigo-700 disabled:bg-gray-700 disabled:cursor-not-allowed text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
            @(IsSaving ? "Saving..." : NextLabel)
        </button>
    </div>
</div>

@code {
    // The API's names for the two rulebooks
    private static readonly (string Edition, string Title, string Description)[] EditionOptions =
    [
        ("2024", "2024 rules", "The revised Player's Handbook and the books written for it."),
        ("2014", "2014 rules", "The original Player's Handbook and the books written for it."),
    ];

    /// <summary>The level, edition and books (by code, the Player's Handbook first) the draft was saved with.</summary>
    [Parameter]
    public EventCallback<(int Level, string Edition, IReadOnlyList<string> Sources)> OnNext { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string characterName = "";
    private int level = 1;
    private string edition = EditionOptions[0].Edition;

    // What the draft has saved, to warn before a switch clears choices made under it
    private string savedEdition = EditionOptions[0].Edition;
    private bool hasChoices;

    private bool ClearsChoices => hasChoices && edition != savedEdition;

    // The edition's books, and the ones ticked besides its Player's Handbook, which is always allowed
    private List<BookApiResponse> books = [];
    private HashSet<string> selectedBooks = [];
    private HashSet<string> savedBooks = [];

    private bool ClearsBookChoices => hasChoices && edition == savedEdition && !savedBooks.IsSubsetOf(selectedBooks);

    // Coming back to this step shows what was saved rather than an empty form
    protected override Task OnInitializedAsync() => LoadAsync(async () =>
    {
        var draft = await DraftService.GetDraftDetailsAsync(DraftId);

        if (draft != null)
        {
            characterName = draft.Name ?? "";
            level = draft.Level ?? 1;
            edition = savedEdition = draft.Edition;
            hasChoices = draft.RaceId != null || draft.ClassId != null || draft.BackgroundId != null;
            savedBooks = [.. draft.AllowedSources];
            selectedBooks = [.. savedBooks];
        }

        books = await LookupService.GetBooksAsync(edition);
    }, "Failed to load the draft");

    // The editions share no book, so another edition starts from its Player's Handbook alone
    private Task ChooseEditionAsync(string chosen)
    {
        edition = chosen;
        selectedBooks = chosen == savedEdition ? [.. savedBooks] : [];

        return LoadAsync(async () => books = await LookupService.GetBooksAsync(chosen), "Failed to load the books");
    }

    private void ToggleBook(string code, bool isTicked)
    {
        if (isTicked)
        {
            selectedBooks.Add(code);
        }
        else
        {
            selectedBooks.Remove(code);
        }
    }

    private bool IsValid()
    {
        return !string.IsNullOrWhiteSpace(characterName)
            && characterName.Length >= 2
            && level >= 1
            && level <= 20;
    }

    private string EditionButtonClass(string option)
    {
        var baseClass = "text-left bg-gray-700 border-2 rounded-lg p-4 transition-all duration-200";

        return option == edition
            ? $"{baseClass} border-indigo-500 bg-gray-600"
            : $"{baseClass} border-gray-600 hover:border-indigo-500";
    }

    private async Task HandleNext()
    {
        if (!IsValid()) return;

        // The name and level first: a new edition resets the books, which are then set for it
        var otherBooks = books.Where(b => !b.IsPlayersHandbook && selectedBooks.Contains(b.Code)).Select(b => b.Code).ToList();

        if (await SaveAsync(async () =>
            {
                await DraftService.SetNameAndLevelAsync(DraftId, characterName.Trim(), level, edition);
                await DraftService.SetAllowedBooksAsync(DraftId, otherBooks);
            }))
        {
            var sources = books.Where(b => b.IsPlayersHandbook).Select(b => b.Code).Concat(otherBooks).ToList();
            await OnNext.InvokeAsync((level, edition, sources));
        }
    }
}
