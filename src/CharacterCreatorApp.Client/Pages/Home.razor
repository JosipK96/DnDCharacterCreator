@page "/"

<PageTitle>D&D Character Creator</PageTitle>

<div class="min-h-[70vh] flex items-center justify-center">
    <Room Class="w-full max-w-2xl px-6 py-10 text-center">
        <h1 class="page-title mb-3">D&amp;D Character Creator</h1>
        <p class="text-lg text-pencil mb-8">
            Create and manage your D&amp;D 5th Edition characters
        </p>

        <AuthorizeView>
            <Authorized>
                <div class="flex flex-wrap justify-center gap-4">
                    <a href="/characters" class="btn-main">My Characters</a>
                    <a href="/character/create" class="btn-secondary">Create New Character</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="flex flex-wrap justify-center gap-4">
                    <a href="/login" class="btn-main">Login</a>
                    <a href="/register" class="btn-secondary">Register</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </Room>
</div>
