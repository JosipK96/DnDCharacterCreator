@using CharacterCreatorApp.Contracts.Responses
@inject CharacterDraftService DraftService
@inherits WizardStepBase

<div>
    <h2 class="step-title mb-4">@StepHeading("Review")</h2>

    @if (IsLoading)
    {
        <Spinner />
    }
    else if (preview is null)
    {
        <Message Kind="MessageKind.Error" Class="mb-6">
            <p class="text-sm">@(ErrorMessage ?? "Could not build a preview of this character.")</p>
        </Message>
    }
    else
    {
        <div class="space-y-6">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <Message Kind="MessageKind.Error">
                    <p class="text-sm">@ErrorMessage</p>
                </Message>
            }

            @if (!string.IsNullOrEmpty(preview.BlockingIssue))
            {
                <Message Kind="MessageKind.Warning">
                    <p class="text-sm font-medium">Something still needs choosing</p>
                    <p class="mt-1 text-sm">@preview.BlockingIssue</p>
                </Message>
            }

            <Room>
                <h3 class="font-display text-3xl font-semibold">@preview.Name</h3>
                <p class="font-medium">
                    Level @preview.Level @preview.ClassName@(preview.SubclassName != null ? $" ({preview.SubclassName})" : "")
                </p>
                <p class="mt-1 text-sm text-pencil">
                    @preview.RaceName@(preview.SubraceName != null ? $" ({preview.SubraceName})" : "") • @preview.Size • @preview.BackgroundName • @preview.Edition rules
                </p>
            </Room>

            <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
                <StatBox Label="Hit Points" Value="@preview.Stats.MaxHitPoints.ToString()" />
                <StatBox Label="Armor Class" Value="@preview.Stats.ArmorClass.ToString()" />
                <StatBox Label="Initiative" Value="@Signed(preview.Stats.Initiative)" />
                <StatBox Label="Speed" Value="@preview.Stats.Speed.ToString()" />
                <StatBox Label="Hit Dice" Value="@preview.Stats.HitDice" />
                <StatBox Label="Prof. Bonus" Value="@Signed(preview.Stats.ProficiencyBonus)" />
            </div>

            <Room Title="Ability Scores">
                <div class="grid grid-cols-3 gap-3 md:grid-cols-6">
                    @foreach (var ability in preview.Stats.Abilities)
                    {
                        <StatBox Label="@ability.AbilityId" Value="@ability.Score.ToString()" Sub="@Signed(ability.Modifier)" />
                    }
                </div>
            </Room>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <Room Title="Saving Throws">
                    <dl class="text-sm">
                        @foreach (var save in preview.Stats.SavingThrows)
                        {
                            <KeyFact Label="@($"{save.AbilityId}{(save.IsProficient ? " ●" : string.Empty)}")">@Signed(save.Modifier)</KeyFact>
                        }
                    </dl>
                </Room>

                <Room Title="Proficient Skills">
                    <dl class="text-sm">
                        @foreach (var skill in preview.Stats.Skills.Where(s => s.IsProficient))
                        {
                            <KeyFact Label="@skill.Name">@Signed(skill.Modifier)</KeyFact>
                        }
                    </dl>

                    @if (!preview.Stats.Skills.Any(s => s.IsProficient))
                    {
                        <p class="text-sm text-pencil">No skill proficiencies.</p>
                    }

                    <p class="mt-2 border-t-2 border-ink pt-2 text-sm text-pencil">
                        Passive Perception <span class="font-semibold text-ink">@preview.Stats.PassivePerception</span>
                    </p>
                </Room>
            </div>

            @if (preview.Stats.Spellcasting.Count > 0)
            {
                <Room Title="Spellcasting">
                    <SpellcastingPanel Spellcasting="preview.Stats.Spellcasting" />
                </Room>
            }

            @if (preview.Stats.SpellSlots.Count > 0 || preview.Stats.PactMagic != null)
            {
                <Room Title="Spell Slots">
                    <SpellSlotsPanel Stats="preview.Stats" />
                </Room>
            }

            @if (preview.Languages.Any())
            {
                <Room Title="Languages">
                    <p>@string.Join(", ", preview.Languages.OrderBy(l => l.Name).Select(l => l.Name))</p>
                </Room>
            }

            @if (preview.Feats.Any())
            {
                <Room Title="Feats">
                    <div class="space-y-1">
                        @* One entry per feat taken, as on the sheet: a repeatable feat taken twice shows twice, each with its own spells *@
                        @foreach (var entry in preview.Feats.OrderBy(f => f.Feat.Name))
                        {
                            <p class="font-medium">@entry.Feat.Name</p>
                            @if (entry.Spells.Count > 0)
                            {
                                <p class="text-sm text-pencil">@AbilityNames.SpellsLabel(entry.SpellcastingAbilityId): @string.Join(", ", entry.Spells.Select(s => s.Name))</p>
                            }
                        }
                    </div>
                </Room>
            }

            @if (preview.Spells.Any())
            {
                <Room Title="@($"Spells ({preview.Spells.Count})")">
                    <p>@string.Join(", ", preview.Spells.OrderBy(s => s.Level).ThenBy(s => s.Name).Select(s => s.Name))</p>
                </Room>
            }

            @if (preview.Features.Any())
            {
                <Room Title="@($"Features & Traits ({preview.Features.Count})")">
                    <p>@string.Join(", ", preview.Features.OrderBy(f => f.Name).Select(f => f.Name))</p>
                </Room>
            }
        </div>
    }

    <StepNavigation OnBack="HandleBack" OnNext="HandleNext" NextDisabled="@(!CanProceed())"
                    NextText="@(IsSaving ? (IsEdit ? "Saving..." : "Creating...") : IsEdit ? "Save Changes" : "Create Character")" />
</div>
@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    /// <summary>An edit of a saved character, which saving replaces rather than adds.</summary>
    [Parameter] public bool IsEdit { get; set; }

    private CharacterPreviewApiResponse? preview;

    // A draft that is not ready fails here with the API's own account of what is missing
    protected override Task OnInitializedAsync() =>
        LoadAsync(async () => preview = await DraftService.GetPreviewAsync(DraftId), "Failed to load the preview");

    private bool CanProceed() =>
        !IsSaving && preview is not null && string.IsNullOrEmpty(preview.BlockingIssue);

    private async Task HandleNext()
    {
        if (!CanProceed())
        {
            return;
        }

        // CreateCharacter does the finalizing; this keeps the button busy while it runs
        await SaveAsync(() => OnNext.InvokeAsync(), "Failed to create the character");
    }

    private async Task HandleBack() => await OnBack.InvokeAsync();

    private static string Signed(int value) => value >= 0 ? $"+{value}" : value.ToString();
}
