<div class="mb-8">
    <div class="flex items-start">
        @for (int position = 0; position < Flow.Count; position++)
        {
            var stepNumber = Flow[position];
            var shownNumber = position + 1;
            var isLast = position == Flow.Count - 1;
            var isActive = stepNumber == CurrentStep;
            var isCompleted = position < CurrentPosition;
            var needsPick = StepsNeedingPick.Contains(stepNumber) && !isActive;

            <div class="flex items-center @(isLast ? "" : "flex-1")">
                <div class="flex flex-col items-center">
                    @* An edit can go to any step: every step shows what the draft holds *@
                    @if (OnSelectStep.HasDelegate)
                    {
                        <button type="button" class="@GetStepClass(isActive, isCompleted, needsPick)"
                                title="@StepTitle(stepNumber, needsPick)"
                                @onclick="() => OnSelectStep.InvokeAsync(stepNumber)">
                            @StepMark(shownNumber, isCompleted, needsPick)
                        </button>
                    }
                    else
                    {
                        <div class="@GetStepClass(isActive, isCompleted, needsPick)" title="@StepTitle(stepNumber, needsPick)">
                            @StepMark(shownNumber, isCompleted, needsPick)
                        </div>
                    }
                    <span class="text-xs mt-1 text-center @(isActive ? "text-indigo-400 font-medium" : "text-gray-500")">@GetStepLabel(stepNumber)</span>
                    @if (needsPick)
                    {
                        <span class="text-xs text-amber-400 text-center">Needs a pick</span>
                    }
                </div>
                @if (!isLast)
                {
                    <!-- Connecting line -->
                    <div class="flex-1 h-0.5 mx-2 mb-4 @(isCompleted ? "bg-indigo-600" : "bg-gray-700")"></div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int CurrentStep { get; set; }

    /// <summary>
    /// The steps shown, by number (WizardSteps): all of them for a new character or an edit, and
    /// only what the new level brings for a level-up (WizardSteps.LevelUpOf), numbered as shown.
    /// </summary>
    [Parameter]
    public IReadOnlyList<int> Flow { get; set; } = WizardSteps.Creation;

    /// <summary>The steps still needing a pick: what an edit could not fill in, or a level-up has yet to pick (WizardSteps.StepsOf).</summary>
    [Parameter]
    public IReadOnlySet<int> StepsNeedingPick { get; set; } = new HashSet<int>();

    /// <summary>Set when the player may go to any step by its number, as in an edit.</summary>
    [Parameter]
    public EventCallback<int> OnSelectStep { get; set; }

    private int CurrentPosition => Flow.ToList().IndexOf(CurrentStep);

    private static string GetStepClass(bool isActive, bool isCompleted, bool needsPick)
    {
        var baseClass = "w-10 h-10 rounded-full flex items-center justify-center font-medium";

        if (needsPick)
            return $"{baseClass} bg-amber-600 text-white ring-2 ring-amber-400";

        if (isCompleted)
            return $"{baseClass} bg-indigo-600 text-white";

        if (isActive)
            return $"{baseClass} bg-indigo-600 text-white ring-4 ring-indigo-600 ring-opacity-30";

        return $"{baseClass} bg-gray-700 text-gray-400";
    }

    private static RenderFragment StepMark(int shownNumber, bool isCompleted, bool needsPick) => __builder =>
    {
        if (needsPick)
        {
            <span>!</span>
        }
        else if (isCompleted)
        {
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
        }
        else
        {
            <span>@shownNumber</span>
        }
    };

    private static string StepTitle(int step, bool needsPick) =>
        needsPick ? $"{GetStepLabel(step)}: needs a pick" : GetStepLabel(step);

    private static string GetStepLabel(int step) => WizardSteps.NameOf(step);
}
