@* The wizard's progress as a map: a row of numbered rooms joined by corridors, one per step of
   the flow. Below 700px wide it folds to one line ("Room 3 of 10: Class") over a row of small
   squares, so nothing scrolls sideways on a phone. Both forms show the same four states. *@

<nav aria-label="Wizard progress" class="mb-8">
    @* The map, from 700px wide *@
    <ol class="hidden min-[700px]:flex items-start" data-testid="progress-map">
        @for (int position = 0; position < Flow.Count; position++)
        {
            var step = Flow[position];
            var state = StateOf(position);

            <li class="flex items-start @(position == 0 ? "shrink basis-[72px] min-w-12" : "flex-1 min-w-0")">
                @if (position > 0)
                {
                    @* A corridor: two parallel walls between neighbouring rooms *@
                    <div class="flex h-[92px] min-w-1.5 flex-1 items-center" aria-hidden="true">
                        <div class="h-2.5 w-full border-y-2 border-ink"></div>
                    </div>
                }
                <div class="flex shrink basis-[72px] min-w-12 flex-col items-center">
                    <div class="flex h-[92px] w-full items-center">
                        @* An edit can go to any step: every step shows what the draft holds *@
                        @if (OnSelectStep.HasDelegate)
                        {
                            <button type="button" class="@RoomClass(state) w-full" style="height: @(RoomHeight(position))px"
                                    title="@StepTitle(step, state)" aria-current="@AriaCurrent(state)" data-state="@StateName(state)"
                                    @onclick="() => OnSelectStep.InvokeAsync(step)">
                                @RoomMark(position, state)
                            </button>
                        }
                        else
                        {
                            <div class="@RoomClass(state) w-full" style="height: @(RoomHeight(position))px"
                                 title="@StepTitle(step, state)" aria-current="@AriaCurrent(state)" data-state="@StateName(state)">
                                @RoomMark(position, state)
                            </div>
                        }
                    </div>
                    @* A label may reach past its room into the corridors beside it, so a long name stays one word *@
                    <span class="mt-1 w-[calc(100%+1rem)] text-center text-xs leading-tight @LabelClass(state)">@WizardSteps.NameOf(step)</span>
                    @if (state == RoomState.NeedsPick)
                    {
                        <span class="text-center text-xs text-amber-text">Needs a pick</span>
                    }
                </div>
            </li>
        }
    </ol>

    @* The compact form, below 700px *@
    <div class="min-[700px]:hidden" data-testid="progress-compact">
        <p class="font-display text-xl font-semibold leading-tight text-ink">Room @(CurrentPosition + 1) of @Flow.Count: @WizardSteps.NameOf(CurrentStep)</p>
        @if (CurrentPosition + 1 < Flow.Count)
        {
            <p class="text-sm text-pencil">Next: @WizardSteps.NameOf(Flow[CurrentPosition + 1])</p>
        }
        <ol class="mt-2 flex flex-wrap items-center gap-1">
            @for (int position = 0; position < Flow.Count; position++)
            {
                var step = Flow[position];
                var state = StateOf(position);

                <li class="flex">
                    @if (OnSelectStep.HasDelegate)
                    {
                        @* The square is small; the button around it gives a finger room to press *@
                        <button type="button" class="p-1.5" title="@StepTitle(step, state)" aria-label="@StepTitle(step, state)"
                                aria-current="@AriaCurrent(state)" data-state="@StateName(state)"
                                @onclick="() => OnSelectStep.InvokeAsync(step)">
                            <span class="block size-3 @SquareClass(state)"></span>
                        </button>
                    }
                    else
                    {
                        <span class="block size-3 @SquareClass(state)" title="@StepTitle(step, state)"
                              aria-current="@AriaCurrent(state)" data-state="@StateName(state)"></span>
                    }
                </li>
            }
        </ol>
    </div>
</nav>

@code {
    // How tall each room is, by its place in the row, so the map looks drawn rather than ruled
    private static readonly int[] RoomHeights = [72, 60, 84, 66, 92, 70, 80, 62, 88, 76, 68];

    private enum RoomState
    {
        Done,
        Current,
        NeedsPick,
        Ahead,
    }

    [Parameter]
    public int CurrentStep { get; set; }

    /// <summary>
    /// The steps shown, by number (WizardSteps): all of them for a new character or an edit, and
    /// only what the new level brings for a level-up (WizardSteps.LevelUpOf), numbered as shown.
    /// </summary>
    [Parameter]
    public IReadOnlyList<int> Flow { get; set; } = WizardSteps.Creation;

    /// <summary>The steps still needing a pick: what an edit could not fill in, or a level-up has yet to pick (WizardSteps.StepsOf).</summary>
    [Parameter]
    public IReadOnlySet<int> StepsNeedingPick { get; set; } = new HashSet<int>();

    /// <summary>Set when the player may go to any step by its number, as in an edit.</summary>
    [Parameter]
    public EventCallback<int> OnSelectStep { get; set; }

    private int CurrentPosition => Math.Max(0, Flow.ToList().IndexOf(CurrentStep));

    private static int RoomHeight(int position) => RoomHeights[position % RoomHeights.Length];

    private RoomState StateOf(int position)
    {
        var step = Flow[position];

        if (step == CurrentStep)
        {
            return RoomState.Current;
        }

        if (StepsNeedingPick.Contains(step))
        {
            return RoomState.NeedsPick;
        }

        return position < CurrentPosition ? RoomState.Done : RoomState.Ahead;
    }

    private static string RoomClass(RoomState state) => "flex items-center justify-center font-display text-2xl font-semibold " + state switch
    {
        RoomState.Done => "hatch border-[3px] border-ink text-ink",
        RoomState.Current => "bg-plum-tint border-[5px] border-plum text-plum",
        RoomState.NeedsPick => "bg-amber-tint border-[5px] border-amber text-amber-text",
        _ => "bg-room border-[3px] border-dashed border-ink text-ink",
    };

    private static string SquareClass(RoomState state) => state switch
    {
        RoomState.Done => "hatch border-2 border-ink",
        RoomState.Current => "bg-plum-tint border-2 border-plum",
        RoomState.NeedsPick => "bg-amber-tint border-2 border-amber",
        _ => "bg-room border-2 border-dashed border-ink",
    };

    private static string LabelClass(RoomState state) => state switch
    {
        RoomState.Current => "font-medium text-plum",
        RoomState.NeedsPick => "font-medium text-amber-text",
        _ => "text-ink",
    };

    private static string StateName(RoomState state) => state switch
    {
        RoomState.Done => "done",
        RoomState.Current => "current",
        RoomState.NeedsPick => "needs-pick",
        _ => "ahead",
    };

    private static string? AriaCurrent(RoomState state) => state == RoomState.Current ? "step" : null;

    private static RenderFragment RoomMark(int position, RoomState state) => __builder =>
    {
        if (state == RoomState.NeedsPick)
        {
            <span>!</span>
        }
        else
        {
            @* On the hatching the number sits on a patch of plain floor, so it stays readable *@
            <span class="@(state == RoomState.Done ? "bg-room px-1" : string.Empty)">@(position + 1)</span>
        }
    };

    private static string StepTitle(int step, RoomState state) =>
        state == RoomState.NeedsPick ? $"{WizardSteps.NameOf(step)}: needs a pick" : WizardSteps.NameOf(step);
}
