@page "/login"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Login - D&D Character Creator</PageTitle>

<div class="flex items-center justify-center py-12">
    <Room Class="w-full max-w-md space-y-6 p-8">
        <div>
            <h1 class="step-title text-center">Sign In</h1>
            <p class="mt-2 text-center text-sm text-pencil">
                Access your D&D characters
            </p>
        </div>

        <EditForm Model="@model" OnValidSubmit="@HandleLogin" class="mt-8 space-y-6">
            <DataAnnotationsValidator />
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <Message Kind="MessageKind.Success"><span class="font-medium">@successMessage</span></Message>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <Message Kind="MessageKind.Error">@errorMessage</Message>
            }

            <div class="space-y-4">
                <div>
                    <label for="email" class="block font-medium mb-1">
                        Email Address
                    </label>
                    <InputText id="email"
                               @bind-Value="model.Email"
                               type="email"
                               placeholder="your@email.com"
                               class="field" />
                    <ValidationMessage For="@(() => model.Email)" class="text-red-text text-sm mt-1" />
                </div>

                <div>
                    <label for="password" class="block font-medium mb-1">
                        Password
                    </label>
                    <InputText id="password"
                               @bind-Value="model.Password"
                               type="password"
                               placeholder="••••••••"
                               class="field" />
                    <ValidationMessage For="@(() => model.Password)" class="text-red-text text-sm mt-1" />
                </div>
            </div>

            <div>
                <button type="submit"
                        disabled="@isLoading"
                        class="btn-main w-full">
                    @if (isLoading)
                    {
                        <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </div>

            <div class="text-center">
                <p class="text-sm text-pencil">
                    Forgot your password? Ask the owner of this site for a reset link.
                </p>
                <p class="text-sm text-pencil">
                    Don't have an account?
                    <a href="/register" class="link-back ml-1">
                        Register here
                    </a>
                </p>
            </div>
        </EditForm>
    </Room>
</div>

@code {
    private LoginModel model = new();
    private string? errorMessage;
    private string? successMessage;
    private string returnUrl = "characters";
    private bool isLoading;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (queryParams["registered"] == "true")
        {
            successMessage = "Account created successfully! Please sign in below.";
        }

        // Set by RedirectToLogin. Only a relative path is followed, so a crafted link cannot
        // send someone off the site after they sign in.
        var requested = queryParams["returnUrl"];

        if (!string.IsNullOrWhiteSpace(requested) && Uri.IsWellFormedUriString(requested, UriKind.Relative))
        {
            returnUrl = requested.TrimStart('/');
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            errorMessage = await AuthService.LoginAsync(model.Email, model.Password);

            if (errorMessage is null)
            {
                Navigation.NavigateTo(returnUrl);
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not reach the server. Check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = "";
    }
}