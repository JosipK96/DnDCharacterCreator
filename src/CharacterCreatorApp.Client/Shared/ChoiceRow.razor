@* One option in a ChoiceSection: a square checkbox, the name in bold and its details in Pencil,
   which drop to a second line on a phone. A row of a full section comes in disabled. *@

<button type="button" class="choice-row" aria-pressed="@(Picked ? "true" : "false")"
        disabled="@Disabled" @onclick="OnClick" data-testid="choice-row">
    <span class="choice-box" aria-hidden="true">
        @if (Picked)
        {
            <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3,10.5 8,15.5 17,4.5" />
            </svg>
        }
    </span>
    <span class="flex min-w-0 flex-1 flex-col sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-3">
        <span class="font-semibold">@Name</span>
        @if (ChildContent is not null)
        {
            <span class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm @(Disabled ? string.Empty : "text-pencil")">@ChildContent</span>
        }
    </span>
</button>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public bool Picked { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>The secondary details, such as a spell's school and casting time.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
