@page "/account/password"
@attribute [Authorize]
@inject PasswordService PasswordService

<PageTitle>Change password - D&D Character Creator</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gray-900 py-12 px-4">
    <div class="max-w-md w-full space-y-6 bg-gray-800 p-8 rounded-lg shadow-xl">
        <h2 class="text-center text-3xl font-bold text-white">Change password</h2>

        @if (done)
        {
            <div role="status" class="bg-green-900 border border-green-500 text-green-200 px-4 py-3 rounded">Your password is changed.</div>
        }

        @if (errorMessage is not null)
        {
            <div role="alert" class="bg-red-900 border border-red-700 text-red-200 px-4 py-3 rounded">@errorMessage</div>
        }

        <form @onsubmit="Submit" class="space-y-4">
            <div>
                <label for="current-password" class="block text-sm font-medium text-gray-300 mb-2">Current password</label>
                <input id="current-password" type="password" @bind="currentPassword" autocomplete="current-password"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div>
                <label for="new-password" class="block text-sm font-medium text-gray-300 mb-2">New password</label>
                <input id="new-password" type="password" @bind="newPassword" autocomplete="new-password"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div>
                <label for="confirm-password" class="block text-sm font-medium text-gray-300 mb-2">Repeat the new password</label>
                <input id="confirm-password" type="password" @bind="confirmPassword" autocomplete="new-password"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <button type="submit" disabled="@isLoading" class="w-full py-3 px-4 rounded-lg text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50">
                Change password
            </button>
        </form>
    </div>
</div>

@code {
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string? errorMessage;
    private bool isLoading;
    private bool done;

    private async Task Submit()
    {
        errorMessage = null;
        done = false;

        if (newPassword != confirmPassword)
        {
            errorMessage = "The two new passwords are not the same.";
            return;
        }

        isLoading = true;

        try
        {
            await PasswordService.ChangePasswordAsync(currentPassword, newPassword);
            done = true;
            currentPassword = newPassword = confirmPassword = "";
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not reach the server. Check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
