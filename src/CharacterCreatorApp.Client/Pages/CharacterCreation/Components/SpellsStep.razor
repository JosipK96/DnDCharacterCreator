@inject CharacterDraftService DraftService
@inject LookupService LookupService
@inherits WizardStepBase

<div>
    <h2 class="step-title mb-2">@StepHeading("Spells")</h2>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <Message Kind="MessageKind.Error" Class="mb-6">
            <p class="text-sm">@ErrorMessage</p>
        </Message>
    }

    @if (IsLoading)
    {
        <Spinner Text="Loading spell options..." />
    }
    else
    {
        <div class="step-columns">
            <div class="min-w-0 space-y-6">
                @if (!isSpellcaster)
                {
                    <Room Title="No Spells Available">
                        <p>@className doesn't have spellcasting at level @(draft?.Level ?? 1).</p>
                        @if (bonusChoices.Count > 0)
                        {
                            <p class="mt-2 text-sm text-pencil">Your race or feats still give spells to pick below.</p>
                        }
                    </Room>
                }
                else
                {
                    <p class="text-pencil">
                        @className:
                        @if (cantripsKnown > 0 && spellsKnown > 0)
                        {
                            <span>Choose @cantripsKnown @(cantripsKnown == 1 ? "cantrip" : "cantrips") and @spellsKnown @(spellsKnown == 1 ? "spell" : "spells").</span>
                        }
                        else if (cantripsKnown > 0)
                        {
                            <span>Choose @cantripsKnown @(cantripsKnown == 1 ? "cantrip" : "cantrips").</span>
                        }
                        else if (spellsKnown > 0)
                        {
                            <span>Choose @spellsKnown @(spellsKnown == 1 ? "spell" : "spells") for your starting repertoire.</span>
                        }
                    </p>

                    @* A 2014 cleric, druid, paladin or artificer: the count follows its scores and level *@
                    @if (spellsFollowScores)
                    {
                        <Message Kind="MessageKind.Info">
                            <p class="mb-1 font-semibold">Prepared Spells</p>
                            <p class="text-sm">
                                @className prepares @spellsKnown @(spellsKnown == 1 ? "spell" : "spells") from the @className spell list:
                                its spellcasting ability modifier plus its level, or half its level, at least one.
                                @if (alwaysPreparedSpells.Count > 0)
                                {
                                    <span>Your subclass's spells are always prepared on top of these: @string.Join(", ", alwaysPreparedSpells.Select(s => s.Name)).</span>
                                }
                            </p>
                        </Message>
                    }

                    @* The search and filters, over both sections *@
                    <div class="space-y-3">
                        <div class="flex flex-wrap gap-3">
                            <input @bind="searchText" @bind:event="oninput" type="text" placeholder="Search spells..."
                                   aria-label="Search spells" class="field min-w-[12rem] flex-1" />
                            @if (maxSpellLevel > 0)
                            {
                                <select @bind="filterLevel" aria-label="Spell level" class="field w-auto">
                                    <option value="">All Levels</option>
                                    <option value="0">Cantrips</option>
                                    @for (int i = 1; i <= maxSpellLevel; i++)
                                    {
                                        <option value="@i">Level @i</option>
                                    }
                                </select>
                            }
                        </div>
                        @if (schools.Count > 1)
                        {
                            <div class="flex flex-wrap gap-2" role="group" aria-label="School">
                                <button type="button" class="chip" aria-pressed="@(filterSchool is null ? "true" : "false")" @onclick="() => filterSchool = null">All schools</button>
                                @foreach (var school in schools)
                                {
                                    <button type="button" class="chip" aria-pressed="@(filterSchool == school ? "true" : "false")" @onclick="() => filterSchool = school">@school</button>
                                }
                            </div>
                        }
                    </div>

                    @if (cantripsKnown > 0 && availableCantrips.Any())
                    {
                        <ChoiceSection Title="Cantrips" Chosen="@selectedCantrips.Count" Total="@cantripsKnown">
                            @SpellRows(availableCantrips, selectedCantrips, cantripsKnown, ToggleCantrip)
                        </ChoiceSection>
                    }

                    @if (spellsKnown > 0 && availableLeveledSpells.Any())
                    {
                        <ChoiceSection Title="Spells" Chosen="@selectedLeveledSpells.Count" Total="@spellsKnown">
                            <Description>Up to level @maxSpellLevel.</Description>
                            <ChildContent>@SpellRows(availableLeveledSpells, selectedLeveledSpells, spellsKnown, ToggleLeveledSpell)</ChildContent>
                        </ChoiceSection>
                    }

                    <HiddenOptionsNote List="spells" Edition="@(draft?.Edition ?? string.Empty)" Sources="@(draft?.AllowedSources ?? [])"
                                       ClassId="@draft?.ClassId" SubclassId="@draft?.SubclassId" MaxLevel="@maxSpellLevel"
                                       OnChangeBooks="@OnChangeBooks" />
                }

                @* Spells the race (a high elf's cantrip) and feats (Magic Initiate) let the character pick *@
                @for (var i = 0; i < bonusChoices.Count; i++)
                {
                    var index = i;
                    var choice = bonusChoices[index];
                    var list = choice.Lists.FirstOrDefault(l => l.ClassId == bonusListIds[index]);
                    var picks = bonusPicks[index];

                    <ChoiceSection Title="@($"{choice.Name} Spells")" Chosen="@picks.Count" Total="@(choice.Cantrips + choice.FirstLevelSpells)">
                        <Description>
                            <p>@BonusText(choice)</p>
                            <div class="grid gap-3 md:grid-cols-2 @(choice.Lists.Count > 1 || choice.AbilityOptions.Count > 0 ? "mt-3" : string.Empty)">
                                @if (choice.Lists.Count > 1)
                                {
                                    <select class="field" aria-label="Spell list" value="@bonusListIds[index]" @onchange="e => SelectBonusList(index, e.Value?.ToString())">
                                        <option value="">Choose a spell list...</option>
                                        @foreach (var option in choice.Lists)
                                        {
                                            <option value="@option.ClassId">@option.ClassName</option>
                                        }
                                    </select>
                                }

                                @* The 2024 Magic Initiate's or a 2024 high elf's spellcasting ability: Intelligence, Wisdom or Charisma *@
                                @if (choice.AbilityOptions.Count > 0)
                                {
                                    <select class="field" aria-label="Spellcasting ability" value="@bonusAbilities[index]"
                                            @onchange="e => bonusAbilities[index] = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                                        <option value="">Spellcasting ability...</option>
                                        @foreach (var ability in choice.AbilityOptions)
                                        {
                                            <option value="@ability">@AbilityNames.Of(ability)</option>
                                        }
                                    </select>
                                }
                            </div>
                        </Description>
                        <ChildContent>
                            @if (list != null)
                            {
                                @foreach (var spell in list.Spells)
                                {
                                    var isSelected = picks.Contains(spell.Id);
                                    <ChoiceRow Name="@spell.Name" Picked="@isSelected"
                                               Disabled="@(!isSelected && !BonusRoomFor(choice, picks, list, spell.Level))"
                                               OnClick="() => ToggleBonusSpell(index, spell)">
                                        @(spell.Level == 0 ? "Cantrip" : "1st level") · @spell.School
                                    </ChoiceRow>
                                }
                            }
                            else
                            {
                                <p class="px-4 py-3 text-sm text-pencil">Choose a spell list to see its spells.</p>
                            }
                        </ChildContent>
                    </ChoiceSection>
                }
            </div>

            @if (isSpellcaster || bonusChoices.Count > 0)
            {
                <Room Title="Your spellbook" data-testid="spellbook">
                    @if (isSpellcaster && cantripsKnown > 0)
                    {
                        @SpellbookSection("Cantrips", availableCantrips, selectedCantrips, cantripsKnown)
                    }
                    @if (isSpellcaster && spellsKnown > 0)
                    {
                        @SpellbookSection("Spells", availableLeveledSpells, selectedLeveledSpells, spellsKnown)
                    }
                    @for (var i = 0; i < bonusChoices.Count; i++)
                    {
                        var choice = bonusChoices[i];
                        var spells = choice.Lists.FirstOrDefault(l => l.ClassId == bonusListIds[i])?.Spells ?? [];
                        @SpellbookSection($"{choice.Name} Spells", spells, bonusPicks[i], choice.Cantrips + choice.FirstLevelSpells)
                    }
                </Room>
            }
        </div>
    }

    <StepNavigation OnBack="HandleBack" OnNext="HandleNext" NextDisabled="@(!CanProceed() || IsSaving)"
                    NextText="@(IsSaving ? "Saving..." : NextLabel)" />
</div>
@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private CharacterDraftDetailsApiResponse? draft;
    private string? className;

    private bool isSpellcaster = false;
    private bool spellsFollowScores = false; // a 2014 prepared caster's count, from the server
    private List<SpellApiResponse> alwaysPreparedSpells = [];
    private int spellsKnown = 0;
    private int cantripsKnown = 0;
    private int maxSpellLevel = 0;

    private List<SpellApiResponse> availableCantrips = [];
    private List<SpellApiResponse> availableLeveledSpells = [];
    private HashSet<string> schools = [];

    private HashSet<string> selectedCantrips = [];
    private HashSet<string> selectedLeveledSpells = [];

    private string? filterLevel;
    private string? filterSchool;
    private string searchText = "";


    // One per race or feat pick, in the order the API lists them: the list chosen and the spells
    private List<BonusSpellChoiceApiResponse> bonusChoices = [];
    private List<string?> bonusListIds = [];
    private List<HashSet<string>> bonusPicks = [];

    // The spellcasting ability picked for a feat that asks for one (the 2024 Magic Initiate's)
    private List<string?> bonusAbilities = [];

    protected override Task OnInitializedAsync() =>
        LoadAsync(
            async () =>
            {
                await LoadSpellsAsync();
                await LoadBonusSpellsAsync();
            },
            "Failed to load spells");

    private async Task LoadBonusSpellsAsync()
    {
        bonusChoices = await DraftService.GetBonusSpellsAsync(DraftId);
        bonusListIds = bonusChoices.ConvertAll(c => c.Lists.Count == 1 ? c.Lists[0].ClassId : null);
        bonusPicks = bonusChoices.ConvertAll(_ => new HashSet<string>());
        bonusAbilities = bonusChoices.ConvertAll(_ => (string?)null);

        // What the draft already holds: the race's spells, and the feats' picks in the same order
        var featPicks = draft?.FeatSpells ?? [];
        var featIndex = 0;

        for (var i = 0; i < bonusChoices.Count; i++)
        {
            if (bonusChoices[i].FeatId == null)
            {
                bonusAbilities[i] = draft?.RaceSpellAbilityId;
                bonusPicks[i] = [.. draft?.RaceSpellIds ?? []];
            }
            else if (featIndex < featPicks.Count && featPicks[featIndex].FeatId == bonusChoices[i].FeatId)
            {
                bonusListIds[i] = featPicks[featIndex].ClassId;
                bonusAbilities[i] = featPicks[featIndex].AbilityId;
                bonusPicks[i] = [.. featPicks[featIndex++].SpellIds];
            }
        }
    }

    private static string BonusText(BonusSpellChoiceApiResponse choice)
    {
        var parts = new List<string>();

        if (choice.Cantrips > 0)
        {
            parts.Add($"{choice.Cantrips} cantrip(s)");
        }

        if (choice.FirstLevelSpells > 0)
        {
            parts.Add($"{choice.FirstLevelSpells} 1st-level spell(s)");
        }

        return $"Choose {string.Join(" and ", parts)}{(choice.Lists.Count > 1 ? " from one spell list" : string.Empty)}.";
    }

    // Another list takes the spells picked from the old one with it
    private void SelectBonusList(int index, string? classId)
    {
        bonusListIds[index] = string.IsNullOrEmpty(classId) ? null : classId;
        bonusPicks[index] = [];
    }

    private static bool BonusRoomFor(BonusSpellChoiceApiResponse choice, HashSet<string> picks, BonusSpellListApiResponse list, int level)
    {
        var picked = list.Spells.Count(s => picks.Contains(s.Id) && s.Level == level);
        return picked < (level == 0 ? choice.Cantrips : choice.FirstLevelSpells);
    }

    private void ToggleBonusSpell(int index, SpellApiResponse spell)
    {
        var list = bonusChoices[index].Lists.First(l => l.ClassId == bonusListIds[index]);

        if (!bonusPicks[index].Remove(spell.Id) && BonusRoomFor(bonusChoices[index], bonusPicks[index], list, spell.Level))
        {
            bonusPicks[index].Add(spell.Id);
        }
    }

    private bool BonusComplete() =>
        bonusChoices.Select((choice, i) => bonusListIds[i] != null
                && bonusPicks[i].Count == choice.Cantrips + choice.FirstLevelSpells
                && (choice.AbilityOptions.Count == 0 || choice.AbilityOptions.Contains(bonusAbilities[i] ?? string.Empty)))
            .All(done => done);

    private async Task LoadSpellsAsync()
    {
        draft = await DraftService.GetDraftDetailsAsync(DraftId);

        if (draft == null) { ErrorMessage = "Draft not found."; return; }
        if (string.IsNullOrEmpty(draft.ClassId)) { ErrorMessage = "No class selected."; return; }
        if (draft.Level == null) { ErrorMessage = "Character level is not set. Please go back to step 1."; return; }

        var classDetails = await LookupService.GetClassByIdAsync(draft.ClassId);
        if (classDetails == null) { ErrorMessage = "Failed to load class details."; return; }

        className = classDetails.Name;
        var characterLevel = draft.Level.Value;

        var subclassDetails = string.IsNullOrEmpty(draft.SubclassId)
            ? null
            : await LookupService.GetSubclassByIdAsync(draft.SubclassId);

        // A subclass that casts for a class with no table of its own (Eldritch Knight, Arcane Trickster) is named with it
        if (!classDetails.SpellProgression.Any(p => p.CharacterLevel == characterLevel)
            && subclassDetails?.SpellProgression.Any(p => p.CharacterLevel == characterLevel) == true)
        {
            className = $"{classDetails.Name} ({subclassDetails.Name})";
        }

        // The counts come from the server, which checks the picks against them: a 2014 cleric's
        // prepared spells follow its final scores
        var allowance = await DraftService.GetSpellAllowanceAsync(DraftId);
        isSpellcaster = allowance.CastsSpells;

        if (!isSpellcaster)
        {
            return;
        }

        spellsKnown = allowance.Spells;
        cantripsKnown = allowance.Cantrips;
        maxSpellLevel = allowance.MaxSpellLevel;
        spellsFollowScores = allowance.SpellsFollowScores;

        // What PUT spells accepts, up to the highest spell level (cantrips are level 0), from the
        // draft's books: the class's list, another class's a subclass opens up (the Wizard's for an
        // Eldritch Knight) and the spells a subclass adds, as the server puts them together, with
        // the always-prepared ones
        var allSpells = allowance.SpellList;

        // A domain or oath spell is prepared already and not one of the picks
        var alwaysPreparedIds = allowance.AlwaysPreparedSpellIds.ToHashSet();
        alwaysPreparedSpells = allSpells.Where(s => alwaysPreparedIds.Contains(s.Id)).ToList();
        allSpells = allSpells.Where(s => !alwaysPreparedIds.Contains(s.Id)).ToList();

        availableCantrips = allSpells.Where(s => s.Level == 0).ToList();
        availableLeveledSpells = allSpells.Where(s => s.Level > 0).ToList();
        // The school chips sit above both sections, so they offer the cantrips' schools too
        schools = allSpells.Select(s => s.School).Distinct().OrderBy(s => s).ToHashSet();

        // Restore previously selected spells
        if (draft.SelectedSpellIds?.Any() == true)
        {
            var cantripIds = availableCantrips.Select(s => s.Id).ToHashSet();
            foreach (var id in draft.SelectedSpellIds)
            {
                if (cantripIds.Contains(id))
                    selectedCantrips.Add(id);
                else
                    selectedLeveledSpells.Add(id);
            }
        }
    }

    private List<SpellApiResponse> GetFilteredSpells(List<SpellApiResponse> source)
    {
        var result = source.AsEnumerable();

        if (!string.IsNullOrEmpty(filterLevel) && int.TryParse(filterLevel, out var level))
            result = result.Where(s => s.Level == level);

        if (!string.IsNullOrEmpty(filterSchool))
            result = result.Where(s => s.School == filterSchool);

        if (!string.IsNullOrEmpty(searchText))
            result = result.Where(s =>
                s.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                s.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase));

        return result.ToList();
    }

    private void ToggleCantrip(string spellId)
    {
        if (selectedCantrips.Contains(spellId))
            selectedCantrips.Remove(spellId);
        else if (selectedCantrips.Count < cantripsKnown)
            selectedCantrips.Add(spellId);

        ErrorMessage = null;
        StateHasChanged();
    }

    private void ToggleLeveledSpell(string spellId)
    {
        if (selectedLeveledSpells.Contains(spellId))
            selectedLeveledSpells.Remove(spellId);
        else if (selectedLeveledSpells.Count < spellsKnown)
            selectedLeveledSpells.Add(spellId);

        ErrorMessage = null;
        StateHasChanged();
    }

    private bool CanProceed()
    {
        if (IsLoading || IsSaving) return false;
        if (!BonusComplete()) return false;
        if (!isSpellcaster) return true;

        if (cantripsKnown > 0 && selectedCantrips.Count != cantripsKnown) return false;

        if (spellsKnown > 0 && selectedLeveledSpells.Count != spellsKnown) return false;

        return true;
    }

    private async Task HandleNext()
    {
        if (!CanProceed())
        {
            if (cantripsKnown > 0 && selectedCantrips.Count != cantripsKnown)
                ErrorMessage = $"Please select exactly {cantripsKnown} cantrip{(cantripsKnown == 1 ? "" : "s")}.";
            else if (spellsKnown > 0 && selectedLeveledSpells.Count != spellsKnown)
                ErrorMessage = $"Please select exactly {spellsKnown} spell{(spellsKnown == 1 ? "" : "s")}.";
            return;
        }

        var allSelected = selectedCantrips.Concat(selectedLeveledSpells).ToList();

        if (isSpellcaster && allSelected.Any()
            && !await SaveAsync(() => DraftService.ChooseSpellsAsync(DraftId, allSelected), "Failed to save spells"))
        {
            return;
        }

        if (bonusChoices.Count > 0 && !await SaveAsync(SaveBonusSpellsAsync, "Failed to save spells"))
        {
            return;
        }

        await OnNext.InvokeAsync();
    }

    private Task SaveBonusSpellsAsync()
    {
        var indexed = bonusChoices.Select((choice, i) => (Choice: choice, Index: i)).ToList();
        var race = indexed.Where(c => c.Choice.FeatId == null).ToList();
        var raceSpellIds = race.SelectMany(c => bonusPicks[c.Index]).ToList();
        var raceSpellAbilityId = race.Where(c => c.Choice.AbilityOptions.Count > 0).Select(c => bonusAbilities[c.Index]).FirstOrDefault();
        var featSpells = indexed
            .Where(c => c.Choice.FeatId != null)
            .Select(c => new FeatSpellPickApiModel
            {
                FeatId = c.Choice.FeatId!,
                ClassId = bonusListIds[c.Index]!,
                SpellIds = [.. bonusPicks[c.Index]],
                AbilityId = c.Choice.AbilityOptions.Count > 0 ? bonusAbilities[c.Index] : null,
            })
            .ToList();

        return DraftService.ChooseBonusSpellsAsync(DraftId, raceSpellIds, raceSpellAbilityId, featSpells);
    }

    private async Task HandleBack()
    {
        await OnBack.InvokeAsync();
    }

    // One section's rows: name, then level, school and casting time, and R and C for ritual and concentration
    private RenderFragment SpellRows(List<SpellApiResponse> spells, HashSet<string> picked, int allowed, Action<string> toggle) => __builder =>
    {
        var shown = GetFilteredSpells(spells);

        @foreach (var spell in shown)
        {
            var isSelected = picked.Contains(spell.Id);
            <ChoiceRow Name="@spell.Name" Picked="@isSelected" Disabled="@(!isSelected && picked.Count >= allowed)"
                       OnClick="() => toggle(spell.Id)">
                @if (spell.Level > 0)
                {
                    <span>Level @spell.Level</span>
                }
                <span>@spell.School</span>
                <span>@spell.CastingTime</span>
                @if (spell.IsRitual)
                {
                    <span class="row-tag" title="Ritual" aria-label="Ritual">R</span>
                }
                @if (spell.IsConcentration)
                {
                    <span class="row-tag" title="Concentration" aria-label="Concentration">C</span>
                }
            </ChoiceRow>
        }

        @if (shown.Count == 0)
        {
            <p class="px-4 py-3 text-sm text-pencil">No spells match your filters.</p>
        }
    };

    // The spellbook's list for one section: the picks by name, then "Not chosen yet" for each slot still open
    private static RenderFragment SpellbookSection(string title, List<SpellApiResponse> spells, HashSet<string> picked, int allowed) => __builder =>
    {
        var names = spells.Where(s => picked.Contains(s.Id)).Select(s => s.Name).ToList();

        <div class="border-t border-dashed border-pencil/50 py-2 first:border-t-0 first:pt-0" data-testid="spellbook-section">
            <h4 class="text-sm font-semibold text-pencil">@title</h4>
            <ul class="text-sm">
                @foreach (var name in names)
                {
                    <li class="font-medium">@name</li>
                }
                @for (var open = names.Count; open < allowed; open++)
                {
                    <li class="italic text-pencil">Not chosen yet</li>
                }
            </ul>
        </div>
    };
}