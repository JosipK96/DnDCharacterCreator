@using CharacterCreatorApp.Contracts.Responses
@inject CharacterDraftService DraftService
@inject LookupService LookupService
@inherits WizardStepBase

<div>
    <h2 class="step-title mb-4">@StepHeading("Ability Score Improvements")</h2>

    @if (IsLoading)
    {
        <Spinner />
    }
    else
    {
        <div class="space-y-6">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <Message Kind="MessageKind.Error">
                    <p class="text-sm">@ErrorMessage</p>
                </Message>
            }

            @* The background's feat may ask for skills or tools too: a Noble's Skilled *@
            @if (backgroundFeat is { Choice: { } backgroundChoice })
            {
                <Room Title="@($"Background Feat: {backgroundFeat.Name}")">
                    @ProficiencySelects(backgroundChoice, backgroundFeatPicks)
                </Room>
            }

            @if (fightingStylesOwed > 0)
            {
                <Room Title="Fighting Style">
                    <p class="mb-4 text-sm text-pencil">
                        Your class gives you <strong>@fightingStylesOwed</strong> Fighting Style(s). Pick @(fightingStylesOwed == 1 ? "one" : "them").
                    </p>

                    @for (int s = 0; s < fightingStylesOwed; s++)
                    {
                        var styleIndex = s;
                        <label class="mb-3 block text-sm font-medium">
                            @(fightingStylesOwed == 1 ? "Style" : $"Style {styleIndex + 1}")
                            <select class="field mt-1" value="@chosenStyles[styleIndex]" @onchange="e => chosenStyles[styleIndex] = e.Value?.ToString()">
                                <option value="">Choose...</option>
                                @foreach (var style in fightingStyleOptions.Where(o => o.Id == chosenStyles[styleIndex] || (!chosenStyles.Contains(o.Id) && !slots.Any(slot => slot.TakesFeat && slot.FeatId == o.Id))))
                                {
                                    <option value="@style.Id">@style.Name</option>
                                }
                            </select>
                            @if (fightingStyleOptions.FirstOrDefault(o => o.Id == chosenStyles[styleIndex]) is { } picked)
                            {
                                <span class="mt-1 block text-xs font-normal text-pencil">@Truncate(picked.Description)</span>
                            }
                        </label>
                    }
                </Room>
            }

            @if (slots.Count == 0 && fightingStylesOwed == 0)
            {
                <Room Title="No Improvements">
                    <p>No Ability Score Improvements available at this level.</p>
                    <p class="mt-2 text-sm text-pencil">ASIs are gained at levels @(string.Join(", ", asiLevels)) for your class.</p>
                </Room>
            }
            else if (slots.Count > 0)
            {
                @if (bonusFeatCount > 0)
                {
                    <Message Kind="MessageKind.Info">
                        <p class="text-sm">
                            As a <strong>@raceName</strong>, you take <strong>@bonusFeatCount</strong>
                            @(bonusFeatCategory == null ? string.Empty : bonusFeatCategory + " ")feat(s) of your choice.
                        </p>
                    </Message>
                }

                @if (asiCount > 0)
                {
                    <Message Kind="MessageKind.Info">
                        <p class="text-sm">
                            You have <strong>@asiCount</strong> Ability Score Improvement(s).
                            Each one can either raise your ability scores by <strong>2 points</strong>
                            (+2 to one score, or +1 to two different scores) or take a <strong>feat</strong> instead.
                        </p>
                    </Message>
                }

                @for (int i = 0; i < slots.Count; i++)
                {
                    var index = i;
                    var slot = slots[index];

                    <Room Title="@(slot.IsRaceFeat ? $"{raceName} Feat" : $"Improvement #{index + 1 - bonusFeatCount}")" data-testid="improvement">
                        @if (!slot.IsRaceFeat)
                        {
                            <div class="mb-4 flex flex-wrap gap-2">
                                <button type="button" class="chip" aria-pressed="@(slot.TakesFeat ? "false" : "true")" @onclick="() => SetMode(index, false)">Ability Scores</button>
                                <button type="button" class="chip" aria-pressed="@(slot.TakesFeat ? "true" : "false")" @onclick="() => SetMode(index, true)">Feat</button>
                            </div>
                        }

                        @if (!slot.TakesFeat)
                        {
                            <p class="mb-3 text-sm text-pencil">@GetPointsLeft(index) point(s) remaining</p>

                            <div class="grid grid-cols-2 gap-3 md:grid-cols-3">
                                @foreach (var ability in abilityScores)
                                {
                                    var currentVal = slot.Improvement.TryGetValue(ability.Key, out var v) ? v : 0;
                                    <div class="border-2 border-ink p-3 @(currentVal > 0 ? "bg-plum-tint" : "bg-room-highlight")">
                                        <p class="mb-2 text-sm font-medium">@ability.Value</p>
                                        <div class="flex items-center gap-2">
                                            <button type="button" class="btn-step" aria-label="@($"Lower {ability.Value}")"
                                                    @onclick="() => DecrementAbility(index, ability.Key)" disabled="@(currentVal <= 0)">−</button>
                                            <span class="w-6 text-center font-display text-xl font-semibold">@currentVal</span>
                                            <button type="button" class="btn-step" aria-label="@($"Raise {ability.Value}")"
                                                    @onclick="() => IncrementAbility(index, ability.Key)" disabled="@(GetPointsLeft(index) <= 0 || currentVal >= 2)">+</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <input type="search" placeholder="Search feats..." aria-label="Search feats" class="field mb-4"
                                   value="@slot.FeatSearch" @oninput="e => SetFeatSearch(index, e.Value?.ToString())" />

                            <div class="step-columns">
                                <div class="max-h-[28rem] min-w-0 overflow-y-auto p-1">
                                    <div class="option-grid">
                                        @foreach (var feat in FilteredFeats(index))
                                        {
                                            var featId = feat.Id;
                                            <OptionRoom Name="@feat.Name" Picked="@(slot.FeatId == featId)" OnClick="() => SelectFeat(index, featId)">
                                                @if (feat.Category != null)
                                                {
                                                    <span>@feat.Category</span>
                                                }
                                                @if (feat.AbilityIncrease is { } increase)
                                                {
                                                    <span>@IncreaseText(increase)</span>
                                                }
                                                @if (feat.Prerequisites.Any())
                                                {
                                                    <span>Requires: @string.Join(", ", feat.Prerequisites)</span>
                                                }
                                            </OptionRoom>
                                        }
                                    </div>

                                    @if (!FilteredFeats(index).Any())
                                    {
                                        <p class="py-4 text-center text-sm text-pencil">No feats match that search.</p>
                                    }
                                </div>

                                @if (SelectedFeat(slot) is { } shownFeat)
                                {
                                    <KeyPanel Name="@shownFeat.Name">
                                        <ChildContent>
                                            @if (shownFeat.Category != null)
                                            {
                                                <KeyFact Label="Category">@shownFeat.Category</KeyFact>
                                            }
                                            <KeyFact Label="Requires">@(shownFeat.Prerequisites.Any() ? string.Join(", ", shownFeat.Prerequisites) : "None")</KeyFact>
                                            <KeyFact Label="Raises">@(shownFeat.AbilityIncrease is { } raises ? IncreaseText(raises) : "Nothing")</KeyFact>
                                        </ChildContent>
                                        <Note>@shownFeat.Description</Note>
                                    </KeyPanel>
                                }
                            </div>

                            @* Athlete raises Strength or Dexterity: the player says which *@
                            @if (SelectedFeat(slot) is { AbilityIncrease: { Options.Count: > 1 } choice } chosenFeat)
                            {
                                <label class="mt-4 block text-sm font-medium">
                                    @chosenFeat.Name raises by @choice.Points
                                    <select class="field mt-1" value="@slot.FeatAbility" @onchange="e => slot.FeatAbility = e.Value?.ToString()">
                                        <option value="">Choose...</option>
                                        @foreach (var ability in choice.Options)
                                        {
                                            <option value="@ability">@AbilityNames.Of(ability)</option>
                                        }
                                    </select>
                                </label>
                            }

                            @* Keen Mind's skill, Skilled's three skills or tools *@
                            @if (SelectedFeat(slot) is { Choice: { } featChoice } && AsksForProficiencies(featChoice))
                            {
                                @ProficiencySelects(featChoice, slot.ProficiencyPicks)
                            }
                        }
                    </Room>
                }
            }
        </div>
    }

    <StepNavigation OnBack="HandleBack" OnNext="HandleNext" NextDisabled="@(!CanProceed() || IsSaving)"
                    NextText="@(IsSaving ? "Saving..." : NextLabel)" />
</div>
@code {
    [Parameter] public int CharacterLevel { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    /// <summary>
    /// One earned ability score improvement, spent either on ability points or on a feat, or a
    /// feat the race gives (a variant human's), which is a feat and nothing else.
    /// </summary>
    private sealed class AsiSlot
    {
        public bool IsRaceFeat { get; init; }
        public bool TakesFeat { get; set; }
        public Dictionary<string, int> Improvement { get; } = [];
        public string? FeatId { get; set; }

        /// <summary>The ability the feat raises where it offers several: Athlete's Strength or Dexterity.</summary>
        public string? FeatAbility { get; set; }

        /// <summary>The skills or tools picked for a feat that asks for them, one entry per pick it gives.</summary>
        public List<string?> ProficiencyPicks { get; set; } = [];

        public string FeatSearch { get; set; } = string.Empty;
    }

    // The 2024 rules make raising ability scores a feat of this name. The "Ability Scores" mode
    // is that feat, and taking it from the list would add no points, so it is not listed.
    private const string AbilityScoreImprovementFeat = "Ability Score Improvement";

    private static readonly Dictionary<string, string> abilityScores = new()
    {
        ["strength"] = "Strength",
        ["dexterity"] = "Dexterity",
        ["constitution"] = "Constitution",
        ["intelligence"] = "Intelligence",
        ["wisdom"] = "Wisdom",
        ["charisma"] = "Charisma"
    };

    private List<int> asiLevels = [];
    private int asiCount;

    // The feats the race gives: a variant human's any one, a 2024 human's Origin one
    private int bonusFeatCount;
    private string? bonusFeatCategory;
    private string? raceName;

    private List<AsiSlot> slots = [];
    private List<FeatApiResponse> feats = [];

    // The class's Fighting Style features: how many, and the styles it offers
    private int fightingStylesOwed;
    private List<FeatApiResponse> fightingStyleOptions = [];
    private List<string?> chosenStyles = [];

    // The background's feat when it asks for skills or tools (a Noble's Skilled), and its picks
    private FeatApiResponse? backgroundFeat;
    private List<string?> backgroundFeatPicks = [];

    // Proficiency names by id, and what the race, background and class steps already gave or picked
    private Dictionary<string, string> proficiencyNames = [];
    private HashSet<string> proficienciesHeld = [];

    protected override Task OnInitializedAsync() => LoadAsync(LoadImprovementsAsync, "Failed to load ASI data");

    private async Task LoadImprovementsAsync()
    {
        var draft = await DraftService.GetDraftDetailsAsync(DraftId);
        if (draft == null) { ErrorMessage = "Draft not found."; return; }

        if (string.IsNullOrEmpty(draft.ClassId)) { ErrorMessage = "No class selected."; return; }

        var selectedClass = await LookupService.GetClassByIdAsync(draft.ClassId);
        if (selectedClass == null) { ErrorMessage = "Class not found."; return; }

        asiLevels = selectedClass.AsiLevels;
        asiCount = asiLevels.Count(l => l <= CharacterLevel);

        var race = string.IsNullOrEmpty(draft.RaceId)
            ? null
            : (await LookupService.GetRacesAsync(draft.Edition)).FirstOrDefault(r => r.Id == draft.RaceId);
        var subrace = race?.Subraces.FirstOrDefault(s => s.Id == draft.SubraceId);

        // A variant human's feat comes with the subrace, a 2024 human's with the species
        raceName = subrace?.Name ?? race?.Name;
        (bonusFeatCount, bonusFeatCategory) = subrace is { FeatChoiceCount: > 0 }
            ? ((race?.FeatChoiceCount ?? 0) + subrace.FeatChoiceCount, subrace.FeatChoiceCategory)
            : (race?.FeatChoiceCount ?? 0, race?.FeatChoiceCategory);

        var background = string.IsNullOrEmpty(draft.BackgroundId) ? null : await LookupService.GetBackgroundByIdAsync(draft.BackgroundId);
        var editionFeats = await LookupService.GetFeatsAsync(draft.Edition, draft.AllowedSources);

        // The feat picked for the background (a Mist Wanderer's Dark Gift, or a Haunted One's in
        // place of Survivor), or else its own
        var backgroundFeatId = background == null ? null : BackgroundFeats.FeatIdWith(background, draft.BackgroundFeatId);

        // Only the feats of the character's rules edition and books, less one the background
        // already gave (a 2024 criminal's Alert) unless it can be taken again
        if (asiCount + bonusFeatCount > 0)
        {
            var nonRepeatableBackgroundFeat = background?.Feat is { IsRepeatable: false } feat && feat.Id == backgroundFeatId ? feat.Id : null;

            feats = editionFeats
                .Where(f => f.Name != AbilityScoreImprovementFeat && f.Id != nonRepeatableBackgroundFeat && f.CanBeTakenForImprovement)
                .ToList();
        }

        backgroundFeat = editionFeats.FirstOrDefault(f => f.Id == backgroundFeatId && f.Choice is { } choice && AsksForProficiencies(choice));

        proficiencyNames = (await LookupService.GetProficienciesAsync()).ToDictionary(p => p.Id, p => p.Name);
        proficienciesHeld =
        [
            .. background?.Proficiencies.Select(p => p.Id) ?? [],
            .. draft.SelectedRaceSkillIds ?? [],
            .. draft.SelectedClassProficiencyIds ?? [],
            .. (draft.ToolPicks ?? []).SelectMany(pick => pick),
        ];

        slots = RestoreSlots(draft);
        RestoreProficiencyPicks(draft);

        var fightingStyles = await DraftService.GetFightingStylesAsync(DraftId);
        fightingStylesOwed = fightingStyles.Owed;
        fightingStyleOptions = fightingStyles.Options;
        chosenStyles = Enumerable.Range(0, fightingStylesOwed)
            .Select(i => i < draft.FightingStyleIds.Count ? draft.FightingStyleIds[i] : null)
            .ToList();
    }

    /// <summary>
    /// Rebuilds the slots from what was saved. The draft stores the race's feats first among the
    /// feats, then improvements and feats as two lists without recording which slot each came
    /// from, so improvements are restored first and feats fill the slots after them.
    /// </summary>
    private List<AsiSlot> RestoreSlots(CharacterDraftDetailsApiResponse draft)
    {
        var featIds = draft.SelectedFeatIds ?? [];
        var increases = draft.FeatAbilityIncreases ?? [];
        var saved = new List<AsiSlot>();

        for (var i = 0; i < Math.Min(bonusFeatCount, featIds.Count); i++)
        {
            saved.Add(FeatSlot(featIds[i], increases.ElementAtOrDefault(i), isRaceFeat: true));
        }

        foreach (var improvement in draft.AbilityScoreImprovements ?? [])
        {
            var slot = new AsiSlot();

            foreach (var entry in improvement)
            {
                slot.Improvement[entry.Key] = entry.Value;
            }

            saved.Add(slot);
        }

        for (var i = bonusFeatCount; i < featIds.Count; i++)
        {
            saved.Add(FeatSlot(featIds[i], increases.ElementAtOrDefault(i), isRaceFeat: false));
        }

        // Only trust the restored slots if they still fit what this character has earned. A
        // level-up's new improvement comes after the ones already taken, which stay as they were.
        var taken = saved.Count(s => !s.IsRaceFeat);

        if (saved.Count(s => s.IsRaceFeat) == bonusFeatCount && taken <= asiCount)
        {
            return [.. saved, .. Enumerable.Range(0, asiCount - taken).Select(_ => new AsiSlot())];
        }

        return
        [
            .. Enumerable.Range(0, bonusFeatCount).Select(_ => new AsiSlot { IsRaceFeat = true, TakesFeat = true }),
            .. Enumerable.Range(0, asiCount).Select(_ => new AsiSlot()),
        ];
    }

    // A saved feat and the ability it raises, the one key of what was saved ({"DEX": 1})
    private static AsiSlot FeatSlot(string featId, Dictionary<string, int>? increase, bool isRaceFeat) => new()
    {
        IsRaceFeat = isRaceFeat,
        TakesFeat = true,
        FeatId = featId,
        FeatAbility = increase?.FirstOrDefault(kvp => kvp.Value > 0).Key,
    };

    /// <summary>
    /// Puts the saved skill and tool picks back, one per feat that asks, in the order the API keeps
    /// them: the background's feat, then the feats in slot order. A pick for another feat is dropped.
    /// </summary>
    private void RestoreProficiencyPicks(CharacterDraftDetailsApiResponse draft)
    {
        var saved = new Queue<FeatProficiencyPickApiModel>(draft.FeatProficiencyPicks ?? []);

        if (backgroundFeat is { Choice: { } backgroundChoice })
        {
            backgroundFeatPicks = RestoredPicks(backgroundFeat.Id, backgroundChoice, saved);
        }

        foreach (var slot in slots.Where(s => s.TakesFeat))
        {
            if (SelectedFeat(slot) is { Choice: { } choice } feat && AsksForProficiencies(choice))
            {
                slot.ProficiencyPicks = RestoredPicks(feat.Id, choice, saved);
            }
        }
    }

    private static List<string?> RestoredPicks(string featId, FeatChoiceApiResponse choice, Queue<FeatProficiencyPickApiModel> saved)
    {
        var ids = saved.TryPeek(out var next) && next.FeatId == featId ? saved.Dequeue().ProficiencyIds : [];
        return Enumerable.Range(0, choice.Count).Select(i => ids.ElementAtOrDefault(i)).ToList();
    }

    private static bool AsksForProficiencies(FeatChoiceApiResponse choice) => choice.Type is FeatChoiceApiResponse.Skills or FeatChoiceApiResponse.SkillsTools;

    // One select per pick the feat gives, each leaving out what another pick or step already has
    private RenderFragment ProficiencySelects(FeatChoiceApiResponse choice, List<string?> picks) => __builder =>
    {
        <p class="mb-2 mt-4 text-sm text-pencil">
            Pick @choice.Count @(choice.Type == FeatChoiceApiResponse.SkillsTools ? "skill(s) or tool(s)" : "skill(s)")
        </p>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
            @for (var p = 0; p < picks.Count; p++)
            {
                var pickIndex = p;
                <select class="field" aria-label="@($"Pick {pickIndex + 1}")"
                        value="@picks[pickIndex]" @onchange="e => picks[pickIndex] = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                    <option value="">Choose...</option>
                    @foreach (var option in OptionsFor(choice, picks[pickIndex]))
                    {
                        <option value="@option">@proficiencyNames.GetValueOrDefault(option, option)</option>
                    }
                </select>
            }
        </div>
    };

    // A feat's options less what the character has from elsewhere or picked in another select
    private IEnumerable<string> OptionsFor(FeatChoiceApiResponse choice, string? current)
    {
        var taken = AllProficiencyPicks().Where(id => id != current).ToHashSet();

        return choice.Options
            .Where(id => id == current || (!taken.Contains(id) && !proficienciesHeld.Contains(id)))
            .OrderBy(id => proficiencyNames.GetValueOrDefault(id, id));
    }

    private IEnumerable<string> AllProficiencyPicks() =>
        backgroundFeatPicks
            .Concat(slots.Where(s => s.TakesFeat).SelectMany(s => s.ProficiencyPicks))
            .OfType<string>();

    // The picks for a feat just chosen: as many empty ones as it gives, or none
    private List<string?> EmptyPicksFor(string? featId) =>
        feats.FirstOrDefault(f => f.Id == featId)?.Choice is { } choice && AsksForProficiencies(choice)
            ? Enumerable.Repeat<string?>(null, choice.Count).ToList()
            : [];

    // A race's feat may be of one category only: a 2024 human's is an Origin feat
    private IEnumerable<FeatApiResponse> FilteredFeats(int index)
    {
        var slot = slots[index];

        return feats
            .Where(f => !slot.IsRaceFeat || bonusFeatCategory == null || f.Category == bonusFeatCategory)
            .Where(f => string.IsNullOrWhiteSpace(slot.FeatSearch) || f.Name.Contains(slot.FeatSearch, StringComparison.OrdinalIgnoreCase))
            .OrderBy(f => f.Name);
    }

    private FeatApiResponse? SelectedFeat(AsiSlot slot) => feats.FirstOrDefault(f => f.Id == slot.FeatId);

    // "+1 Strength or Dexterity", "+1 to any ability, up to 30" for an Epic Boon
    private static string IncreaseText(FeatAbilityIncreaseApiResponse increase)
    {
        var abilities = increase.Options.Count == 6
            ? "to any ability"
            : string.Join(" or ", increase.Options.Select(AbilityNames.Of));

        return $"+{increase.Points} {abilities}{(increase.Maximum > 20 ? $", up to {increase.Maximum}" : string.Empty)}";
    }

    private void SetMode(int index, bool takesFeat)
    {
        var slot = slots[index];

        if (slot.TakesFeat == takesFeat)
        {
            return;
        }

        slot.TakesFeat = takesFeat;

        // Clear whichever choice no longer applies so a half-finished one cannot be submitted
        if (takesFeat)
        {
            slot.Improvement.Clear();
        }
        else
        {
            slot.FeatId = null;
            slot.FeatAbility = null;
            slot.ProficiencyPicks = [];
        }
    }

    private void SelectFeat(int index, string featId)
    {
        slots[index].FeatId = slots[index].FeatId == featId ? null : featId;
        slots[index].FeatAbility = null;
        slots[index].ProficiencyPicks = EmptyPicksFor(slots[index].FeatId);
    }

    private void SetFeatSearch(int index, string? search)
    {
        slots[index].FeatSearch = search ?? string.Empty;
    }

    private int GetPointsLeft(int index) => 2 - slots[index].Improvement.Values.Sum();

    private void IncrementAbility(int index, string ability)
    {
        if (GetPointsLeft(index) <= 0) return;
        var current = slots[index].Improvement.TryGetValue(ability, out var v) ? v : 0;
        if (current >= 2) return;
        slots[index].Improvement[ability] = current + 1;
    }

    private void DecrementAbility(int index, string ability)
    {
        if (!slots[index].Improvement.TryGetValue(ability, out var current) || current <= 0) return;
        if (current == 1)
            slots[index].Improvement.Remove(ability);
        else
            slots[index].Improvement[ability] = current - 1;
    }

    private bool CanProceed() =>
        chosenStyles.All(id => !string.IsNullOrEmpty(id))
        && backgroundFeatPicks.All(id => !string.IsNullOrEmpty(id))
        && slots.All(slot => slot.TakesFeat
            ? !string.IsNullOrEmpty(slot.FeatId) && HasAbilityPick(slot) && slot.ProficiencyPicks.All(id => !string.IsNullOrEmpty(id))
            : slot.Improvement.Values.Sum() == 2);

    // A feat raising one of several abilities needs the pick; one raising a fixed ability does not
    private bool HasAbilityPick(AsiSlot slot) =>
        SelectedFeat(slot)?.AbilityIncrease is not { Options.Count: > 1 } increase
        || (!string.IsNullOrEmpty(slot.FeatAbility) && increase.Options.Contains(slot.FeatAbility));

    // What the feat raises as picked; the API knows a fixed increase (Actor's Charisma) on its own
    private Dictionary<string, int> FeatIncrease(AsiSlot slot) =>
        SelectedFeat(slot)?.AbilityIncrease is { Options.Count: > 1 } increase && !string.IsNullOrEmpty(slot.FeatAbility)
            ? new Dictionary<string, int> { [slot.FeatAbility] = increase.Points }
            : [];


    private static string Truncate(string text) =>
        text.Length <= 160 ? text : string.Concat(text.AsSpan(0, 160), "...");

    private async Task HandleNext()
    {
        if (!CanProceed()) return;

        var improvements = slots
            .Where(s => !s.TakesFeat)
            .Select(s => new Dictionary<string, int>(s.Improvement))
            .ToList();

        // The race's feats first (they are the first slots), then the improvements' in order
        var featSlots = slots
            .Where(s => s.TakesFeat && !string.IsNullOrEmpty(s.FeatId))
            .ToList();

        var featIds = featSlots.Select(s => s.FeatId!).ToList();
        var featAbilityIncreases = featSlots.Select(FeatIncrease).ToList();

        // The background's feat first, then each feat that asks, in the order of the feats
        var proficiencyPicks = new List<FeatProficiencyPickApiModel>();

        if (backgroundFeat is not null)
        {
            proficiencyPicks.Add(new FeatProficiencyPickApiModel { FeatId = backgroundFeat.Id, ProficiencyIds = [.. backgroundFeatPicks.OfType<string>()] });
        }

        proficiencyPicks.AddRange(featSlots
            .Where(s => s.ProficiencyPicks.Count > 0)
            .Select(s => new FeatProficiencyPickApiModel { FeatId = s.FeatId!, ProficiencyIds = [.. s.ProficiencyPicks.OfType<string>()] }));

        var styleIds = chosenStyles.OfType<string>().ToList();

        // The improvements first: the styles are checked against the feats they take
        if (await SaveAsync(
                async () =>
                {
                    await DraftService.SetAbilityScoreImprovementsAsync(DraftId, improvements, featIds, featAbilityIncreases, proficiencyPicks);

                    if (fightingStylesOwed > 0)
                    {
                        await DraftService.ChooseFightingStylesAsync(DraftId, styleIds);
                    }
                },
                "Failed to save improvements"))
        {
            await OnNext.InvokeAsync();
        }
    }

    private async Task HandleBack()
    {
        await OnBack.InvokeAsync();
    }
}
