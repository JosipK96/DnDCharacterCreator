@page "/admin/reset-link"
@attribute [Authorize]
@inject PasswordService PasswordService

<PageTitle>Password reset link - D&D Character Creator</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gray-900 py-12 px-4">
    <div class="max-w-md w-full space-y-6 bg-gray-800 p-8 rounded-lg shadow-xl">
        <h2 class="text-center text-3xl font-bold text-white">Password reset link</h2>
        <p class="text-sm text-gray-400">
            For the owner. Enter the email of the player who forgot their password, then send them the link.
            It works once and expires after 24 hours.
        </p>

        @if (errorMessage is not null)
        {
            <div role="alert" class="bg-red-900 border border-red-700 text-red-200 px-4 py-3 rounded">@errorMessage</div>
        }

        <form @onsubmit="Submit" class="space-y-4">
            <div>
                <label for="player-email" class="block text-sm font-medium text-gray-300 mb-2">Player's email</label>
                <input id="player-email" type="email" @bind="email"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <button type="submit" disabled="@isLoading" class="w-full py-3 px-4 rounded-lg text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50">
                Create link
            </button>
        </form>

        @if (link is not null)
        {
            <div>
                <label for="reset-link" class="block text-sm font-medium text-gray-300 mb-2">Send this link</label>
                <input id="reset-link" type="text" readonly value="@link"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white" />
            </div>
        }
    </div>
</div>

@code {
    private string email = "";
    private string? link;
    private string? errorMessage;
    private bool isLoading;

    private async Task Submit()
    {
        errorMessage = null;
        link = null;
        isLoading = true;

        try
        {
            link = await PasswordService.CreateResetLinkAsync(email.Trim());
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not reach the server. Check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
