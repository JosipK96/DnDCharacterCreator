@page "/admin/reset-link"
@attribute [Authorize]
@inject PasswordService PasswordService

<PageTitle>Password reset link - D&D Character Creator</PageTitle>

<div class="flex items-center justify-center py-12">
    <Room Class="w-full max-w-md space-y-6 p-8">
        <h1 class="step-title text-center">Password reset link</h1>
        <p class="text-sm text-pencil">
            For the owner. Enter the email of the player who forgot their password, then send them the link.
            It works once and expires after 24 hours.
        </p>

        @if (errorMessage is not null)
        {
            <Message Kind="MessageKind.Error">@errorMessage</Message>
        }

        <form @onsubmit="Submit" class="space-y-4">
            <div>
                <label for="player-email" class="block font-medium mb-1">Player's email</label>
                <input id="player-email" type="email" @bind="email"
                       class="field" />
            </div>
            <button type="submit" disabled="@isLoading" class="btn-main w-full">
                Create link
            </button>
        </form>

        @if (link is not null)
        {
            <div>
                <label for="reset-link" class="block font-medium mb-1">Send this link</label>
                <input id="reset-link" type="text" readonly value="@link"
                       class="field" />
            </div>
        }
    </Room>
</div>

@code {
    private string email = "";
    private string? link;
    private string? errorMessage;
    private bool isLoading;

    private async Task Submit()
    {
        errorMessage = null;
        link = null;
        isLoading = true;

        try
        {
            link = await PasswordService.CreateResetLinkAsync(email.Trim());
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not reach the server. Check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
