@page "/character/{id:guid}"
@attribute [Authorize]
@using CharacterCreatorApp.Contracts.Responses
@inject CharacterService CharacterService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="min-h-screen bg-gray-900 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
        @if (isLoading)
        {
            <!-- Loading State -->
            <div class="flex justify-center items-center py-20">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600"></div>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <!-- Error State -->
            <div class="bg-red-900 border border-red-700 text-red-200 px-6 py-4 rounded-lg">
                <p class="font-medium">Error loading character</p>
                <p class="text-sm mt-1">@errorMessage</p>
                <button @onclick="LoadCharacter"
                        class="mt-4 bg-red-800 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm">
                    Try Again
                </button>
            </div>
        }
        else if (character != null)
        {
            <!-- Header with Actions -->
            <div class="flex justify-between items-center mb-8">
                <button @onclick="BackToList"
                        class="text-gray-400 hover:text-white flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to Characters
                </button>

                <div class="flex space-x-3">
                    <button @onclick="() => ConfirmDelete(character)"
                            class="bg-red-900 hover:bg-red-800 text-white px-4 py-2 rounded-lg font-medium transition-colors duration-200">
                        Delete Character
                    </button>
                </div>
            </div>

            <!-- Character Header -->
            <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-t-lg px-8 py-6">
                <h1 class="text-4xl font-bold text-white mb-2">@character.Name</h1>
                <p class="text-xl text-indigo-100">
                    Level @character.Level @character.ClassName@(character.SubclassName != null ? $" ({character.SubclassName})" : "")
                </p>
                <p class="text-indigo-200 mt-1">
                    @character.RaceName@(character.SubraceName != null ? $" ({character.SubraceName})" : "") • @character.Size • @character.BackgroundName • @character.Edition rules
                </p>
            </div>

            <!-- Character Sheet Content -->
            <div class="bg-gray-800 rounded-b-lg shadow-xl p-8 space-y-8">

                @if (character.Stats is { } stats)
                {
                    <!-- Combat -->
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-4">Combat</h2>
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                            <div class="bg-gray-700 rounded-lg p-4 text-center">
                                <div class="text-gray-400 text-sm font-medium mb-1">Hit Points</div>
                                <div class="text-3xl font-bold text-white">@stats.MaxHitPoints</div>
                            </div>
                            <div class="bg-gray-700 rounded-lg p-4 text-center">
                                <div class="text-gray-400 text-sm font-medium mb-1">Armor Class</div>
                                <div class="text-3xl font-bold text-white">@stats.ArmorClass</div>
                            </div>
                            <div class="bg-gray-700 rounded-lg p-4 text-center">
                                <div class="text-gray-400 text-sm font-medium mb-1">Initiative</div>
                                <div class="text-3xl font-bold text-white">@Signed(stats.Initiative)</div>
                            </div>
                            <div class="bg-gray-700 rounded-lg p-4 text-center">
                                <div class="text-gray-400 text-sm font-medium mb-1">Speed</div>
                                <div class="text-3xl font-bold text-white">@stats.Speed<span class="text-base text-gray-400"> ft</span></div>
                            </div>
                            <div class="bg-gray-700 rounded-lg p-4 text-center">
                                <div class="text-gray-400 text-sm font-medium mb-1">Hit Dice</div>
                                <div class="text-3xl font-bold text-white">@stats.HitDice</div>
                            </div>
                            <div class="bg-gray-700 rounded-lg p-4 text-center">
                                <div class="text-gray-400 text-sm font-medium mb-1">Prof. Bonus</div>
                                <div class="text-3xl font-bold text-indigo-400">@Signed(stats.ProficiencyBonus)</div>
                            </div>
                        </div>
                        <p class="text-gray-500 text-sm mt-2">
                            Armor class is unarmoured (10 + DEX) — equipment is not tracked yet.
                        </p>
                    </div>

                    <!-- Ability Scores -->
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-4">Ability Scores</h2>
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                            @foreach (var ability in stats.Abilities)
                            {
                                <div class="bg-gray-700 rounded-lg p-4 text-center">
                                    <div class="text-gray-400 text-sm font-medium mb-1">@ability.AbilityId</div>
                                    <div class="text-3xl font-bold text-white">@ability.Score</div>
                                    <div class="text-indigo-400 text-lg">@Signed(ability.Modifier)</div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Saving Throws -->
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-4">Saving Throws</h2>
                        <div class="bg-gray-700 rounded-lg p-6 grid grid-cols-2 md:grid-cols-3 gap-3">
                            @foreach (var save in stats.SavingThrows)
                            {
                                <div class="flex items-center justify-between bg-gray-600 rounded px-3 py-2">
                                    <span class="flex items-center gap-2">
                                        <span class="@ProficiencyDotClass(save.IsProficient)"></span>
                                        <span class="text-gray-200">@save.AbilityId</span>
                                    </span>
                                    <span class="text-white font-bold">@Signed(save.Modifier)</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Skills -->
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-4">Skills</h2>
                        <div class="bg-gray-700 rounded-lg p-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                                @foreach (var skill in stats.Skills)
                                {
                                    <div class="flex items-center justify-between bg-gray-600 rounded px-3 py-2">
                                        <span class="flex items-center gap-2">
                                            <span class="@ProficiencyDotClass(skill.IsProficient)"></span>
                                            <span class="text-gray-200">@skill.Name</span>
                                            <span class="text-gray-400 text-xs">(@skill.AbilityId)</span>
                                        </span>
                                        <span class="text-white font-bold">@Signed(skill.Modifier)</span>
                                    </div>
                                }
                            </div>
                            <p class="text-gray-400 text-sm mt-4">
                                Passive Perception <span class="text-white font-bold">@stats.PassivePerception</span>
                            </p>
                        </div>
                    </div>
                }

                <!-- Proficiencies -->
                @if (character.Proficiencies.Any())
                {
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-4">Proficiencies</h2>
                        <div class="bg-gray-700 rounded-lg p-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                                @foreach (var proficiency in character.Proficiencies.OrderBy(p => p.Name))
                                {
                                    <div class="flex items-center space-x-2">
                                        <svg class="w-4 h-4 text-indigo-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                        </svg>
                                        <span class="text-gray-300">@proficiency.Name</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Languages -->
                @if (character.Languages.Any())
                {
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-4">Languages</h2>
                        <div class="bg-gray-700 rounded-lg p-6">
                            <div class="flex flex-wrap gap-2">
                                @foreach (var language in character.Languages.OrderBy(l => l.Name))
                                {
                                    <span class="bg-green-900 text-green-200 px-3 py-1 rounded-full text-sm">
                                        @language.Name
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Features -->
                @if (character.Features.Any())
                {
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-4">Features & Traits</h2>
                        <div class="bg-gray-700 rounded-lg p-6 space-y-2">
                            @foreach (var feature in character.Features.OrderBy(f => f.Name))
                            {
                                <div class="flex items-start space-x-2">
                                    <svg class="w-5 h-5 mt-0.5 text-purple-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    <span class="text-gray-300">@feature.Name</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Feats -->
                @if (character.Feats.Any())
                {
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-4">Feats</h2>
                        <div class="bg-gray-700 rounded-lg p-6 space-y-4">
                            @* One entry per feat taken: a repeatable feat taken twice shows twice, each with its own spells *@
                            @foreach (var entry in character.Feats.OrderBy(f => f.Feat.Name))
                            {
                                <div>
                                    <p class="text-white font-medium mb-1">
                                        @entry.Feat.Name
                                        @if (entry.Feat.Category != null)
                                        {
                                            <span class="ml-2 bg-gray-500 text-gray-100 px-2 py-0.5 rounded text-xs font-normal">@entry.Feat.Category</span>
                                        }
                                    </p>
                                    <p class="text-gray-300 text-sm">@entry.Feat.Description</p>
                                    @if (entry.Spells.Count > 0)
                                    {
                                        <p class="text-gray-400 text-sm mt-1">Spells: @string.Join(", ", entry.Spells.Select(s => s.Name))</p>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Spells -->
                @if (character.Spells.Any())
                {
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-4">Spells Known</h2>
                        <div class="bg-gray-700 rounded-lg p-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                @foreach (var spell in character.Spells.OrderBy(s => s.Name))
                                {
                                    <div class="bg-gray-600 rounded-lg px-4 py-2 flex items-center space-x-2">
                                        <svg class="w-4 h-4 text-yellow-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                        </svg>
                                        <span class="text-gray-300">@spell.Name</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Delete Confirmation Modal -->
        @if (characterToDelete != null)
        {
            <div class="fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 px-4">
                <div class="bg-gray-800 rounded-lg shadow-2xl max-w-md w-full p-6">
                    <h3 class="text-xl font-bold text-white mb-4">Delete Character?</h3>
                    <p class="text-gray-300 mb-6">
                        Are you sure you want to delete <span class="font-bold text-white">@characterToDelete.Name</span>?
                        This action cannot be undone.
                    </p>
                    <div class="flex justify-end space-x-3">
                        <button @onclick="CancelDelete"
                                class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg font-medium transition-colors duration-200">
                            Cancel
                        </button>
                        <button @onclick="DeleteCharacter"
                                disabled="@isDeleting"
                                class="bg-red-900 hover:bg-red-800 text-white px-4 py-2 rounded-lg font-medium transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
                            @(isDeleting ? "Deleting..." : "Delete")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CharacterDetailsApiResponse? character;
    private CharacterDetailsApiResponse? characterToDelete;
    private bool isLoading = true;
    private bool isDeleting = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCharacter();
    }

    private async Task LoadCharacter()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            character = await CharacterService.GetCharacterDetailsAsync(Id);

            if (character == null)
            {
                errorMessage = "Character not found";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/characters");
    }

    private void ConfirmDelete(CharacterDetailsApiResponse charDetails)
    {
        characterToDelete = charDetails;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        characterToDelete = null;
        StateHasChanged();
    }

    private async Task DeleteCharacter()
    {
        if (characterToDelete == null) return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            await CharacterService.DeleteCharacterAsync(characterToDelete.Id);
            Navigation.NavigateTo("/characters");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete character: {ex.Message}";
            characterToDelete = null;
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    // Helper methods
    private static string Signed(int value) => value >= 0 ? $"+{value}" : value.ToString();

    private static string ProficiencyDotClass(bool isProficient) => isProficient
        ? "w-2 h-2 rounded-full bg-indigo-400 flex-shrink-0"
        : "w-2 h-2 rounded-full border border-gray-400 flex-shrink-0";

}