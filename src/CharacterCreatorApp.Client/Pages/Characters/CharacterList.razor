@page "/characters"
@attribute [Authorize]
@using CharacterCreatorApp.Contracts.Responses
@using CharacterCreatorApp.Contracts.Common
@inject CharacterService CharacterService
@inject LookupService LookupService
@inject NavigationManager Navigation

<div class="min-h-screen bg-gray-900 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header Section with Create Button -->
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-white">My Characters</h1>
            <button @onclick="NavigateToCreateCharacter"
                    class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200 flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Create New Character
            </button>
        </div>

        <!-- Filters and Search Section -->
        <div class="bg-gray-800 rounded-lg shadow-xl p-6 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Search -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Search by Name</label>
                    <input type="text"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           placeholder="Search characters..."
                           class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-600 focus:border-transparent" />
                </div>

                <!-- Class Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Class</label>
                    <select @bind="classFilter"
                            class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-600 focus:border-transparent">
                        <option value="">All Classes</option>
                        @* Each class is there twice, once per rules edition *@
                        @foreach (var classOption in classes.OrderBy(c => c.Name).ThenBy(c => c.Edition))
                        {
                            <option value="@classOption.Id">@classOption.Name (@classOption.Edition)</option>
                        }
                    </select>
                </div>

                <!-- Sort By -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Sort By</label>
                    <select @bind="sortBy"
                            class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-600 focus:border-transparent">
                        <option value="createdat">Date Created</option>
                        <option value="name">Name</option>
                        <option value="level">Level</option>
                    </select>
                </div>

                <!-- Sort Order -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Sort Order</label>
                    <select @bind="sortOrder"
                            class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-600 focus:border-transparent">
                        <option value="desc">Newest First</option>
                        <option value="asc">Oldest First</option>
                    </select>
                </div>
            </div>

            <!-- Filter Actions -->
            <div class="flex justify-end space-x-3 mt-4">
                <button @onclick="ClearFilters"
                        class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200">
                    Clear Filters
                </button>
                <button @onclick="ApplyFilters"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200">
                    Apply Filters
                </button>
            </div>
        </div>

        <!-- Results Summary -->
        @if (filterResponse != null && !isLoading && filterResponse.TotalCount > 0)
        {
            <div class="text-gray-400 text-sm mb-4">
                Showing @GetFirstItemIndex()-@GetLastItemIndex() of @filterResponse.TotalCount characters
            </div>
        }

        @if (isLoading)
        {
            <!-- Loading State -->
            <div class="flex justify-center items-center py-20">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600"></div>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <!-- Error State -->
            <div class="bg-red-900 border border-red-700 text-red-200 px-6 py-4 rounded-lg">
                <p class="font-medium">Error loading characters</p>
                <p class="text-sm mt-1">@errorMessage</p>
                <button @onclick="LoadCharacters"
                        class="mt-4 bg-red-800 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm">
                    Try Again
                </button>
            </div>
        }
        else if (filterResponse == null || filterResponse.Items.Count == 0)
        {
            <!-- Empty State -->
            <div class="text-center py-20">
                <div class="mb-6">
                    <svg class="mx-auto h-24 w-24 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                <h3 class="text-xl font-medium text-gray-300 mb-2">
                    @(HasActiveFilters() ? "No characters match your filters" : "No characters yet")
                </h3>
                <p class="text-gray-400 mb-6">
                    @(HasActiveFilters() ? "Try adjusting your filters" : "Create your first D&D character to get started!")
                </p>
                @if (HasActiveFilters())
                {
                    <button @onclick="ClearFilters"
                            class="bg-gray-700 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200 inline-flex items-center">
                        Clear Filters
                    </button>
                }
                else
                {
                    <button @onclick="NavigateToCreateCharacter"
                            class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200 inline-flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Create Your First Character
                    </button>
                }
            </div>
        }
        else
        {
            <!-- Character Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                @foreach (var character in filterResponse.Items)
                {
                    <div class="bg-gray-800 rounded-lg shadow-xl overflow-hidden hover:shadow-2xl transition-shadow duration-200">
                        <!-- Character Card Header -->
                        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-6 py-4">
                            <h2 class="text-xl font-bold text-white truncate">@character.Name</h2>
                            <p class="text-indigo-100 text-sm">Level @character.Level · @character.Edition rules</p>
                        </div>

                        <!-- Character Card Body -->
                        <div class="px-6 py-4 space-y-3">
                            <!-- Race -->
                            <div class="flex items-center text-gray-300">
                                <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                                <span>
                                    @character.RaceName@(character.SubraceName != null ? $" ({character.SubraceName})" : "")
                                </span>
                            </div>

                            <!-- Class -->
                            <div class="flex items-center text-gray-300">
                                <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                </svg>
                                <span>
                                    @character.ClassName@(character.SubclassName != null ? $" ({character.SubclassName})" : "")
                                </span>
                            </div>

                            <!-- Background -->
                            <div class="flex items-center text-gray-300">
                                <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                                </svg>
                                <span>@character.BackgroundName</span>
                            </div>
                        </div>

                        <!-- Character Card Actions -->
                        <div class="px-6 py-4 bg-gray-750 border-t border-gray-700 flex justify-between">
                            <button @onclick="() => NavigateToCharacterDetails(character.Id)"
                                    class="flex-1 mr-2 bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200">
                                View Details
                            </button>
                            <button @onclick="() => EditCharacter(character.Id)"
                                    class="mr-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200">
                                Edit
                            </button>
                            @if (character.Level < CharacterLevels.Max)
                            {
                                <button @onclick="() => LevelUpCharacter(character.Id)"
                                        class="mr-2 bg-emerald-700 hover:bg-emerald-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200">
                                    Level Up
                                </button>
                            }
                            <button @onclick="() => ConfirmDelete(character)"
                                    class="bg-red-900 hover:bg-red-800 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200">
                                Delete
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination Controls -->
            @if (filterResponse.TotalPages > 1)
            {
                <div class="flex justify-center items-center space-x-2">
                    <!-- Previous Button -->
                    <button @onclick="PreviousPage"
                            disabled="@(!filterResponse.HasPreviousPage)"
                            class="px-4 py-2 bg-gray-800 text-white rounded-lg disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-700 transition-colors">
                        Previous
                    </button>

                    <!-- Page Numbers -->
                    @foreach (var pageNum in GetPageNumbers())
                    {
                        @if (pageNum == -1)
                        {
                            <span class="px-3 py-2 text-gray-400">...</span>
                        }
                        else
                        {
                            <button @onclick="() => GoToPage(pageNum)"
                                    class="@GetPageButtonClass(pageNum)">
                                @(pageNum + 1)
                            </button>
                        }
                    }

                    <!-- Next Button -->
                    <button @onclick="NextPage"
                            disabled="@(!filterResponse.HasNextPage)"
                            class="px-4 py-2 bg-gray-800 text-white rounded-lg disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-700 transition-colors">
                        Next
                    </button>
                </div>
            }
        }

        <!-- Delete Confirmation Modal -->
        @if (characterToDelete != null)
        {
            <div class="fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 px-4">
                <div class="bg-gray-800 rounded-lg shadow-2xl max-w-md w-full p-6">
                    <h3 class="text-xl font-bold text-white mb-4">Delete Character?</h3>
                    <p class="text-gray-300 mb-6">
                        Are you sure you want to delete <span class="font-bold text-white">@characterToDelete.Name</span>?
                        This action cannot be undone.
                    </p>
                    <div class="flex justify-end space-x-3">
                        <button @onclick="CancelDelete"
                                class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg font-medium transition-colors duration-200">
                            Cancel
                        </button>
                        <button @onclick="DeleteCharacter"
                                disabled="@isDeleting"
                                class="bg-red-900 hover:bg-red-800 text-white px-4 py-2 rounded-lg font-medium transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
                            @(isDeleting ? "Deleting..." : "Delete")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private FilterResponse<CharacterSummaryApiResponse>? filterResponse;
    private bool isLoading = true;
    private string? errorMessage;
    private CharacterSummaryApiResponse? characterToDelete;
    private bool isDeleting = false;

    // Filter/Search state
    private string? searchTerm = null;
    private string? classFilter = null;
    private string sortBy = "createdat";
    private string sortOrder = "desc";
    private int currentPageIndex = 0; // 0-based indexing
    private int pageSize = 12;

    // The wizard's class list rather than a copy of it; the copy had left out the Artificer
    private List<ClassApiResponse> classes = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadCharacters();

        try
        {
            classes = await LookupService.GetClassesAsync(edition: null);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // Without the list the filter offers only "All Classes"; the characters still show
        }
    }

    private async Task LoadCharacters()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            filterResponse = await CharacterService.GetMyCharactersAsync(
                currentPageIndex,
                pageSize,
                sortBy,
                sortOrder,
                classFilter,
                searchTerm);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        currentPageIndex = 0; // Reset to first page
        await LoadCharacters();
    }

    private async Task ClearFilters()
    {
        searchTerm = null;
        classFilter = null;
        sortBy = "createdat";
        sortOrder = "desc";
        currentPageIndex = 0;
        await LoadCharacters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrWhiteSpace(classFilter);
    }

    private async Task GoToPage(int pageIndex)
    {
        if (filterResponse == null || pageIndex < 0 || pageIndex >= filterResponse?.TotalPages)
        {
            return;
        }

        currentPageIndex = pageIndex;
        await LoadCharacters();
    }

    private async Task PreviousPage()
    {
        if (filterResponse?.HasPreviousPage == true)
        {
            await GoToPage(currentPageIndex - 1);
        }
    }

    private async Task NextPage()
    {
        if (filterResponse?.HasNextPage == true)
        {
            await GoToPage(currentPageIndex + 1);
        }
    }

    private List<int> GetPageNumbers()
    {
        if (filterResponse == null)
        {
            return new List<int>();
        }

        var pages = new List<int>();
        var totalPages = filterResponse.TotalPages;
        var currentPage = filterResponse.PageIndex;

        if (totalPages <= 7)
        {
            for (int i = 0; i < totalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            pages.Add(0); // First page

            if (currentPage > 2)
            {
                pages.Add(-1); // Ellipsis
            }

            for (int i = Math.Max(1, currentPage - 1); i <= Math.Min(totalPages - 2, currentPage + 1); i++)
            {
                pages.Add(i);
            }

            if (currentPage < totalPages - 3)
            {
                pages.Add(-1); // Ellipsis
            }

            pages.Add(totalPages - 1); // Last page
        }

        return pages;
    }

    private string GetPageButtonClass(int pageIndex)
    {
        if (filterResponse == null)
        {
            return "px-4 py-2 rounded-lg transition-colors font-medium bg-gray-800 text-gray-300 hover:bg-gray-700";
        }

        var baseClasses = "px-4 py-2 rounded-lg transition-colors font-medium";
        var activeClasses = "bg-indigo-600 text-white";
        var inactiveClasses = "bg-gray-800 text-gray-300 hover:bg-gray-700";

        return pageIndex == filterResponse?.PageIndex
            ? $"{baseClasses} {activeClasses}"
            : $"{baseClasses} {inactiveClasses}";
    }

    private int GetFirstItemIndex()
    {
        if (filterResponse == null || filterResponse.TotalCount == 0)
        {
            return 0;
        }

        return (filterResponse.PageIndex * filterResponse.PageSize) + 1;
    }

    private int GetLastItemIndex()
    {
        if (filterResponse == null || filterResponse.TotalCount == 0)
        {
            return 0;
        }

        return Math.Min((filterResponse.PageIndex + 1) * filterResponse.PageSize, filterResponse.TotalCount);
    }

    private void NavigateToCreateCharacter()
    {
        Navigation.NavigateTo("/character/create");
    }

    private void NavigateToCharacterDetails(Guid characterId)
    {
        Navigation.NavigateTo($"/character/{characterId}");
    }

    // The character opens in the wizard as a draft; saving it replaces the character
    private async Task EditCharacter(Guid characterId)
    {
        try
        {
            var draftId = await CharacterService.StartEditAsync(characterId);
            Navigation.NavigateTo($"/character/create/{draftId}");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            errorMessage = $"Failed to open the character for editing: {ex.Message}";
        }
    }

    // The character opens one level up in the wizard, which asks only what the new level brings
    private async Task LevelUpCharacter(Guid characterId)
    {
        try
        {
            var draftId = await CharacterService.StartLevelUpAsync(characterId);
            Navigation.NavigateTo($"/character/create/{draftId}");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            errorMessage = $"Failed to level the character up: {ex.Message}";
        }
    }

    private void ConfirmDelete(CharacterSummaryApiResponse character)
    {
        characterToDelete = character;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        characterToDelete = null;
        StateHasChanged();
    }

    private async Task DeleteCharacter()
    {
        if (characterToDelete == null)
        {
            return;
        }

        isDeleting = true;
        StateHasChanged();

        try
        {
            await CharacterService.DeleteCharacterAsync(characterToDelete.Id);
            await LoadCharacters();
            characterToDelete = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete character: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }
}