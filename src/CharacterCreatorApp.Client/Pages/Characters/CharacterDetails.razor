@page "/character/{id:guid}"
@attribute [Authorize]
@using CharacterCreatorApp.Client.Pages.CharacterCreation
@inject CharacterService CharacterService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* The sheet, laid out like the paper one: rooms in three columns on a wide screen, two on a
   tablet and one on a phone. Every number is the API's (CharacterStatsCalculator), shown as sent. *@
<div class="mx-auto max-w-6xl">
    @if (isLoading)
    {
        <Spinner />
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <Message Kind="MessageKind.Error">
            <p class="font-medium">Error loading character</p>
            <p class="mt-1 text-sm">@errorMessage</p>
            <button @onclick="LoadCharacter" class="btn-secondary mt-4">Try again</button>
        </Message>
    }
    else if (character != null)
    {
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <button type="button" @onclick="BackToList" class="link-back">Back to characters</button>

            <div class="flex flex-wrap gap-3">
                <div class="flex">
                    <button @onclick="DownloadPdf" disabled="@isDownloading" class="btn-secondary">
                        @(isDownloading ? "Preparing..." : "Download PDF")
                    </button>
                    <select @bind="paper" aria-label="Paper size"
                            class="border-2 border-l-0 border-ink bg-room-highlight px-2 text-ink">
                        <option value="a4">A4</option>
                        <option value="letter">Letter</option>
                    </select>
                </div>
                <CharacterActions CharacterId="character.Id" Name="@character.Name" Level="character.Level"
                                  OnDeleted="BackToList" />
            </div>
        </div>

        <div class="sheet-columns">
            <Room Class="sheet-wide">
                <h1 class="font-display text-[46px] font-semibold leading-none">@character.Name</h1>
                <p class="mt-2 text-[21px]">
                    Level @character.Level @character.ClassName@(character.SubclassName != null ? $" ({character.SubclassName})" : "")
                </p>
                <p class="mt-1 text-pencil">
                    @character.RaceName@(character.SubraceName != null ? $" ({character.SubraceName})" : "") · @character.Size · @character.BackgroundName · @character.Edition rules
                </p>
            </Room>

            @if (character.Stats is { } stats)
            {
                <div class="sheet-wide">
                    <h2 class="sr-only">Combat</h2>
                    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
                        <CombatNumber Label="Hit points" Value="@stats.MaxHitPoints.ToString()" />
                        <CombatNumber Label="Armor class" Value="@stats.ArmorClass.ToString()" />
                        <CombatNumber Label="Initiative" Value="@Signed(stats.Initiative)" />
                        <CombatNumber Label="Speed" Value="@stats.Speed.ToString()" Unit="ft" />
                        <CombatNumber Label="Hit dice" Value="@stats.HitDice" />
                        <CombatNumber Label="Proficiency bonus" Value="@Signed(stats.ProficiencyBonus)" IsPlum="true" />
                    </div>
                    <p class="mt-2 text-sm text-pencil">
                        Armor class is unarmoured: 10 + DEX, or the class's or subclass's own when higher (a
                        barbarian's, monk's or draconic sorcerer's) — equipment is not tracked yet.
                    </p>
                </div>

                <div class="sheet-stack">
                    <Room Title="Ability Scores">
                        <div class="grid grid-cols-2 gap-x-4 gap-y-2">
                            @foreach (var ability in stats.Abilities)
                            {
                                <div class="score-box" data-testid="ability" data-ability="@ability.AbilityId">
                                    <div class="text-sm text-pencil">@AbilityNames.Of(ability.AbilityId)</div>
                                    <div class="font-display text-[34px] font-semibold leading-tight">@ability.Score</div>
                                    <div class="modifier-tab" data-testid="modifier">@Signed(ability.Modifier)</div>
                                </div>
                            }
                        </div>
                    </Room>

                    <Room Title="Saving Throws">
                        <ul>
                            @foreach (var save in stats.SavingThrows)
                            {
                                <li class="sheet-row" data-testid="saving-throw">
                                    <span class="prof-dot" data-proficient="@Proficient(save.IsProficient)"></span>
                                    <span class="flex-1" data-testid="name">@AbilityNames.Of(save.AbilityId)</span>
                                    <span class="font-semibold tabular-nums">@Signed(save.Modifier)</span>
                                </li>
                            }
                        </ul>
                    </Room>
                </div>

                <div class="sheet-stack">
                    <Room Title="Skills">
                        <ul>
                            @foreach (var skill in stats.Skills)
                            {
                                <li class="sheet-row" data-testid="skill">
                                    <span class="prof-dot" data-proficient="@Proficient(skill.IsProficient)"></span>
                                    <span class="flex-1" data-testid="name">
                                        @skill.Name <span class="text-xs text-pencil">@skill.AbilityId</span>
                                    </span>
                                    <span class="font-semibold tabular-nums">@Signed(skill.Modifier)</span>
                                </li>
                            }
                        </ul>
                        <p class="mt-2 flex justify-between border-t-2 border-ink pt-2">
                            <span>Passive Perception</span>
                            <span class="font-semibold tabular-nums">@stats.PassivePerception</span>
                        </p>
                    </Room>
                </div>
            }

            <div class="sheet-stack">
                @if (character.Stats is { Spellcasting.Count: > 0 } castingStats)
                {
                    <Room Title="Spellcasting">
                        <SpellcastingPanel Spellcasting="castingStats.Spellcasting" />
                    </Room>
                }

                @if (character.Stats is { Attacks.Count: > 0 } attackStats)
                {
                    <Room Title="Attacks">
                        <AttacksTable Attacks="attackStats.Attacks" />
                    </Room>
                }

                @if (character.Stats is { } slotStats && (slotStats.SpellSlots.Count > 0 || slotStats.PactMagic != null))
                {
                    <Room Title="Spell Slots">
                        <SpellSlotsPanel Stats="slotStats" />
                    </Room>
                }

                @if (character.Spells.Any())
                {
                    <Room Title="Spells">
                        <ul>
                            @foreach (var spell in character.Spells.OrderBy(s => s.Level).ThenBy(s => s.Name))
                            {
                                <li class="sheet-row justify-between">
                                    <span>@spell.Name</span>
                                    <span class="text-sm text-pencil">@SpellLevel(spell.Level)</span>
                                </li>
                            }
                        </ul>
                    </Room>
                }

                @if (character.Proficiencies.Any())
                {
                    <Room Title="Proficiencies">
                        <ul>
                            @foreach (var proficiency in character.Proficiencies.OrderBy(p => p.Name))
                            {
                                <li class="sheet-row justify-between">
                                    <span>@proficiency.Name</span>
                                    <span class="text-sm text-pencil">@TypeLabel(proficiency.Type)</span>
                                </li>
                            }
                        </ul>
                    </Room>
                }

                @if (character.Languages.Any())
                {
                    <Room Title="Languages">
                        <ul>
                            @foreach (var language in character.Languages.OrderBy(l => l.Name))
                            {
                                <li class="sheet-row justify-between">
                                    <span>@language.Name</span>
                                    <span class="text-sm text-pencil">@TypeLabel(language.Type)</span>
                                </li>
                            }
                        </ul>
                    </Room>
                }
            </div>

            @if (character.Features.Any())
            {
                <Room Title="Features & Traits" Class="sheet-wide">
                    <ul class="grid gap-x-8 md:grid-cols-2 lg:grid-cols-3">
                        @foreach (var feature in character.Features.OrderBy(f => f.Name))
                        {
                            <li class="sheet-row">@feature.Name</li>
                        }
                    </ul>
                </Room>
            }

            @if (character.Feats.Any())
            {
                <Room Title="Feats" Class="sheet-wide">
                    <ul>
                        @* One entry per feat taken: a repeatable feat taken twice shows twice, each with its own spells *@
                        @foreach (var entry in character.Feats.OrderBy(f => f.Feat.Name))
                        {
                            <li class="sheet-row block py-2">
                                <p class="font-semibold">
                                    @entry.Feat.Name
                                    @if (entry.Feat.Category != null)
                                    {
                                        <span class="ml-2 text-sm font-normal text-pencil">@entry.Feat.Category</span>
                                    }
                                </p>
                                <p class="text-sm">@entry.Feat.Description</p>
                                @if (entry.Spells.Count > 0)
                                {
                                    <p class="mt-1 text-sm text-pencil">@AbilityNames.SpellsLabel(entry.SpellcastingAbilityId): @string.Join(", ", entry.Spells.Select(s => s.Name))</p>
                                }
                            </li>
                        }
                    </ul>
                </Room>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CharacterDetailsApiResponse? character;
    private bool isLoading = true;
    private bool isDownloading;
    private string paper = "a4";
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCharacter();
    }

    private async Task LoadCharacter()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            character = await CharacterService.GetCharacterDetailsAsync(Id);

            if (character == null)
            {
                errorMessage = "Character not found";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/characters");
    }

    // The API draws the sheet; the browser is handed the file to save, since the request needs the user's token
    private async Task DownloadPdf()
    {
        isDownloading = true;

        try
        {
            var file = await CharacterService.GetCharacterSheetPdfAsync(Id, paper);
            await JS.InvokeVoidAsync("saveFile", file.FileName, "application/pdf", file.Content);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            errorMessage = $"Failed to download the character sheet: {ex.Message}";
        }
        finally
        {
            isDownloading = false;
        }
    }

    private static string Signed(int value) => value >= 0 ? $"+{value}" : value.ToString();

    // Lower case, so the data attribute reads as the CSS and the tests expect it
    private static string Proficient(bool isProficient) => isProficient ? "true" : "false";

    // A proficiency's or language's type as the seed data spells it ("gaming_set"), for reading: "Gaming set"
    private static string TypeLabel(string type) =>
        string.IsNullOrEmpty(type) ? type : char.ToUpperInvariant(type[0]) + type[1..].Replace('_', ' ');

    private static string SpellLevel(int level) => level switch
    {
        0 => "Cantrip",
        1 => "1st level",
        2 => "2nd level",
        3 => "3rd level",
        _ => $"{level}th level"
    };
}
