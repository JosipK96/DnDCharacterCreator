@* The spell slots a character's stats give, for the sheet and the review step alike: a row per
   spell level, and a warlock's Pact Magic apart, since those come back on a short rest. The
   page shows it only for a character with slots of either kind, inside a room of its own. *@

<div class="space-y-3">
    @if (Stats.SpellSlots.Count > 0)
    {
        <div>
            <p class="mb-2 text-sm text-pencil">Spell slots, back on a long rest</p>
            <div class="grid grid-cols-3 gap-2 md:grid-cols-5 lg:grid-cols-9">
                @foreach (var slot in Stats.SpellSlots)
                {
                    <div class="border-2 border-ink bg-room-highlight px-3 py-2 text-center text-ink">
                        <div class="text-xs text-pencil">@Ordinal(slot.SpellLevel)</div>
                        <div class="font-display text-lg font-semibold">@slot.Slots</div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Stats.PactMagic is { } pactMagic)
    {
        <div>
            <p class="mb-2 text-sm text-pencil">Pact Magic, back on a short rest</p>
            <div class="inline-block border-2 border-ink bg-room-highlight px-3 py-2 text-ink">
                <span class="font-display text-lg font-semibold">@pactMagic.Slots</span>
                <span>@(pactMagic.Slots == 1 ? "slot" : "slots") of @Ordinal(pactMagic.SlotLevel) level</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CharacterStatsApiResponse Stats { get; set; } = null!;

    private static string Ordinal(int level) => level switch
    {
        1 => "1st",
        2 => "2nd",
        3 => "3rd",
        _ => $"{level}th"
    };
}
