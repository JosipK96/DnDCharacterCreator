@page "/characters"
@attribute [Authorize]
@using CharacterCreatorApp.Contracts.Common
@inject CharacterService CharacterService
@inject LookupService LookupService
@inject NavigationManager Navigation

@* The player's characters, each a room on the map, under the search, filter and sort controls *@
<div class="mx-auto max-w-7xl">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="page-title">My Characters</h1>
        <button @onclick="NavigateToCreateCharacter" class="btn-main">Create new character</button>
    </div>

    <Room Class="mb-6">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
            <div>
                <label for="character-search" class="mb-1 block text-sm font-medium">Search by name</label>
                <input id="character-search"
                       type="text"
                       @bind="searchTerm"
                       @bind:event="oninput"
                       placeholder="Search characters..."
                       class="field" />
            </div>

            <div>
                <label for="character-class" class="mb-1 block text-sm font-medium">Class</label>
                <select id="character-class" @bind="classFilter" class="field">
                    <option value="">All Classes</option>
                    @* Each class is there twice, once per rules edition *@
                    @foreach (var classOption in classes.OrderBy(c => c.Name).ThenBy(c => c.Edition))
                    {
                        <option value="@classOption.Id">@classOption.Name (@classOption.Edition)</option>
                    }
                </select>
            </div>

            <div>
                <label for="character-sort" class="mb-1 block text-sm font-medium">Sort by</label>
                <select id="character-sort" @bind="sortBy" class="field">
                    <option value="createdat">Date Created</option>
                    <option value="name">Name</option>
                    <option value="level">Level</option>
                </select>
            </div>

            <div>
                <label for="character-order" class="mb-1 block text-sm font-medium">Sort order</label>
                <select id="character-order" @bind="sortOrder" class="field">
                    <option value="desc">Newest First</option>
                    <option value="asc">Oldest First</option>
                </select>
            </div>
        </div>

        <div class="mt-4 flex flex-wrap justify-end gap-3">
            <button @onclick="ClearFilters" class="btn-secondary">Clear filters</button>
            <button @onclick="ApplyFilters" class="btn-main">Apply filters</button>
        </div>
    </Room>

    @if (filterResponse != null && !isLoading && filterResponse.TotalCount > 0)
    {
        <p class="mb-4 text-sm text-pencil">
            Showing @GetFirstItemIndex()-@GetLastItemIndex() of @filterResponse.TotalCount characters
        </p>
    }

    @if (isLoading)
    {
        <Spinner />
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <Message Kind="MessageKind.Error">
            <p class="font-medium">Error loading characters</p>
            <p class="mt-1 text-sm">@errorMessage</p>
            <button @onclick="LoadCharacters" class="btn-secondary mt-4">Try again</button>
        </Message>
    }
    else if (filterResponse == null || filterResponse.Items.Count == 0)
    {
        <Room Class="py-12 text-center" data-testid="no-characters">
            <h2 class="room-title mb-2">
                @(HasActiveFilters() ? "No characters match your filters" : "No characters yet")
            </h2>
            <p class="mb-6 text-pencil">
                @(HasActiveFilters() ? "Try adjusting your filters" : "Create your first D&D character to get started!")
            </p>
            @if (HasActiveFilters())
            {
                <button @onclick="ClearFilters" class="btn-secondary">Clear filters</button>
            }
            else
            {
                <button @onclick="NavigateToCreateCharacter" class="btn-main">Create your first character</button>
            }
        </Room>
    }
    else
    {
        <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var character in filterResponse.Items)
            {
                <Room Class="flex flex-col" data-testid="character">
                    <h2 class="room-title truncate">@character.Name</h2>
                    <p class="text-sm text-pencil">Level @character.Level · @character.Edition rules</p>

                    <dl class="mt-3 flex-1">
                        <div class="sheet-row justify-between">
                            <dt class="text-sm text-pencil">Race</dt>
                            <dd class="text-right">@character.RaceName@(character.SubraceName != null ? $" ({character.SubraceName})" : "")</dd>
                        </div>
                        <div class="sheet-row justify-between">
                            <dt class="text-sm text-pencil">Class</dt>
                            <dd class="text-right">@character.ClassName@(character.SubclassName != null ? $" ({character.SubclassName})" : "")</dd>
                        </div>
                        <div class="sheet-row justify-between">
                            <dt class="text-sm text-pencil">Background</dt>
                            <dd class="text-right">@character.BackgroundName</dd>
                        </div>
                    </dl>

                    <div class="mt-4 space-y-2">
                        <button @onclick="() => NavigateToCharacterDetails(character.Id)" class="btn-main w-full">
                            View details
                        </button>
                        <CharacterActions @key="character.Id" CharacterId="character.Id" Name="@character.Name"
                                          Level="character.Level" Compact="true" OnDeleted="LoadCharacters" />
                    </div>
                </Room>
            }
        </div>

        @if (filterResponse.TotalPages > 1)
        {
            <nav class="flex flex-wrap items-center justify-center gap-2" aria-label="Pages">
                <button @onclick="PreviousPage" disabled="@(!filterResponse.HasPreviousPage)" class="btn-secondary">
                    Previous
                </button>

                @foreach (var pageNum in GetPageNumbers())
                {
                    @if (pageNum == -1)
                    {
                        <span class="px-2 text-pencil">...</span>
                    }
                    else
                    {
                        <button @onclick="() => GoToPage(pageNum)"
                                class="pager"
                                aria-current="@(pageNum == filterResponse.PageIndex ? "page" : null)">
                            @(pageNum + 1)
                        </button>
                    }
                }

                <button @onclick="NextPage" disabled="@(!filterResponse.HasNextPage)" class="btn-secondary">
                    Next
                </button>
            </nav>
        }
    }
</div>

@code {
    private FilterResponse<CharacterSummaryApiResponse>? filterResponse;
    private bool isLoading = true;
    private string? errorMessage;

    // Filter/Search state
    private string? searchTerm = null;
    private string? classFilter = null;
    private string sortBy = "createdat";
    private string sortOrder = "desc";
    private int currentPageIndex = 0; // 0-based indexing
    private int pageSize = 12;

    // The wizard's class list rather than a copy of it; the copy had left out the Artificer
    private List<ClassApiResponse> classes = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadCharacters();

        try
        {
            classes = await LookupService.GetClassesAsync(edition: null);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // Without the list the filter offers only "All Classes"; the characters still show
        }
    }

    private async Task LoadCharacters()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            filterResponse = await CharacterService.GetMyCharactersAsync(
                currentPageIndex,
                pageSize,
                sortBy,
                sortOrder,
                classFilter,
                searchTerm);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        currentPageIndex = 0; // Reset to first page
        await LoadCharacters();
    }

    private async Task ClearFilters()
    {
        searchTerm = null;
        classFilter = null;
        sortBy = "createdat";
        sortOrder = "desc";
        currentPageIndex = 0;
        await LoadCharacters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrWhiteSpace(classFilter);
    }

    private async Task GoToPage(int pageIndex)
    {
        if (filterResponse == null || pageIndex < 0 || pageIndex >= filterResponse?.TotalPages)
        {
            return;
        }

        currentPageIndex = pageIndex;
        await LoadCharacters();
    }

    private async Task PreviousPage()
    {
        if (filterResponse?.HasPreviousPage == true)
        {
            await GoToPage(currentPageIndex - 1);
        }
    }

    private async Task NextPage()
    {
        if (filterResponse?.HasNextPage == true)
        {
            await GoToPage(currentPageIndex + 1);
        }
    }

    private List<int> GetPageNumbers()
    {
        if (filterResponse == null)
        {
            return new List<int>();
        }

        var pages = new List<int>();
        var totalPages = filterResponse.TotalPages;
        var currentPage = filterResponse.PageIndex;

        if (totalPages <= 7)
        {
            for (int i = 0; i < totalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            pages.Add(0); // First page

            if (currentPage > 2)
            {
                pages.Add(-1); // Ellipsis
            }

            for (int i = Math.Max(1, currentPage - 1); i <= Math.Min(totalPages - 2, currentPage + 1); i++)
            {
                pages.Add(i);
            }

            if (currentPage < totalPages - 3)
            {
                pages.Add(-1); // Ellipsis
            }

            pages.Add(totalPages - 1); // Last page
        }

        return pages;
    }


    private int GetFirstItemIndex()
    {
        if (filterResponse == null || filterResponse.TotalCount == 0)
        {
            return 0;
        }

        return (filterResponse.PageIndex * filterResponse.PageSize) + 1;
    }

    private int GetLastItemIndex()
    {
        if (filterResponse == null || filterResponse.TotalCount == 0)
        {
            return 0;
        }

        return Math.Min((filterResponse.PageIndex + 1) * filterResponse.PageSize, filterResponse.TotalCount);
    }

    private void NavigateToCreateCharacter()
    {
        Navigation.NavigateTo("/character/create");
    }

    private void NavigateToCharacterDetails(Guid characterId)
    {
        Navigation.NavigateTo($"/character/{characterId}");
    }
}
