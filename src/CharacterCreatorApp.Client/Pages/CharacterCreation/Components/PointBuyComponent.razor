<Room Title="Point Buy">
    <p class="mb-1">
        You have <span class="text-2xl font-display font-semibold text-plum">@pointsRemaining</span> points remaining
    </p>
    <p class="mb-4 text-sm text-pencil">All scores start at 8. You can increase them up to 15.</p>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var ability in GetAbilityOrder())
        {
            <div class="border-2 border-ink bg-room-highlight p-3">
                <h4 class="mb-2 text-center text-sm font-medium">@GetAbilityFullName(ability)</h4>

                <div class="flex items-center justify-between gap-3">
                    <button type="button" class="btn-step" aria-label="@($"Lower {GetAbilityFullName(ability)}")"
                            @onclick="() => DecreaseScore(ability)" disabled="@(!CanDecrease(ability))">−</button>

                    <div class="flex-1 text-center">
                        <div class="text-3xl font-display font-semibold">@pointBuyScores[ability]</div>
                        <span class="text-xs text-pencil">Cost: @GetCostForScore(pointBuyScores[ability])</span>
                    </div>

                    <button type="button" class="btn-step" aria-label="@($"Raise {GetAbilityFullName(ability)}")"
                            @onclick="() => IncreaseScore(ability)" disabled="@(!CanIncrease(ability))">+</button>
                </div>
            </div>
        }
    </div>

    <h4 class="mb-2 mt-5 text-sm font-semibold text-pencil">Point Buy Costs</h4>
    <dl class="grid grid-cols-4 gap-x-2 gap-y-1 text-center text-sm">
        @foreach (var kvp in pointCosts.OrderBy(x => x.Key))
        {
            <div>
                <dt class="inline text-pencil">@kvp.Key:</dt>
                <dd class="inline font-medium">@kvp.Value pts</dd>
            </div>
        }
    </dl>

    <div class="mt-5 text-center">
        <button type="button" class="btn-main" @onclick="ApplyPointBuy" disabled="@(pointsRemaining != 0)">
            @(pointsRemaining == 0 ? "Use These Scores" : $"Spend all {pointsRemaining} points to continue")
        </button>
    </div>
</Room>
@code {
    [Parameter]
    public List<int> Scores { get; set; } = new();

    [Parameter]
    public EventCallback<List<int>> ScoresChanged { get; set; }

    private Dictionary<string, int> pointBuyScores = new()
    {
        ["STR"] = 8,
        ["DEX"] = 8,
        ["CON"] = 8,
        ["INT"] = 8,
        ["WIS"] = 8,
        ["CHA"] = 8
    };

    private readonly Dictionary<int, int> pointCosts = new()
    {
        [8] = 0,
        [9] = 1,
        [10] = 2,
        [11] = 3,
        [12] = 4,
        [13] = 5,
        [14] = 7,
        [15] = 9
    };

    private const int TotalPoints = 27;
    private int pointsRemaining => TotalPoints - GetTotalSpent();

    private List<string> GetAbilityOrder()
    {
        return new() { "STR", "DEX", "CON", "INT", "WIS", "CHA" };
    }

    private string GetAbilityFullName(string abbr)
    {
        return abbr switch
        {
            "STR" => "Strength",
            "DEX" => "Dexterity",
            "CON" => "Constitution",
            "INT" => "Intelligence",
            "WIS" => "Wisdom",
            "CHA" => "Charisma",
            _ => abbr
        };
    }

    private int GetTotalSpent()
    {
        return pointBuyScores.Values.Sum(score => GetCostForScore(score));
    }

    private int GetCostForScore(int score)
    {
        return pointCosts.GetValueOrDefault(score, 0);
    }

    private bool CanIncrease(string ability)
    {
        int currentScore = pointBuyScores[ability];

        // Can't go above 15
        if (currentScore >= 15) return false;

        // Check if we have enough points
        int currentCost = GetCostForScore(currentScore);
        int nextCost = GetCostForScore(currentScore + 1);
        int costIncrease = nextCost - currentCost;

        return pointsRemaining >= costIncrease;
    }

    private bool CanDecrease(string ability)
    {
        // Can't go below 8
        return pointBuyScores[ability] > 8;
    }

    private void IncreaseScore(string ability)
    {
        if (CanIncrease(ability))
        {
            pointBuyScores[ability]++;
            StateHasChanged();
        }
    }

    private void DecreaseScore(string ability)
    {
        if (CanDecrease(ability))
        {
            pointBuyScores[ability]--;
            StateHasChanged();
        }
    }

    private async Task ApplyPointBuy()
    {
        if (pointsRemaining != 0) return;

        var scores = pointBuyScores.Values.ToList();

        Scores.Clear();
        Scores.AddRange(scores);

        await ScoresChanged.InvokeAsync(Scores);
    }
}