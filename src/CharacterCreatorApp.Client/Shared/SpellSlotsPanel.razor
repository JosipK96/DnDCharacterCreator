@* The spell slots a character's stats give, for the sheet and the review step alike: a line per
   spell level with one square per slot, and a warlock's Pact Magic apart, since those come back
   on a short rest. The page shows it only for a character with slots of either kind, inside a
   room of its own. *@

<div class="space-y-4">
    @if (Stats.SpellSlots.Count > 0)
    {
        <div>
            <p class="mb-2 text-sm text-pencil">Spell slots, back on a long rest</p>
            <ul class="space-y-2">
                @foreach (var slot in Stats.SpellSlots)
                {
                    <li class="flex items-center gap-3" data-testid="slot-level" data-slots="@slot.Slots">
                        <span class="w-20 shrink-0">@Ordinal(slot.SpellLevel) level</span>
                        <span class="flex flex-wrap gap-1.5" role="img" aria-label="@SlotsLabel(slot.Slots)">
                            @for (var i = 0; i < slot.Slots; i++)
                            {
                                <span class="slot-box" data-testid="slot"></span>
                            }
                        </span>
                    </li>
                }
            </ul>
        </div>
    }

    @if (Stats.PactMagic is { } pactMagic)
    {
        <div>
            <p class="mb-2 text-sm text-pencil">Pact Magic, back on a short rest</p>
            <div class="flex items-center gap-3" data-testid="pact-magic" data-slots="@pactMagic.Slots">
                <span class="w-20 shrink-0">@Ordinal(pactMagic.SlotLevel) level</span>
                <span class="flex flex-wrap gap-1.5" role="img" aria-label="@SlotsLabel(pactMagic.Slots)">
                    @for (var i = 0; i < pactMagic.Slots; i++)
                    {
                        <span class="slot-box" data-testid="slot"></span>
                    }
                </span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CharacterStatsApiResponse Stats { get; set; } = null!;

    private static string SlotsLabel(int slots) => slots == 1 ? "1 slot" : $"{slots} slots";

    private static string Ordinal(int level) => level switch
    {
        1 => "1st",
        2 => "2nd",
        3 => "3rd",
        _ => $"{level}th"
    };
}
