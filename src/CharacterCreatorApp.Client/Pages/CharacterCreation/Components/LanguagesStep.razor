@inject CharacterDraftService DraftService
@inject LookupService LookupService
@inherits WizardStepBase

<div>
    <h2 class="step-title mb-4">@StepHeading("Choose Languages")</h2>

    @if (IsLoading)
    {
        <Spinner />
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <Message Kind="MessageKind.Error" Class="mb-6">
            <p class="text-sm">@ErrorMessage</p>
        </Message>
    }
    else if (totalChoices == 0)
    {
        <Room Title="No Language Choices">
            <p>Your race and background don't grant any extra language choices.</p>
            <p class="mt-2 text-sm text-pencil">You still know the fixed languages from your race.</p>
        </Room>
    }
    else
    {
        <ChoiceSection Title="Languages" Chosen="@selectedLanguageIds.Count" Total="@totalChoices">
            <Description>
                Choose @totalChoices additional language(s) from the list below.
                @if (alreadyKnownNames.Count > 0)
                {
                    <span class="block">Already known from your race and background: <strong>@string.Join(", ", alreadyKnownNames)</strong></span>
                }
            </Description>
            <ChildContent>
                @foreach (var language in availableLanguages)
                {
                    var isSelected = selectedLanguageIds.Contains(language.Id);
                    <ChoiceRow Name="@language.Name" Picked="@isSelected"
                               Disabled="@(!isSelected && selectedLanguageIds.Count >= totalChoices)"
                               OnClick="() => ToggleLanguage(language.Id)">
                        @language.Type
                    </ChoiceRow>
                }
            </ChildContent>
        </ChoiceSection>
    }

    <StepNavigation OnBack="HandleBack" OnNext="HandleNext" NextDisabled="@(!CanProceed() || IsSaving)"
                    NextText="@(IsSaving ? "Saving..." : NextLabel)" />
</div>
@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private List<LanguageApiResponse> availableLanguages = [];
    private List<string> alreadyKnownNames = [];
    private HashSet<string> selectedLanguageIds = [];
    private int totalChoices;

    protected override Task OnInitializedAsync() => LoadAsync(LoadLanguagesAsync, "Failed to load languages");

    private async Task LoadLanguagesAsync()
    {
        var draft = await DraftService.GetDraftDetailsAsync(DraftId);
        if (draft == null)
        {
            ErrorMessage = "Draft not found.";
            return;
        }

        // The API counts the picks (a high elf's one more than an elf's, and the background's) and
        // names the languages the race and background give already, by id as it checks them
        var owed = await DraftService.GetChoicesOwedAsync(DraftId);
        totalChoices = owed.Languages;
        var knownIds = owed.KnownLanguageIds.ToHashSet();

        // A 2024 character picks from the 2024 book's standard languages
        var allLanguages = await LookupService.GetLanguagesAsync(draft.Edition);

        // A language the race or background already gives can't be picked again; the server
        // refuses it, since the pick would be spent on nothing
        alreadyKnownNames = allLanguages
            .Where(l => knownIds.Contains(l.Id))
            .Select(l => l.Name)
            .ToList();

        availableLanguages = allLanguages
            .Where(l => !knownIds.Contains(l.Id))
            .OrderBy(l => l.Type)
            .ThenBy(l => l.Name)
            .ToList();

        // Restore prior selections
        if (draft.SelectedLanguageIds?.Count > 0)
        {
            selectedLanguageIds = draft.SelectedLanguageIds.ToHashSet();
        }
    }

    private void ToggleLanguage(string id)
    {
        if (!selectedLanguageIds.Remove(id) && selectedLanguageIds.Count < totalChoices)
        {
            selectedLanguageIds.Add(id);
        }
    }

    // Until the count has loaded it reads 0, which would let an empty pick through
    private bool CanProceed() => !IsLoading && (totalChoices == 0 || selectedLanguageIds.Count == totalChoices);

    private async Task HandleNext()
    {
        if (!CanProceed())
        {
            return;
        }

        if (await SaveAsync(() => DraftService.ChooseLanguagesAsync(DraftId, selectedLanguageIds.ToList()), "Failed to save languages"))
        {
            await OnNext.InvokeAsync();
        }
    }

    private async Task HandleBack()
    {
        await OnBack.InvokeAsync();
    }
}
