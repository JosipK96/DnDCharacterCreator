@page "/character/create"
@page "/character/create/{DraftIdParam}"
@attribute [Authorize]
@using CharacterCreatorApp.Client.Pages.CharacterCreation.Components.AbilityScores
@using CharacterCreatorApp.Client.Pages.CharacterCreation.Components.Backgrounds
@using CharacterCreatorApp.Client.Pages.CharacterCreation.Components.Classes
@using CharacterCreatorApp.Client.Pages.CharacterCreation.Components.Improvements
@using CharacterCreatorApp.Client.Pages.CharacterCreation.Components.Races
@inject CharacterDraftService DraftService
@inject CharacterService CharacterService
@inject NavigationManager Navigation

@* The page finds or creates the draft and shows the step WizardNavigator says, on the graph paper;
   each step draws its own rooms on it *@
<div>
    <div class="max-w-6xl mx-auto">

        @if (isInitializing)
        {
            <div class="flex justify-center items-center py-20">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-plum mx-auto mb-4"></div>
                    <p class="text-pencil">Initializing character creation...</p>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <Message Kind="MessageKind.Error">
                <p class="font-medium">Error</p>
                <p class="text-sm mt-1">@errorMessage</p>
                <button @onclick="Cancel"
                        class="btn-secondary mt-4">
                    Back to Characters
                </button>
            </Message>
        }
        else
        {
            <div class="mb-8">
                @if (navigator.IsLevelUp)
                {
                    <h1 class="page-title mb-2">Level up @existingDraft?.Name to level @characterLevel</h1>
                    <p class="text-pencil">Every earlier choice stays. Pick what the new level brings; saving replaces the character.</p>
                }
                else if (IsEdit)
                {
                    <h1 class="page-title mb-2">Edit @existingDraft?.Name</h1>
                    <p class="text-pencil">Every choice is filled in. Change what you like, or pick a step above; saving replaces the character.</p>
                }
                else
                {
                    <h1 class="page-title mb-2">Create New Character</h1>
                    <p class="text-pencil">Follow the steps below to create your D&D 5E character</p>
                }
            </div>

            @if (IsEdit)
            {
                <WizardProgress CurrentStep="@navigator.CurrentStep" Flow="@navigator.Flow" StepsNeedingPick="@navigator.StepsNeedingPick" OnSelectStep="navigator.Select" />
            }
            else
            {
                <WizardProgress CurrentStep="@navigator.CurrentStep" Flow="@navigator.Flow" />
            }

            @* The numbers here are WizardSteps', which gives each step its name; the flow says which a draft goes through *@
            <div class="mt-8">
                @if (navigator.CurrentStep == 1)
                {
                    <NameAndLevelStep DraftId="@draftId" Step="1" Flow="@navigator.Flow"
                                      OnNext="@((choice) => AfterStepOneAsync(choice.Level, choice.Edition, choice.Sources))"
                                      OnCancel="Cancel" />
                }
                else if (navigator.CurrentStep == 2)
                {
                    <RaceStep DraftId="@draftId" Step="2" Flow="@navigator.Flow"
                              Edition="@edition"
                              Sources="@sources"
                              OnChangeBooks="@ChangeBooksCallback"
                              OnNext="() => navigator.Next(2)"
                              OnBack="() => Back(2)" />
                }
                else if (navigator.CurrentStep == 3)
                {
                    <ClassStep DraftId="@draftId" Step="3" Flow="@navigator.Flow"
                               CharacterLevel="@characterLevel"
                               Edition="@edition"
                               Sources="@sources"
                               ClassLocked="@navigator.IsLevelUp"
                               OnChangeBooks="@ChangeBooksCallback"
                               OnNext="() => navigator.Next(3)"
                               OnBack="() => Back(3)" />
                }
                else if (navigator.CurrentStep == 4)
                {
                    <BackgroundStep DraftId="@draftId" Step="4" Flow="@navigator.Flow"
                                    Edition="@edition"
                                    Sources="@sources"
                                    OnChangeBooks="@ChangeBooksCallback"
                                    OnNext="() => navigator.Next(4)"
                                    OnBack="() => Back(4)" />
                }
                else if (navigator.CurrentStep == 5)
                {
                    <LanguagesStep DraftId="@draftId" Step="5" Flow="@navigator.Flow"
                                   OnNext="() => navigator.Next(5)"
                                   OnBack="() => Back(5)" />
                }
                else if (navigator.CurrentStep == 6)
                {
                    <AbilityScoresStep DraftId="@draftId" Step="6" Flow="@navigator.Flow"
                                       OnNext="() => navigator.Next(6)"
                                       OnBack="() => Back(6)" />
                }
                else if (navigator.CurrentStep == 7)
                {
                    <ProficienciesStep DraftId="@draftId" Step="7" Flow="@navigator.Flow"
                                       OnNext="() => navigator.Next(7)"
                                       OnBack="() => Back(7)" />
                }
                else if (navigator.CurrentStep == 8)
                {
                    @* Before the spells: a feat can grant a spell, and an improvement changes how many a prepared caster gets *@
                    <ImprovementsStep DraftId="@draftId" Step="8" Flow="@navigator.Flow"
                                      CharacterLevel="@characterLevel"
                                      OnChangeBooks="@ChangeBooksCallback"
                                      OnNext="() => navigator.Next(8)"
                                      OnBack="() => Back(8)" />
                }
                else if (navigator.CurrentStep == 9)
                {
                    <SpellsStep DraftId="@draftId" Step="9" Flow="@navigator.Flow"
                                OnChangeBooks="@ChangeBooksCallback"
                                OnNext="() => navigator.Next(9)"
                                OnBack="() => Back(9)" />
                }
                else if (navigator.CurrentStep == WizardSteps.Review)
                {
                    <ReviewStep DraftId="@draftId" Step="@WizardSteps.Review" Flow="@navigator.Flow" IsEdit="@IsEdit"
                                OnNext="FinalizeCharacter"
                                OnBack="() => Back(WizardSteps.Review)" />
                }
                else if (navigator.CurrentStep == WizardSteps.HitPoints)
                {
                    <HitPointsStep DraftId="@draftId" Step="@WizardSteps.HitPoints" Flow="@navigator.Flow"
                                   OnNext="() => navigator.Next(WizardSteps.HitPoints)"
                                   OnBack="() => Back(WizardSteps.HitPoints)" />
                }
            </div>

            <div class="mt-6 text-center">
                <button @onclick="ConfirmCancel" class="font-medium text-ink underline-offset-4 hover:underline">
                    @(navigator.IsLevelUp ? "Cancel Level Up" : IsEdit ? "Cancel Editing" : "Cancel Character Creation")
                </button>
            </div>
        }

        @if (showCancelConfirm)
        {
            <CancelWizardDialog IsEdit="@IsEdit" IsLevelUp="@navigator.IsLevelUp" OnStay="() => showCancelConfirm = false" OnLeave="Cancel" />
        }

        @if (showResumePrompt && existingDraft != null)
        {
            <ResumeDraftPrompt Draft="@existingDraft" OnResume="ResumeDraft" OnStartFresh="StartFresh" />
        }
    </div>
</div>

@code {
    [Parameter]
    public string? DraftIdParam { get; set; }

    private readonly WizardNavigator navigator = new();

    private Guid draftId = Guid.Empty;
    private int characterLevel = 1;

    // The draft's rules edition and books, which decide what the later steps offer
    private string edition = "";
    private IReadOnlyList<string> sources = [];

    private bool isInitializing = true;
    private bool showCancelConfirm = false;
    private bool showResumePrompt = false;
    private CharacterDraftDetailsApiResponse? existingDraft;
    private string? errorMessage;

    // An edit of a saved character, a level-up among them: the draft names the character it replaces
    private Guid? editedCharacterId;

    private bool IsEdit => editedCharacterId != null;

    // A level-up has no step 1, so its notes offer no way there
    private EventCallback ChangeBooksCallback => navigator.CanChangeBooks ? EventCallback.Factory.Create(this, navigator.ChangeBooks) : default;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(DraftIdParam) && Guid.TryParse(DraftIdParam, out var parsedDraftId))
        {
            draftId = parsedDraftId;
            await LoadDraftAsync();
        }
        else
        {
            await CheckForExistingDraft();
        }
    }

    private async Task LoadDraftAsync()
    {
        isInitializing = true;
        StateHasChanged();

        try
        {
            existingDraft = await DraftService.GetDraftDetailsAsync(draftId);

            if (existingDraft == null)
            {
                errorMessage = "Character draft not found or you don't have access to it.";
                return;
            }

            edition = existingDraft.Edition;
            sources = existingDraft.AllowedSources;
            editedCharacterId = existingDraft.CharacterId;
            navigator.Open(existingDraft);

            if (existingDraft.Level.HasValue)
            {
                characterLevel = existingDraft.Level.Value;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading draft: {ex.Message}";
        }
        finally
        {
            isInitializing = false;
            StateHasChanged();
        }
    }

    private async Task CheckForExistingDraft()
    {
        isInitializing = true;
        StateHasChanged();

        try
        {
            existingDraft = await DraftService.GetIncompleteDraftAsync();

            if (existingDraft == null)
            {
                await CreateNewDraft();
                return;
            }

            // A draft with step 1 not saved holds nothing to resume: it opens at step 1 without
            // asking, and is reused rather than joined by a second unfinished draft (#90)
            if (WizardNavigator.FirstStepToFill(existingDraft) == 1)
            {
                ResumeDraft();
                return;
            }

            showResumePrompt = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isInitializing = false;
            StateHasChanged();
        }
    }

    private void ResumeDraft()
    {
        showResumePrompt = false;
        draftId = existingDraft!.Id;
        Navigation.NavigateTo($"/character/create/{draftId}", false);
        navigator.Resume(existingDraft);
        edition = existingDraft.Edition;
        sources = existingDraft.AllowedSources;

        if (existingDraft.Level.HasValue)
        {
            characterLevel = existingDraft.Level.Value;
        }

        StateHasChanged();
    }

    private async Task StartFresh()
    {
        showResumePrompt = false;

        if (existingDraft != null)
        {
            await DraftService.DeleteDraftAsync(existingDraft.Id);
        }

        await CreateNewDraft();
    }

    private async Task CreateNewDraft()
    {
        try
        {
            draftId = await DraftService.CreateDraftAsync();

            if (draftId == Guid.Empty)
            {
                errorMessage = "Failed to initialize character creation";
                return;
            }

            Navigation.NavigateTo($"/character/create/{draftId}", false);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    // The level may have changed on step 1, and with it the levels whose hit die the flow asks
    // about, so the saved draft is read again before moving on
    private async Task AfterStepOneAsync(int level, string chosenEdition, IReadOnlyList<string> chosenSources)
    {
        var keptChoices = chosenEdition == edition && !sources.Except(chosenSources).Any();
        CharacterDraftDetailsApiResponse? saved;

        try
        {
            saved = await DraftService.GetDraftDetailsAsync(draftId);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            errorMessage = $"Error loading draft: {ex.Message}";
            StateHasChanged();
            return;
        }

        characterLevel = level;
        edition = chosenEdition;
        sources = chosenSources;
        navigator.AfterStepOne(saved?.HitDieLevels ?? [], keptChoices);
    }

    // Back from the flow's first step (a level-up's) leaves it, as cancelling does
    private void Back(int fromStep)
    {
        if (!navigator.Back(fromStep))
        {
            ConfirmCancel();
        }
    }

    private async Task FinalizeCharacter()
    {
        try
        {
            // An edit comes back with the character's own id: it replaced it
            var characterId = await CharacterService.FinalizeCharacterAsync(draftId);
            Navigation.NavigateTo($"/character/{characterId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to finalize character: {ex.Message}";
            StateHasChanged();
        }
    }

    private void ConfirmCancel()
    {
        showCancelConfirm = true;
        StateHasChanged();
    }

    private async Task Cancel()
    {
        if (editedCharacterId is not { } characterId)
        {
            Navigation.NavigateTo("/characters");
            return;
        }

        // The edit goes, and the character stays as it was saved. Should the delete fail, the next
        // edit of the character drops the draft anyway.
        try
        {
            await DraftService.DeleteDraftAsync(draftId);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // Nothing to tell the player: leaving is what they asked for
        }

        Navigation.NavigateTo($"/character/{characterId}");
    }
}
