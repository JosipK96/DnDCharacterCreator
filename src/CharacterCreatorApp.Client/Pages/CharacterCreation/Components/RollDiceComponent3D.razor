@inject IJSRuntime JS

<div class="space-y-6">
    <div class="text-center">
        <p class="text-gray-300 mb-4">
            Roll 4d6, drop lowest for each ability score. Watch the dice fly across your screen!
        </p>

        @if (!hasStartedRolling)
        {
            <button @onclick="StartRolling"
                    class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white px-8 py-4 rounded-lg font-bold text-xl transition-all duration-200 transform hover:scale-105 shadow-lg">
                🎲 Roll All Ability Scores 🎲
            </button>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mt-4 p-4 bg-red-900/50 border border-red-700 rounded-lg text-red-200">
                @errorMessage
            </div>
        }
    </div>

    <!-- Roll Results Pool -->
    @if (hasRolled && !isRolling)
    {
        <div class="space-y-4">
            <h3 class="text-white font-medium text-center text-lg">Your Rolled Scores</h3>
            <p class="text-gray-400 text-center text-sm">Assign these scores to your abilities below</p>

            <div class="flex justify-center gap-3 flex-wrap">
                @foreach (var roll in rollResults)
                {
                    <div class="bg-gradient-to-br from-indigo-600 to-purple-600 rounded-lg p-4 shadow-lg">
                        <div class="flex flex-col items-center">
                            <!-- Dice Display -->
                            <div class="flex gap-1 mb-2">
                                @for (int i = 0; i < roll.AllDice.Count; i++)
                                {
                                    var index = i;
                                    var die = roll.AllDice[index];
                                    <div class="@GetMiniDieClass(die, index, roll)">
                                        @die
                                    </div>
                                }
                            </div>
                            <!-- Total -->
                            <div class="text-3xl font-bold text-white">@roll.Total</div>
                        </div>
                    </div>
                }
            </div>

            <div class="flex justify-center gap-4 mt-4">
                <button @onclick="ResetAndReroll"
                        class="bg-gray-700 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-medium shadow-lg">
                    🔄 Reroll All
                </button>
                @* <button @onclick="AcceptRolls"
                        class="bg-green-600 hover:bg-green-700 text-white px-8 py-3 rounded-lg font-medium shadow-lg">
                    ✓ Use These Scores
                </button> *@
            </div>
        </div>
    }

    <!-- Rolling Animation -->
    @if (isRolling)
    {
        <div class="text-center">
            <div class="inline-flex items-center gap-3 bg-purple-900/50 px-6 py-4 rounded-lg">
                <div class="w-6 h-6 border-3 border-purple-500 border-t-transparent rounded-full animate-spin"></div>
                <span class="text-white font-medium">Rolling dice... (@currentRollSet of 6)</span>
            </div>
        </div>
    }
</div>

<!-- Dice Canvas Overlay - Fullscreen -->
<div id="dice-canvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 9999;"></div>

@code {
    [Parameter]
    public List<int> Scores { get; set; } = new();

    [Parameter]
    public EventCallback<List<int>> ScoresChanged { get; set; }

    [Parameter]
    public EventCallback OnRollComplete { get; set; }

    [Parameter]
    public EventCallback<List<DiceRoll>> OnRollResultsChanged { get; set; }

    public class DiceRoll
    {
        public List<int> AllDice { get; set; } = new();
        public int DroppedDie { get; set; }
        public int DroppedDieIndex { get; set; }
        public int Total { get; set; }
    }

    private List<DiceRoll> rollResults = new();
    private bool hasStartedRolling = false;
    private bool isRolling = false;
    private bool hasRolled = false;
    private int currentRollSet = 0;
    private bool isInitialized = false;
    private string errorMessage = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            try
            {
                var maxAttempts = 50;
                for (int i = 0; i < maxAttempts; i++)
                {
                    var isReady = await JS.InvokeAsync<bool>("eval",
                        "typeof window.initFantasticDice === 'function'");

                    if (isReady)
                    {
                        await JS.InvokeVoidAsync("initFantasticDice");
                        isInitialized = true;
                        break;
                    }

                    await Task.Delay(100);
                }

                if (!isInitialized)
                {
                    errorMessage = "Failed to load dice script";
                    Console.WriteLine("Failed to load dice script after 50 attempts");
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error initializing dice: {ex.Message}";
                Console.WriteLine($"Dice init error: {ex}");
            }
        }
    }

    private async Task StartRolling()
    {
        if (!isInitialized)
        {
            errorMessage = "Dice not initialized yet. Please refresh the page.";
            return;
        }

        hasStartedRolling = true;
        isRolling = true;
        hasRolled = false;
        rollResults.Clear();
        errorMessage = string.Empty;
        currentRollSet = 0;
        StateHasChanged();

        try
        {
            for (int i = 0; i < 6; i++)
            {
                currentRollSet = i + 1;
                StateHasChanged();

                var results = await JS.InvokeAsync<int[]>("rollFantasticDice", "4d6");

                if (results == null || results.Length != 4)
                {
                    throw new Exception($"Invalid dice roll results for set {i + 1}");
                }

                var roll = ProcessDiceResults(results);
                rollResults.Add(roll);

                StateHasChanged();
                await Task.Delay(1500);
            }

            hasRolled = true;

            var scores = rollResults.Select(r => r.Total).ToList();
            await ScoresChanged.InvokeAsync(scores);
            await OnRollResultsChanged.InvokeAsync(rollResults);
            await OnRollComplete.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Roll error: {ex.Message}";
            Console.WriteLine($"Roll error: {ex}");
        }
        finally
        {
            isRolling = false;
            currentRollSet = 0;
            StateHasChanged();
        }
    }

    private DiceRoll ProcessDiceResults(int[] diceValues)
    {
        var sortedWithIndices = diceValues
            .Select((value, index) => new { Value = value, OriginalIndex = index })
            .OrderBy(x => x.Value)
            .ToList();

        var droppedDie = sortedWithIndices[0];
        var keptDice = sortedWithIndices.Skip(1).Select(x => x.Value).ToList();

        return new DiceRoll
        {
            AllDice = diceValues.ToList(),
            DroppedDie = droppedDie.Value,
            DroppedDieIndex = droppedDie.OriginalIndex,
            Total = keptDice.Sum()
        };
    }

    private async Task AcceptRolls()
    {
        // Just pass the totals as available scores - parent will handle assignment
        var scores = rollResults.Select(r => r.Total).ToList();

        Scores.Clear();
        Scores.AddRange(scores);

        await ScoresChanged.InvokeAsync(Scores);
        await OnRollComplete.InvokeAsync();
    }

    private async Task ResetAndReroll()
    {
        try
        {
            // Reset state
            hasStartedRolling = false;
            hasRolled = false;
            rollResults.Clear();
            currentRollSet = 0;
            errorMessage = string.Empty;
            isInitialized = false; // Force reinit
            StateHasChanged();

            // Reinitialize dice engine
            await JS.InvokeVoidAsync("initFantasticDice");
            isInitialized = true;

            // Small delay to let initialization complete
            await Task.Delay(500);

            // Start rolling again
            await StartRolling();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error resetting: {ex.Message}";
            Console.WriteLine($"Reset error: {ex}");
        }
    }

    private string GetMiniDieClass(int die, int index, DiceRoll roll)
    {
        var baseClass = "w-8 h-8 rounded flex items-center justify-center text-sm font-bold";

        if (index == roll.DroppedDieIndex)
            return $"{baseClass} bg-red-900 text-red-400 opacity-40 line-through";

        return $"{baseClass} bg-white/20 text-white";
    }
}