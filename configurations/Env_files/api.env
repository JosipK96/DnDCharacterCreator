# Container settings for the API, on top of appsettings.json. Nothing secret goes here:
# docker-compose.yml adds the connection string and the JWT signing key from .env.

# A host usually puts a TLS-terminating proxy in front of the container; trust its
# X-Forwarded-For and X-Forwarded-Proto so the app sees the caller's address and https
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning
